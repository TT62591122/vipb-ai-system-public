      <div class="modal-body">
        <div class="mb-3"><label class="form-label">客户邮箱 *</label><input type="email" class="form-control" id="q-email"></div>
        <div class="mb-3"><label class="form-label">客户名称</label><input type="text" class="form-control" id="q-name"></div>
        <div class="mb-3"><label class="form-label">产品</label><input type="text" class="form-control" id="q-product" placeholder="如: 智能电表 DDS686"></div>
        <div class="row">
          <div class="col-6 mb-3"><label class="form-label">金额(USD)</label><input type="number" class="form-control" id="q-amount" step="0.01"></div>
          <div class="col-6 mb-3"><label class="form-label">有效天数</label><input type="number" class="form-control" id="q-days" value="30"></div>
        </div>
        <div class="mb-3"><label class="form-label">备注</label><textarea class="form-control" id="q-notes" rows="2"></textarea></div>
      </div>
      <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" onclick="createQuote()">创建报价</button></div>
    </div>
  </div>
</div>

<!-- 新序列弹窗-->
<div class="modal fade" id="seqModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">新建序列</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="mb-3"><label class="form-label">序列名称 *</label><input type="text" class="form-control" id="s-name" placeholder="如: 智能电表新客跟进"></div>
        <div class="mb-3">
          <label class="form-label">步骤配置 <small class="text-muted">(JSON格式)</small></label>
          <textarea class="form-control" id="s-steps" rows="8" placeholder='[
  {"channel":"email","delay_days":0,"subject":"Introduction","template":"Hi {{name}}, ..."},
  {"channel":"email","delay_days":3,"subject":"Follow up","template":"Just checking in..."},
  {"channel":"whatsapp","delay_days":7,"template":"Hi {{name}}, did you see our email?"}
]'></textarea>
        </div>
      </div>
      <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" onclick="createSequence()">创建</button></div>
    </div>
  </div>
</div>

<!-- 预热配置弹窗 -->
<div class="modal fade" id="warmupModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">添加预热账号</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="mb-3"><label class="form-label">邮箱账号ID *</label><input type="number" class="form-control" id="w-account" placeholder="email_accounts表的ID"></div>
        <div class="mb-3"><label class="form-label">互热伙伴邮箱</label><input type="email" class="form-control" id="w-partner" placeholder="对方预热邮箱（可选）"></div>
      </div>
      <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" onclick="startWarmup()">开始预热</button></div>
    </div>
  </div>
</div>

<script>
const API = '/api/channel-tools';

// ===== 页面加载 =====
document.addEventListener('DOMContentLoaded', () => { refreshAll(); });

function refreshAll() {
  loadStats();
  loadPending();
  loadQuotes();
  loadSequences();
  loadWarmup();
}

// ===== 顶部统计 =====
async function loadStats() {
  try {
    const [pendRes, quoteRes] = await Promise.all([
      fetch(API + '/pending-actions/stats').then(r=>r.json()),
      fetch(API + '/quotes/stats').then(r=>r.json())
    ]);
    if (pendRes.success) {
      const s = pendRes.data;
      document.getElementById('stat-pending').textContent = s.total || 0;
      document.getElementById('stat-blocked').textContent = s.byType?.pricing || 0;
    }
    if (quoteRes.success) {
      const s = quoteRes.data;
      document.getElementById('stat-quotes').textContent = (s.pending || 0) + (s.quoted || 0);
      document.getElementById('stat-winrate').textContent = s.winRate ? s.winRate + '%' : '0%';
    }
  } catch(e) { console.error('loadStats', e); }
}

// ===== 待办管理 =====
async function loadPending() {
  try {
    const filter = document.getElementById('pending-filter').value;
    const url = filter === 'all' ? API + '/pending-actions' : API + '/pending-actions?type=' + filter;
    const res = await fetch(url).then(r=>r.json());
    const tbody = document.getElementById('pending-body');
    if (!res.success || !res.data?.length) {
      tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-3">🎉 暂无待处理事项</td></tr>';
      return;
    }
    tbody.innerHTML = res.data.map(a => `
      <tr>
        <td><small>${formatTime(a.created_at)}</small></td>
        <td><span class="badge ${typeBadge(a.type)}">${a.type}</span></td>
        <td>${esc(a.customer_email || '-')}</td>
        <td>${esc(a.summary || '')}</td>
        <td>${a.escalation_level ? '<span class="badge bg-danger">L'+a.escalation_level+'</span>' : '-'}</td>
        <td>
          <button class="btn btn-success btn-sm" onclick="resolveAction(${a.id})" title="已处理">✅</button>
          <button class="btn btn-outline-secondary btn-sm" onclick="dismissAction(${a.id})" title="忽略">✖</button>
        </td>
      </tr>
    `).join('');
    // 加载升级提醒
    loadEscalation();
  } catch(e) { console.error('loadPending', e); }
}

async function loadEscalation() {
  try {
    const res = await fetch(API + '/pending-actions/escalation').then(r=>r.json());
    const card = document.getElementById('escalation-card');
    if (!res.success || !res.data?.length) { card.style.display = 'none'; return; }
    card.style.display = '';
    document.getElementById('escalation-body').innerHTML = res.data.map(e => `
      <tr class="table-warning"><td>${esc(e.summary||'')}</td><td>${e.hours_waiting||0}h</td><td><span class="badge bg-danger">L${e.escalation_level}</span></td></tr>
    `).join('');
  } catch(e) {}
}

async function resolveAction(id) {
  if (!confirm('确认已处理此事项？)) return;
  const note = prompt('处理备注（可选）：) || '';
  await fetch(API + '/pending-actions/' + id + '/resolve', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({note}) });
  loadPending(); loadStats();
}
async function dismissAction(id) {
  if (!confirm('确认忽略此事项？')) return;
  await fetch(API + '/pending-actions/' + id + '/dismiss', { method:'POST' });
  loadPending(); loadStats();
}

// ===== 报价跟踪 =====
async function loadQuotes() {
  try {
    const [listRes, statsRes, expRes, fuRes] = await Promise.all([
      fetch(API + '/quotes').then(r=>r.json()),
      fetch(API + '/quotes/stats').then(r=>r.json()),
      fetch(API + '/quotes/expiring').then(r=>r.json()),
      fetch(API + '/quotes/need-followup').then(r=>r.json())
    ]);
    // 列表
    const tbody = document.getElementById('quotes-body');
    if (!listRes.success || !listRes.data?.length) {
      tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-3">暂无报价</td></tr>';
    } else {
      tbody.innerHTML = listRes.data.map(q => `
        <tr>
          <td>${esc(q.customer_name||q.customer_email||'-')}</td>
          <td>${esc(q.product||'-')}</td>
          <td>$${(q.amount||0).toLocaleString()}</td>
          <td><span class="badge ${statusBadge(q.status)}">${q.status}</span></td>
          <td><small>${q.expires_at ? formatTime(q.expires_at) : '-'}</small></td>
          <td>
            <div class="btn-group btn-group-sm">
              <button class="btn btn-outline-success" onclick="updateQuoteStatus(${q.id},'quoted')" title="已报价">📤</button>
              <button class="btn btn-outline-primary" onclick="updateQuoteStatus(${q.id},'following_up')" title="跟进中">📞</button>
              <button class="btn btn-outline-warning" onclick="updateQuoteStatus(${q.id},'won')" title="成交">🎉</button>
              <button class="btn btn-outline-danger" onclick="updateQuoteStatus(${q.id},'lost')" title="丢失">❌</button>
            </div>
          </td>
        </tr>
      `).join('');
    }
    // 统计
    if (statsRes.success) {
      const s = statsRes.data;
      document.getElementById('quote-stats').innerHTML = `
        <div class="row text-center">
          <div class="col-6 mb-2"><strong>${s.total||0}</strong><br><small class="text-muted">总报价</small></div>
          <div class="col-6 mb-2"><strong>${s.pending||0}</strong><br><small class="text-muted">待报价</small></div>
          <div class="col-6 mb-2"><strong>${s.won||0}</strong><br><small class="text-muted">已成交</small></div>
          <div class="col-6 mb-2"><strong>${s.winRate||0}%</strong><br><small class="text-muted">成交率</small></div>
          <div class="col-12"><strong>$${(s.totalAmount||0).toLocaleString()}</strong><br><small class="text-muted">总金额</small></div>
        </div>
      `;
    }
    // 即将过期
    const expDiv = document.getElementById('expiring-quotes');
    if (expRes.success && expRes.data?.length) {
      expDiv.innerHTML = '<div class="list-group list-group-flush">' + expRes.data.map(q => `
        <div class="list-group-item list-group-item-danger py-1 px-2"><small>${esc(q.customer_email)} — $${q.amount} — ${formatTime(q.expires_at)}</small></div>
      `).join('') + '</div>';
    } else { expDiv.innerHTML = '<div class="text-center text-muted py-2">暂无</div>'; }
    // 需跟进
    const fuDiv = document.getElementById('followup-quotes');
    if (fuRes.success && fuRes.data?.length) {
      fuDiv.innerHTML = '<div class="list-group list-group-flush">' + fuRes.data.map(q => `
        <div class="list-group-item list-group-item-warning py-1 px-2"><small>${esc(q.customer_email)} — $${q.amount}</small></div>
      `).join('') + '</div>';
    } else { fuDiv.innerHTML = '<div class="text-center text-muted py-2">暂无</div>'; }
  } catch(e) { console.error('loadQuotes', e); }
}

async function createQuote() {
  const data = {
    customer_email: document.getElementById('q-email').value,
    customer_name: document.getElementById('q-name').value,
    product: document.getElementById('q-product').value,
    amount: parseFloat(document.getElementById('q-amount').value) || 0,
    valid_days: parseInt(document.getElementById('q-days').value) || 30,
    notes: document.getElementById('q-notes').value
  };
  if (!data.customer_email) return alert('请填写客户邮箱);
  const res = await fetch(API + '/quotes', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(data) }).then(r=>r.json());
  if (res.success) {
    bootstrap.Modal.getInstance(document.getElementById('quoteModal')).hide();
    loadQuotes(); loadStats();
    alert('报价创建成功');
  } else { alert(res.error || '创建失败'); }
}

async function updateQuoteStatus(id, status) {
  await fetch(API + '/quotes/' + id + '/status', { method:'PUT', headers:{'Content-Type':'application/json'}, body:JSON.stringify({status}) }).then(r=>r.json());
  loadQuotes(); loadStats();
}

// ===== 序列管理 =====
async function loadSequences() {
  try {
    const res = await fetch(API + '/sequences').then(r=>r.json());
    const list = document.getElementById('seq-list');
    if (!res.success || !res.data?.length) {
      list.innerHTML = '<div class="text-center text-muted py-3">暂无序列</div>';
    } else {
      list.innerHTML = res.data.map(s => `
        <div class="list-group-item d-flex justify-content-between align-items-center">
          <div>
            <strong>${esc(s.name)}</strong>
            <br><small class="text-muted">${JSON.parse(s.steps||'[]').length}个步骤 · ${s.status||'active'}</small>
          </div>
          <div>
            <button class="btn btn-outline-primary btn-sm" onclick="showEnroll(${s.id})" title="加入客户">👤+</button>
          </div>
        </div>
      `).join('');
      document.getElementById('stat-sequences').textContent = res.data.filter(s=>s.status==='active').length;
    }
    // 加载enrollments
    loadEnrollments();
  } catch(e) { console.error('loadSequences', e); }
}

async function loadEnrollments() {
  try {
    const res = await fetch(API + '/sequences/enrollments').then(r=>r.json());
    const tbody = document.getElementById('enrollment-body');
    if (!res.success || !res.data?.length) {
      tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-3">暂无活跃加入</td></tr>';
    } else {
      tbody.innerHTML = res.data.map(e => `
        <tr>
          <td>${esc(e.customer_email)}</td>
          <td>${esc(e.sequence_name||'#'+e.sequence_id)}</td>
          <td>${e.current_step}/${e.total_steps||'?'}</td>
          <td><small>${e.next_trigger_at ? formatTime(e.next_trigger_at) : '-'}</small></td>
          <td><span class="badge ${e.status==='active'?'bg-success':'bg-secondary'}">${e.status}</span></td>
          <td>
            <button class="btn btn-outline-warning btn-sm" onclick="pauseEnroll(${e.id})" title="暂停">⏸</button>
          </td>
        </tr>
      `).join('');
    }
    // 加载日志
    loadSeqLog();
  } catch(e) {}
}

async function loadSeqLog() {
  try {
    const res = await fetch(API + '/sequences/logs?limit=20').then(r=>r.json());
    const tbody = document.getElementById('seq-log-body');
    if (!res.success || !res.data?.length) {
      tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">暂无日志</td></tr>';
    } else {
      tbody.innerHTML = res.data.map(l => `
        <tr><td><small>${formatTime(l.executed_at)}</small></td><td>${esc(l.customer_email||'')}</td><td>${l.step_index||0}</td><td>${esc(l.channel||'')}</td><td><span class="badge ${l.status==='sent'?'bg-success':'bg-danger'}">${l.status}</span></td></tr>
      `).join('');
    }
  } catch(e) {}
}

async function createSequence() {
  const name = document.getElementById('s-name').value;
  const stepsRaw = document.getElementById('s-steps').value;
  if (!name) return alert('请填写序列名称);
  let steps;
  try { steps = JSON.parse(stepsRaw); } catch(e) { return alert('步骤JSON格式错误: ' + e.message); }
  const res = await fetch(API + '/sequences', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({name, steps}) }).then(r=>r.json());
  if (res.success) {
    bootstrap.Modal.getInstance(document.getElementById('seqModal')).hide();
    loadSequences();
    alert('序列创建成功');
  } else { alert(res.error || '创建失败'); }
}

function showEnroll(seqId) {
  const email = prompt('输入客户邮箱:');
  if (!email) return;
  fetch(API + '/sequences/' + seqId + '/enroll', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({customer_email:email}) })
    .then(r=>r.json()).then(res => {
      if (res.success) { loadEnrollments(); alert('加入成功'); }
      else alert(res.error || '加入失败');
    });
}
async function pauseEnroll(id) {
  await fetch(API + '/sequences/enrollments/' + id + '/pause', { method:'POST' });
  loadEnrollments();
}

// ===== 邮件预热 =====
async function loadWarmup() {
  try {
    const res = await fetch(API + '/warmup/configs').then(r=>r.json());
    const tbody = document.getElementById('warmup-body');
    if (!res.success || !res.data?.length) {
      tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-3">暂无预热账号</td></tr>';
      document.getElementById('stat-warmup').textContent = 0;
    } else {
      document.getElementById('stat-warmup').textContent = res.data.filter(w=>w.enabled).length;
      tbody.innerHTML = res.data.map(w => `
        <tr>
          <td>${esc(w.account_email || '#'+w.account_id)}</td>
          <td><span class="badge ${stageBadge(w.stage)}">${w.stage||'week1'}</span></td>
          <td>${w.daily_sent_today||0}</td>
          <td><small>${w.started_at ? formatTime(w.started_at) : '-'}</small></td>
          <td>${w.enabled ? '<span class="badge bg-success">运行中</span>' : '<span class="badge bg-secondary">已暂停</span>'}</td>
          <td>
            <button class="btn btn-sm ${w.enabled?'btn-outline-warning':'btn-outline-success'}" onclick="toggleWarmup(${w.account_id},${!w.enabled})">${w.enabled?'⏸暂停:'▶启动}</button>
          </td>
        </tr>
      `).join('');
    }
    loadWarmupLog();
  } catch(e) { console.error('loadWarmup', e); }
}

async function loadWarmupLog() {
  try {
    const res = await fetch(API + '/warmup/logs?limit=30').then(r=>r.json());
    const tbody = document.getElementById('warmup-log-body');
    if (!res.success || !res.data?.length) {
      tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">暂无日志</td></tr>';
    } else {
      tbody.innerHTML = res.data.map(l => `
        <tr><td><small>${formatTime(l.sent_at||l.created_at)}</small></td><td>${esc(l.from_email||'')}</td><td>${esc(l.to_email||'')}</td><td>${l.direction||'out'}</td><td><span class="badge ${l.status==='sent'?'bg-success':'bg-danger'}">${l.status}</span></td></tr>
      `).join('');
    }
  } catch(e) {}
}

async function startWarmup() {
  const accountId = parseInt(document.getElementById('w-account').value);
  const partner = document.getElementById('w-partner').value;
  if (!accountId) return alert('请填写邮箱账号ID');
  const res = await fetch(API + '/warmup/start', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({account_id:accountId, partner_email:partner||undefined}) }).then(r=>r.json());
  if (res.success) {
    bootstrap.Modal.getInstance(document.getElementById('warmupModal')).hide();
    loadWarmup(); alert('预热已启动);
  } else { alert(res.error || '启动失败'); }
}
async function toggleWarmup(accountId, enable) {
  await fetch(API + '/warmup/' + accountId + '/' + (enable?'start':'stop'), { method:'POST' });
  loadWarmup();
}

// ===== 邮件安全工具 =====
async function checkSpam() {
  const subject = document.getElementById('spam-subject').value;
  const body = document.getElementById('spam-body').value;
  if (!body) return alert('请输入邮件正文);
  const res = await fetch(API + '/spam-check', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({subject, body}) }).then(r=>r.json());
  const div = document.getElementById('spam-result');
  div.style.display = '';
  if (res.success) {
    const d = res.data;
    const color = d.score >= 80 ? 'success' : d.score >= 50 ? 'warning' : 'danger';
    div.innerHTML = `
      <div class="alert alert-${color}">
        <strong>评分: ${d.score}/100</strong> — ${d.level==='safe'?'✅安全':d.level==='warning'?'⚠️有风险':'🚨高危'}
        ${d.issues?.length ? '<hr><ul class="mb-0">' + d.issues.map(i=>'<li>'+esc(i)+'</li>').join('') + '</ul>' : ''}
        ${d.suggestions?.length ? '<hr><strong>建议:</strong><ul class="mb-0">' + d.suggestions.map(s=>'<li>'+esc(s)+'</li>').join('') + '</ul>' : ''}
      </div>
    `;
  } else { div.innerHTML = '<div class="alert alert-danger">检测失败 '+esc(res.error||'')+'</div>'; }
}

async function verifyEmail() {
  const email = document.getElementById('verify-email').value;
  if (!email) return alert('请输入邮箱);
  const div = document.getElementById('verify-result');
  div.style.display = ''; div.innerHTML = '<div class="text-muted">验证中...</div>';
  const res = await fetch(API + '/verify-email', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({email}) }).then(r=>r.json());
  if (res.success) {
    const d = res.data;
    const color = d.valid ? 'success' : 'danger';
    div.innerHTML = `
      <div class="alert alert-${color}">
        <strong>${d.valid?'✅有效':'❌无效'}</strong> — ${esc(d.reason||'')}
        <br><small>格式:${d.format?'✅':'❌'} MX:${d.mx?'✅':'❌'} SMTP:${d.smtp===undefined?'跳过':d.smtp?'✅':'❌'} 一次性: ${d.disposable?'⚠️是':'否'} 角色账号:${d.role?'⚠️是':'否'}</small>
      </div>
    `;
  } else { div.innerHTML = '<div class="alert alert-danger">'+esc(res.error||'验证失败')+'</div>'; }
}

async function verifyBatch() {
  const raw = document.getElementById('verify-batch').value;
  const emails = raw.split('\n').map(e=>e.trim()).filter(Boolean);
  if (!emails.length) return alert('请输入邮箱);
  const div = document.getElementById('batch-result');
  div.style.display = ''; div.innerHTML = '<div class="text-muted">批量验证中 '+emails.length+'封...</div>';
  const res = await fetch(API + '/verify-email/batch', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({emails}) }).then(r=>r.json());
  if (res.success && res.data) {
    div.innerHTML = '<table class="table table-sm"><thead><tr><th>邮箱</th><th>结果</th><th>原因</th></tr></thead><tbody>' +
      res.data.map(r => `<tr class="${r.valid?'':'table-danger'}"><td>${esc(r.email)}</td><td>${r.valid?'✅':'❌'}</td><td><small>${esc(r.reason||'')}</small></td></tr>`).join('') +
      '</tbody></table>';
  } else { div.innerHTML = '<div class="alert alert-danger">'+esc(res.error||'批量验证失败')+'</div>'; }
}

async function detectIntent() {
  const text = document.getElementById('intent-text').value;
  if (!text) return alert('请输入消息);
  const div = document.getElementById('intent-result');
  div.style.display = ''; div.innerHTML = '<div class="text-muted">分析中...</div>';
  const res = await fetch(API + '/detect-intent', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({text}) }).then(r=>r.json());
  if (res.success) {
    const d = res.data;
    const color = d.shouldBlock ? 'danger' : d.intent==='pricing' ? 'warning' : 'info';
    div.innerHTML = `
      <div class="alert alert-${color}">
        <strong>意图: ${esc(d.intent||'unknown')}</strong> (${(d.confidence*100).toFixed(0)}%)
        ${d.shouldBlock ? '<br>🚨 <strong>需要人工介入！AI不应自动回复此消息。</strong>' : ''}
        ${d.keywords?.length ? '<br><small>触发词: ' + d.keywords.map(k=>esc(k)).join(', ') + '</small>' : ''}
        ${d.language ? '<br><small>检测语言: ' + esc(d.language) + '</small>' : ''}
      </div>
    `;
  } else { div.innerHTML = '<div class="alert alert-danger">'+esc(res.error||'检测失败)+'</div>'; }
}

// ===== 工具函数 =====
function formatTime(t) {
  if (!t) return '-';
  const d = new Date(t);
  if (isNaN(d)) return t;
  return d.toLocaleString('zh-CN', {month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'});
}
function esc(s) { const d=document.createElement('div'); d.textContent=s; return d.innerHTML; }
function typeBadge(t) { return {pricing:'bg-danger',complaint:'bg-warning text-dark',urgent:'bg-danger',inquiry:'bg-info',technical:'bg-primary'}[t]||'bg-secondary'; }
function statusBadge(s) { return {pending:'bg-warning text-dark',quoted:'bg-info',following_up:'bg-primary',won:'bg-success',lost:'bg-danger',expired:'bg-secondary'}[s]||'bg-secondary'; }
function stageBadge(s) { return {week1:'bg-secondary',week2:'bg-info',week3:'bg-primary',week4:'bg-warning text-dark','week5+':'bg-success'}[s]||'bg-secondary'; }

// ===== 域名认证检测 =====
async function checkDomainAuth() {
  const domain = document.getElementById('auth-domain').value;
  if (!domain) return alert('请输入域名');
  const div = document.getElementById('auth-result');
  div.style.display = ''; div.innerHTML = '<div class="text-muted">检测中...</div>';
  try {
    const res = await fetch(API + '/check-domain-auth', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({domain}) }).then(r=>r.json());
    if (res.success) {
      const d = res.data;
      const color = d.level === 'good' ? 'success' : d.level === 'warning' ? 'warning' : 'danger';
      div.innerHTML = `
        <div class="alert alert-${color}">
          <h5>域名: ${esc(d.domain)} — 评分: ${d.score}/100</h5>
          <div class="row mt-2">
            <div class="col-6"><strong>MX:</strong> ${d.mx?.found?'✅ '+esc((d.mx.records||[])[0]?.exchange||''):'❌ 未找到'}</div>
            <div class="col-6"><strong>SPF:</strong> ${d.spf?.found?'✅':'❌ 未找到'}</div>
            <div class="col-6"><strong>DKIM:</strong> ${d.dkim?.found?'✅ selector: '+esc(d.dkim.selector||''):'❌ 未找到'}</div>
            <div class="col-6"><strong>DMARC:</strong> ${d.dmarc?.found?'✅ policy: '+esc(d.dmarc.policy||''):'❌ 未找到'}</div>
          </div>
          ${d.spf?.record ? '<div class="mt-2"><small><strong>SPF记录:</strong> '+esc(d.spf.record)+'</small></div>' : ''}
          ${d.dmarc?.record ? '<div><small><strong>DMARC记录:</strong> '+esc(d.dmarc.record)+'</small></div>' : ''}
          ${d.issues?.length ? '<hr><strong>问题:</strong><ul class="mb-0">'+d.issues.map(i=>'<li>'+esc(i)+'</li>').join('')+'</ul>' : ''}
          ${d.suggestions?.length ? '<hr><strong>修复建议:</strong><ul class="mb-0">'+d.suggestions.map(s=>'<li>'+esc(s)+'</li>').join('')+'</ul>' : ''}
        </div>
      `;
    } else { div.innerHTML = '<div class="alert alert-danger">'+esc(res.error)+'</div>'; }
  } catch(e) { div.innerHTML = '<div class="alert alert-danger">'+e.message+'</div>'; }
}

// ===== 退订管理 =====
async function loadUnsubs() {
  try {
    const res = await fetch(API + '/unsubscribes').then(r=>r.json());
    const tbody = document.getElementById('unsub-body');
    if (!res.success || !res.data?.length) {
      tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">暂无退订记录</td></tr>';
    } else {
      tbody.innerHTML = res.data.map(u => `
        <tr>
          <td>${esc(u.email)}</td>
          <td><small>${formatTime(u.unsubscribed_at)}</small></td>
          <td><small>${esc(u.reason||'-')}</small></td>
          <td>${esc(u.source||'link')}</td>
          <td><button class="btn btn-outline-success btn-sm" onclick="resubscribe('${esc(u.email)}')">重新订阅</button></td>
        </tr>
      `).join('');
    }
  } catch(e) { console.error(e); }
}

async function resubscribe(email) {
  if (!confirm('确认重新订阅 '+email+'?')) return;
  await fetch(API + '/unsubscribes/resubscribe', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({email}) });
  loadUnsubs();
}

async function genUnsubLink() {
  const email = document.getElementById('unsub-gen-email').value;
  if (!email) return alert('请输入邮箱');
  const res = await fetch(API + '/unsubscribe-link?email=' + encodeURIComponent(email)).then(r=>r.json());
  const div = document.getElementById('unsub-link-result');
  div.style.display = '';
  if (res.success) {
    div.innerHTML = '<div class="alert alert-info"><small><strong>退订链接:</strong><br><a href="'+esc(res.data.url)+'" target="_blank">'+esc(res.data.url)+'</a><br><br><strong>邮件头:</strong><br><code>List-Unsubscribe: '+esc(res.data.headers['List-Unsubscribe'])+'</code></small></div>';
  }
}

// Tab切换时加载数据
document.querySelectorAll('#toolTabs a[data-bs-toggle="tab"]').forEach(tab => {
  tab.addEventListener('shown.bs.tab', function(e) {
    const target = e.target.getAttribute('href');
    if (target === '#tab-unsub') loadUnsubs();
  });
});

// ===== 数据分析仪表盘 =====
async function loadDashboard() {
  const days = document.getElementById('dash-period').value;
  try {
    const res = await fetch('/api/analytics-dashboard/dashboard?days=' + days).then(r=>r.json());
    if (!res.success) return;
    const d = res.data;
    // 邮件
    document.getElementById('de-sent').textContent = d.email.sent;
    document.getElementById('de-opened').textContent = d.email.opened;
    document.getElementById('de-clicked').textContent = d.email.clicked;
    document.getElementById('de-replied').textContent = d.email.replied;
    document.getElementById('de-openrate').textContent = d.email.openRate + '%';
    document.getElementById('de-clickrate').textContent = d.email.clickRate + '%';
    document.getElementById('de-replyrate').textContent = d.email.replyRate + '%';
    document.getElementById('de-blocked').textContent = d.email.blocked;
    // WhatsApp
    document.getElementById('dw-sent').textContent = d.whatsapp.sent;
    document.getElementById('dw-recv').textContent = d.whatsapp.received;
    document.getElementById('dw-conv').textContent = d.whatsapp.conversations;
    // 社媒
    document.getElementById('ds-posts').textContent = d.social.posts;
    document.getElementById('ds-leads').textContent = d.social.leads;
    document.getElementById('ds-platforms').textContent = (d.social.byPlatform||[]).map(p=>p.platform+':'+p.c).join(' | ');
    // 报价
    document.getElementById('dq-total').textContent = d.quotes.total||0;
    document.getElementById('dq-won').textContent = d.quotes.won||0;
    document.getElementById('dq-rate').textContent = (d.quotes.winRate||0)+'%';
    document.getElementById('dq-amount').textContent = '$'+(d.quotes.totalAmount||0).toLocaleString();
  } catch(e) { console.error(e); }
}

async function loadIntentLogs() {
  try {
    const res = await fetch('/api/analytics-dashboard/intent-logs?limit=50').then(r=>r.json());
    const tbody = document.getElementById('intent-log-body');
    if (!res.success || !res.data?.length) {
      tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-3">暂无意图检测记录</td></tr>';
    } else {
      tbody.innerHTML = res.data.map(l => {
        let kw = '';
        try { kw = JSON.parse(l.matched_keywords||'[]').join(', '); } catch(e) { kw = l.matched_keywords||''; }
        return `<tr>
          <td><small>${formatTime(l.created_at)}</small></td>
          <td>${esc(l.channel||'-')}</td>
          <td>${esc(l.customer_email||'-')}</td>
          <td><span class="badge ${l.intent==='pricing'?'bg-danger':l.intent==='inquiry'?'bg-info':'bg-secondary'}">${esc(l.intent)}</span></td>
          <td>${((l.confidence||0)*100).toFixed(0)}%</td>
          <td>${l.handled===0?'<span class="badge bg-danger">是</span>':'-'}</td>
          <td><small>${esc(kw)}</small></td>
        </tr>`;
      }).join('');
    }
  } catch(e) {}
}

// Tab切换加载dashboard
document.querySelectorAll('#toolTabs a[data-bs-toggle="tab"]').forEach(tab => {
  tab.addEventListener('shown.bs.tab', function(e) {
    const target = e.target.getAttribute('href');
    if (target === '#tab-dashboard') { loadDashboard(); loadIntentLogs(); }
  });
});
</script>

