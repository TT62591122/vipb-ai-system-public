// ========== 社媒账号管理（矩阵面板） ==========
let saCurrentPlatform = 'all';
let saSelectedIds = new Set();
const saIcons = { whatsapp:'💬', tiktok:'🎵', facebook:'📘', linkedin:'🔗' };
const saStatusDot = {
  connected:    '<span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#28a745" title="在线"></span>',
  warming:      '<span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#ffc107" title="养号中"></span>',
  error:        '<span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#dc3545" title="异常"></span>',
  disconnected: '<span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#adb5bd" title="离线"></span>',
  banned:       '<span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#6f42c1" title="封号"></span>',
  paused:       '<span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#17a2b8" title="暂停"></span>'
};

document.addEventListener('DOMContentLoaded', () => {
  document.querySelector('[href="#tab-accounts"]')?.addEventListener('shown.bs.tab', () => saLoadCards());
});

async function saLoadStats() {
