      </div>
      <div class="modal-body">
        <form id="tiktok-publish-form">
          <div class="mb-3">
            <label class="form-label">授权状态:</label>
            <span id="tiktok-auth-status" class="badge bg-secondary">加载中...</span>
            <span id="tiktok-display-name" class="ms-2 text-muted"></span>
          </div>
          <div class="mb-3">
            <label for="tiktok-video-file" class="form-label">选择视频文件 (MP4/WebM, 最大287MB)</label>
            <input class="form-control" type="file" id="tiktok-video-file" name="video" accept="video/mp4,video/webm,video/quicktime">
          </div>
          <div class="mb-3">
            <label for="tiktok-video-title" class="form-label">视频标题 (最多150字符)</label>
            <input type="text" class="form-control" id="tiktok-video-title" name="title" maxlength="150">
          </div>
          <div class="mb-3">
            <label for="tiktok-privacy-level" class="form-label">隐私设置</label>
            <select class="form-select" id="tiktok-privacy-level" name="privacyLevel">
              <option value="PUBLIC_TO_EVERYONE">所有人可见</option>
              <option value="MUTUAL_FOLLOW_FRIENDS">互关朋友可见</option>
              <option value="FOLLOWER_OF_CREATOR">粉丝可见</option>
              <option value="SELF_ONLY">仅自己可见</option>
            </select>
          </div>
          <div class="progress mb-3 d-none" id="tiktok-upload-progress">
            <div class="progress-bar" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">0%</div>
          </div>
          <button type="submit" class="btn btn-purple" id="tiktok-publish-btn">发布视频</button>
        </form>
        <hr>
        <h6>发布历史</h6>
        <div id="tiktok-publish-history" style="max-height: 200px; overflow-y: auto;">
          <p class="text-muted text-center">暂无发布记录</p>
        </div>
      </div>
