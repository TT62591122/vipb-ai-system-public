function saFilterPlatform(btn, platform) {
  saCurrentPlatform = platform;
  document.querySelectorAll('#sa-platform-filter .btn').forEach(b => {
    b.classList.remove('btn-purple','active');
    b.classList.add('btn-outline-secondary');
  });
  btn.classList.remove('btn-outline-secondary');
  btn.classList.add('btn-purple','active');
  saLoadCards();
}

async function saLoadCards() {
  saLoadStats();
  const search = document.getElementById('sa-search-all')?.value || '';
  const params = new URLSearchParams();
  if (saCurrentPlatform !== 'all') params.set('platform', saCurrentPlatform);
  if (search) params.set('search', search);

  // 缓存环境资源
  if (!window._envCache) {
    try {
      const [proxies, profiles, phones, chains] = await Promise.all([
        api('/api/env/proxies'), api('/api/env/profiles'), api('/api/env/phones'), api('/api/env/chains')
      ]);
      window._envCache = { proxies: proxies || [], profiles: profiles || [], phones: phones || [], chains: chains || [] };
    } catch(e) { window._envCache = { proxies: [], profiles: [], phones: [], chains: [] }; }
  }
  const ec = window._envCache;

  function proxyOpts(selectedId) {
    return ec.proxies.map(p => `<option value="${p.id}" ${p.id==selectedId?'selected':''}>${p.type||'http'} | ${p.host}:${p.port} | ${p.country||'-'} | ${p.is_alive?'✅':'❌'}</option>`).join('');
  }
  function profileOpts(selectedId) {
    return ec.profiles.map(p => `<option value="${p.id}" ${p.id==selectedId?'selected':''}>${p.name} | ${p.platform||'-'} | ${p.health_score??'-'}分</option>`).join('');
  }
  function phoneOpts(selectedId) {
    return ec.phones.map(p => `<option value="${p.id}" ${p.id==selectedId?'selected':''}>${p.number} | ${p.country||'-'} | ${p.status||'-'}</option>`).join('');
  }
  function chainOpts(selectedId) {
    return ec.chains.map(c => `<option value="${c.id}" ${c.id==selectedId?'selected':''}>${c.name || '链路#'+c.id}</option>`).join('');
  }

  try {
    const accounts = await api('/api/social-accounts?' + params);
    const container = document.getElementById('sa-cards-container');
    if (!accounts.length) {
      container.innerHTML = '<div class="text-center text-muted py-5">暂无账号，点击 ➕ 添加</div>';
      return;
    }

    container.innerHTML = accounts.map(a => {
      const icon = saIcons[a.platform] || '📱';
      const dot = saStatusDot[a.status] || saStatusDot.disconnected;
      const pct = a.daily_limit > 0 ? Math.min(100, Math.round((a.today_sent||0)/(a.daily_limit)*100)) : 0;
      const pctColor = pct > 80 ? 'danger' : pct > 50 ? 'warning' : 'success';
      const lastActive = a.last_active_at ? new Date(a.last_active_at).toLocaleString('zh-CN') : '从未';
      const checked = saSelectedIds.has(a.id) ? 'checked' : '';

      const proxyLabel = a.proxy_info ? `${a.proxy_info.type}://${a.proxy_info.host}:${a.proxy_info.port}` : (a.proxy || '无代理');

      return `<div class="card mb-2 shadow-sm" style="border-radius:10px;border-left:4px solid ${a.status==='connected'?'#28a745':a.status==='banned'?'#6f42c1':a.status==='warming'?'#ffc107':'#dee2e6'}" id="sa-card-${a.id}">
        <div class="card-body py-2 px-3">
          <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
              <input type="checkbox" ${checked} onchange="saToggleSelect(${a.id}, this)" class="sa-select-chk">
              <span style="font-size:1.4em">${icon}</span>
              <div>
                <strong>${a.display_name || a.account_id}</strong> ${dot}
                <div class="text-muted" style="font-size:0.75em">${a.account_id} · <span class="badge bg-${a.account_type==='business'?'primary':'secondary'}" style="font-size:0.7em">${a.account_type==='business'?'企业':'个人'}</span></div>
              </div>
            </div>
            <div class="d-flex gap-1">
              <button class="btn btn-xs btn-outline-success" onclick="saDispatch(${a.id},'connect')" title="连接">🔗</button>
              <button class="btn btn-xs btn-outline-warning" onclick="saQuickProxy(${a.id})" title="换IP">🔄</button>
              <button class="btn btn-xs btn-outline-primary" onclick="saToggleDetail(${a.id})" title="编辑">✏️</button>
              <button class="btn btn-xs btn-outline-danger" onclick="saDel(${a.id})" title="删除">🗑️</button>
            </div>
          </div>
          <div class="d-flex align-items-center gap-3 mt-1" style="font-size:0.82em">
            <span>🌐 <code class="sa-proxy-display" style="cursor:pointer" onclick="saQuickProxy(${a.id})" title="点击修改">${proxyLabel}</code></span>
            <span>📅 养号${a.warmup_days||0}天</span>
            <span style="min-width:140px">
              ${a.daily_limit > 0 ? `<span>${a.today_sent||0}/${a.daily_limit}</span>
              <div class="progress" style="height:5px;width:80px;display:inline-block;vertical-align:middle">
                <div class="progress-bar bg-${pctColor}" style="width:${pct}%"></div>
              </div>` : '<span class="text-muted">无限额</span>'}
            </span>
            <span class="text-muted">🕐 ${lastActive}</span>
          </div>
          <!-- 环境绑定区 -->
          <div class="border-top pt-2 mt-2">
            <div class="row g-2 small">
              <div class="col-12 mb-1">
                <label class="text-muted d-block">🔗 网络链路</label>
                <select class="form-select form-select-sm" onchange="saBindChain(${a.id}, this.value)">
                  <option value="">未绑定（使用独立代理配置）</option>${chainOpts(a.chain_id)}
                </select>
                <small class="text-muted">选择链路后，前置/VPN/落地自动配置</small>
              </div>
              <div class="col-4">
                <label class="text-muted d-block">🌐 代理IP</label>
                <select class="form-select form-select-sm ${a.chain_id ? 'opacity-50' : ''}" onchange="saBindProxy(${a.id}, this.value)" ${a.chain_id ? 'disabled' : ''}>
                  <option value="">未绑定</option>${proxyOpts(a.proxy_id)}
                </select>
              </div>
              <div class="col-4">
                <label class="text-muted d-block">🖥️ 浏览器环境</label>
                <select class="form-select form-select-sm" onchange="saBindProfile(${a.id}, this.value)">
                  <option value="">未绑定</option>${profileOpts(a.profile_id)}
                </select>
              </div>
              <div class="col-4">
                <label class="text-muted d-block">📱 接码号码</label>
                <select class="form-select form-select-sm" onchange="saBindPhone(${a.id}, this.value)">
                  <option value="">未绑定</option>${phoneOpts(a.phone_id)}
                </select>
              </div>
            </div>
          </div>
          <!-- 展开详情 -->
          <div class="d-none mt-2 pt-2 border-top" id="sa-detail-${a.id}">
            <div class="row g-2">
              <div class="col-md-4"><label class="form-label mb-0" style="font-size:0.8em">代理IP</label><input class="form-control form-control-sm" value="${a.proxy||''}" id="sa-ed-proxy-${a.id}"></div>
              <div class="col-md-2"><label class="form-label mb-0" style="font-size:0.8em">代理类型</label><select class="form-select form-select-sm" id="sa-ed-proxytype-${a.id}"><option value="http" ${(a.proxy_type||'http')==='http'?'selected':''}>HTTP</option><option value="socks5" ${a.proxy_type==='socks5'?'selected':''}>SOCKS5</option><option value="none" ${a.proxy_type==='none'?'selected':''}>无代理</option></select></div>
              <div class="col-md-3"><label class="form-label mb-0" style="font-size:0.8em">Access Token</label><input class="form-control form-control-sm" value="${a.access_token||''}" id="sa-ed-token-${a.id}"></div>
              <div class="col-md-3"><label class="form-label mb-0" style="font-size:0.8em">账号类型</label><select class="form-select form-select-sm" id="sa-ed-type-${a.id}"><option value="personal" ${a.account_type==='personal'?'selected':''}>个人</option><option value="business" ${a.account_type==='business'?'selected':''}>企业</option></select></div>
              <div class="col-md-6"><label class="form-label mb-0" style="font-size:0.8em">Cookies</label><textarea class="form-control form-control-sm" rows="2" id="sa-ed-cookies-${a.id}">${a.cookies||''}</textarea></div>
              <div class="col-md-6"><label class="form-label mb-0" style="font-size:0.8em">备注</label><textarea class="form-control form-control-sm" rows="2" id="sa-ed-notes-${a.id}">${a.notes||''}</textarea></div>
              <div class="col-12"><button class="btn btn-sm btn-purple" onclick="saSaveDetail(${a.id},'${a.platform}')">💾 保存</button></div>
            </div>
          </div>
        </div>
      </div>`;
    }).join('');
  } catch(e) { console.error(e); }
}

function saToggleDetail(id) {
  document.getElementById('sa-detail-' + id)?.classList.toggle('d-none');
}

function saToggleSelect(id, el) {
  if (el.checked) saSelectedIds.add(id); else saSelectedIds.delete(id);
  const bar = document.getElementById('sa-batch-bar');
  document.getElementById('sa-batch-count').textContent = saSelectedIds.size;
  bar.classList.toggle('d-none', saSelectedIds.size === 0);
}

function saClearSelection() {
  saSelectedIds.clear();
  document.querySelectorAll('.sa-select-chk').forEach(cb => cb.checked = false);
  document.getElementById('sa-batch-bar').classList.add('d-none');
}

async function saQuickProxy(id) {
  if (!window._envCache) {
    try {
      const [proxies, profiles, phones] = await Promise.all([
        api('/api/env/proxies'), api('/api/env/profiles'), api('/api/env/phones')
      ]);
      window._envCache = { proxies: proxies || [], profiles: profiles || [], phones: phones || [] };
    } catch(e) { window._envCache = { proxies: [], profiles: [], phones: [] }; }
  }
  const proxies = window._envCache.proxies;
  if (!proxies.length) { toast('代理池为空，请先在环境管理中添加代理', 'warning'); return; }
  const opts = proxies.map((p,i) => `${i+1}. ${p.type||'http'}://${p.host}:${p.port} (${p.country||'-'}) ${p.is_alive?'✅':'❌'}`).join('\n');
  const choice = prompt('选择代理（输入序号）:\n' + opts);
  if (!choice) return;
  const idx = parseInt(choice) - 1;
  if (idx < 0 || idx >= proxies.length) { toast('无效选择', 'warning'); return; }
  const proxy = proxies[idx];
  await api(`/api/social-accounts/${id}/bindProxy`, 'PUT', { proxy_id: proxy.id });
  // 同时更新旧的proxy文本字段
  await api(`/api/dispatcher/switch-proxy`, 'POST', { accountId: id, proxy: `${proxy.type||'http'}://${proxy.host}:${proxy.port}` });
  toast('代理已绑定');
  window._envCache = null;
  saLoadCards();
}

async function saBindChain(id, val) {
  await api('/api/social-accounts/' + id, 'PUT', { chain_id: val ? parseInt(val) : null });
  toast(val ? '链路已绑定' : '链路已解绑');
  window._envCache = null;
  saLoadCards();
}
async function saBindProxy(id, val) {
  await api(`/api/social-accounts/${id}/bindProxy`, 'PUT', { proxy_id: val ? parseInt(val) : null });
  toast(val ? '代理已绑定' : '代理已解绑');
}
async function saBindProfile(id, val) {
  await api(`/api/social-accounts/${id}/bindProfile`, 'PUT', { profile_id: val ? parseInt(val) : null });
  toast(val ? '浏览器环境已绑定' : '浏览器环境已解绑');
}
async function saBindPhone(id, val) {
  await api(`/api/social-accounts/${id}/bindPhone`, 'PUT', { phone_id: val ? parseInt(val) : null });
  toast(val ? '接码号码已绑定' : '接码号码已解绑');
}

async function saDispatch(id, action) {
  const res = await api('/api/dispatcher/execute', 'POST', { accountId: id, action });
  toast(res.success ? '操作成功' : (res.error || '操作失败'), res.success ? 'success' : 'warning');
  saLoadCards();
}

async function saDel(id) {
  if (!confirm('确定删除此账号？')) return;
  await api('/api/social-accounts/' + id, 'DELETE');
  toast('已删除');
  saLoadCards();
}

async function saSaveDetail(id, platform) {
  const data = {
    proxy: document.getElementById('sa-ed-proxy-' + id)?.value || '',
    proxy_type: document.getElementById('sa-ed-proxytype-' + id)?.value || 'http',
    cookies: document.getElementById('sa-ed-cookies-' + id)?.value || '',
    access_token: document.getElementById('sa-ed-token-' + id)?.value || '',
    account_type: document.getElementById('sa-ed-type-' + id)?.value || 'personal',
    notes: document.getElementById('sa-ed-notes-' + id)?.value || ''
  };
  await api('/api/social-accounts/' + id, 'PUT', data);
  toast('已保存');
  saLoadCards();
}

async function saBatchChangeIP() {
  if (!window._envCache) {
    try {
      const [proxies, profiles, phones] = await Promise.all([
        api('/api/env/proxies'), api('/api/env/profiles'), api('/api/env/phones')
      ]);
      window._envCache = { proxies: proxies || [], profiles: profiles || [], phones: phones || [] };
    } catch(e) { window._envCache = { proxies: [], profiles: [], phones: [] }; }
  }
  const proxies = window._envCache.proxies;
  if (!proxies.length) { toast('代理池为空', 'warning'); return; }
  const opts = proxies.map((p,i) => `${i+1}. ${p.type||'http'}://${p.host}:${p.port} (${p.country||'-'}) ${p.is_alive?'✅':'❌'}`).join('\n');
  const choice = prompt('选择代理（输入序号）:\n' + opts);
  if (!choice) return;
  const idx = parseInt(choice) - 1;
  if (idx < 0 || idx >= proxies.length) { toast('无效选择', 'warning'); return; }
  const proxy = proxies[idx];
  for (const id of saSelectedIds) {
    await api(`/api/social-accounts/${id}/bindProxy`, 'PUT', { proxy_id: proxy.id });
  }
  toast(`已为 ${saSelectedIds.size} 个账号绑定代理`);
  saClearSelection();
  window._envCache = null;
  saLoadCards();
}

async function saBatchDeleteSelected() {
  if (!confirm(`确定删除选中的 ${saSelectedIds.size} 个账号？`)) return;
  await api('/api/social-accounts/batch-delete', 'POST', { ids: [...saSelectedIds] });
  toast(`已删除 ${saSelectedIds.size} 个账号`);
  saClearSelection();
  saLoadCards();
}

function saShowAddModal(mode) {
  const isB = mode === 'batch';
  let html = `<div class="modal fade" id="saAddModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">${isB ? '📋 批量添加账号' : '➕ 添加账号'}</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
      <div class="mb-3"><label class="form-label">平台</label><select class="form-select" id="sa-add-platform">
        <option value="whatsapp">💬 WhatsApp</option><option value="tiktok">🎵 TikTok</option>
        <option value="facebook">📘 Facebook</option><option value="linkedin">🔗 LinkedIn</option></select></div>`;

  if (isB) {
    html += `<div class="mb-3"><label class="form-label">批量数据（每行一个）</label>
      <textarea class="form-control" rows="6" id="sa-add-batch" placeholder="账号ID|密码|代理IP|备注&#10;每行一个，支持 | , Tab 分隔"></textarea></div>`;
  } else {
    html += `<div class="mb-3"><label class="form-label">账号ID / 手机号</label><input class="form-control" id="sa-add-id"></div>
      <div class="mb-3"><label class="form-label">显示名称</label><input class="form-control" id="sa-add-name"></div>
      <div class="mb-3"><label class="form-label">密码</label><input class="form-control" type="password" id="sa-add-pass"></div>
      <div class="mb-3"><label class="form-label">代理IP（可选）</label><input class="form-control" id="sa-add-proxy" placeholder="http://user:pass@ip:port"></div>
      <div class="mb-3"><label class="form-label">类型</label><select class="form-select" id="sa-add-type"><option value="personal">个人</option><option value="business">企业</option></select></div>
      <hr><h6>🔗 环境绑定（可选）</h6>
      <div class="mb-3">
        <label class="form-label">🔒 指纹浏览器</label>
        <select class="form-select" id="sa-add-browser-type">
          <option value="builtin">🖥️ 自研引擎（内置）</option>
          <option value="adspower">🛡️ AdsPower</option>
          <option value="multilogin">🔐 Multilogin</option>
          <option value="geelark">📱 GeeLark（云手机）</option>
        </select>
      </div>
      <div class="mb-3"><label class="form-label">🔗 网络链路</label><select class="form-select" id="sa-add-chain-id"><option value="">不绑定</option></select></div>
      <div class="mb-3"><label class="form-label">🌐 代理IP（从代理池选择）</label><select class="form-select" id="sa-add-proxy-id"><option value="">不绑定</option></select></div>
      <div class="mb-3"><label class="form-label">🖥️ 浏览器环境</label><select class="form-select" id="sa-add-profile-id"><option value="">不绑定</option></select></div>
      <div class="mb-3"><label class="form-label">📱 接码号码</label><select class="form-select" id="sa-add-phone-id"><option value="">不绑定</option></select></div>`;
  }

  html += `</div><div class="modal-footer"><button class="btn btn-purple" onclick="saDoAddModal(${isB})">${isB?'批量添加':'添加'}</button></div></div></div></div>`;

  document.getElementById('saAddModal')?.remove();
  document.body.insertAdjacentHTML('beforeend', html);
  new bootstrap.Modal(document.getElementById('saAddModal')).show();

  // 填充环境下拉框
  if (!isB) {
    (async () => {
      if (!window._envCache) {
        try {
          const [proxies, profiles, phones, chains] = await Promise.all([
            api('/api/env/proxies'), api('/api/env/profiles'), api('/api/env/phones'), api('/api/env/chains')
          ]);
          window._envCache = { proxies: proxies || [], profiles: profiles || [], phones: phones || [], chains: chains || [] };
        } catch(e) { window._envCache = { proxies: [], profiles: [], phones: [], chains: [] }; }
      }
      const ec = window._envCache;
      const pSel = document.getElementById('sa-add-proxy-id');
      const bSel = document.getElementById('sa-add-profile-id');
      const phSel = document.getElementById('sa-add-phone-id');
      const chSel = document.getElementById('sa-add-chain-id');
      if (pSel) ec.proxies.forEach(p => { pSel.insertAdjacentHTML('beforeend', `<option value="${p.id}">${p.type||'http'} | ${p.host}:${p.port} | ${p.country||'-'} | ${p.is_alive?'✅':'❌'}</option>`); });
      if (bSel) ec.profiles.forEach(p => { bSel.insertAdjacentHTML('beforeend', `<option value="${p.id}">${p.name} | ${p.platform||'-'} | ${p.health_score??'-'}分</option>`); });
      if (phSel) ec.phones.forEach(p => { phSel.insertAdjacentHTML('beforeend', `<option value="${p.id}">${p.number} | ${p.country||'-'} | ${p.status||'-'}</option>`); });
      if (chSel) ec.chains.forEach(c => { chSel.insertAdjacentHTML('beforeend', `<option value="${c.id}">${c.name || '链路#'+c.id}</option>`); });
    })();
  }
}

async function saDoAddModal(isBatch) {
  const platform = document.getElementById('sa-add-platform').value;
  if (isBatch) {
    const input = document.getElementById('sa-add-batch').value.trim();
    if (!input) { toast('请输入数据','warning'); return; }
    const lines = input.split('\n').filter(l=>l.trim());
    const accounts = lines.map(line => {
      const p = line.trim().split(/[|,\t]/);
      return { 
        account_id: p[0]?.trim(), 
        password: (p[1]||'').trim(), 
        proxy: (p[2]||'').trim(), 
        display_name: (p[3]||'').trim(),
        browser_type: 'builtin'  // 批量添加默认使用内置浏览器
      };
    }).filter(a => a.account_id);
    const res = await api('/api/social-accounts/batch', 'POST', { platform, accounts });
    toast(`批量添加: ${res.added||0}个成功, ${res.skipped||0}个跳过`);
  } else {
    const id = document.getElementById('sa-add-id').value.trim();
    if (!id) { toast('请填写账号ID','warning'); return; }
    await api('/api/social-accounts', 'POST', {
      platform, account_id: id,
      display_name: document.getElementById('sa-add-name').value.trim(),
      password: document.getElementById('sa-add-pass').value,
      proxy: document.getElementById('sa-add-proxy').value.trim(),
      account_type: document.getElementById('sa-add-type').value,
      phone: platform==='whatsapp'? id : '',
      email: ['tiktok','facebook','linkedin'].includes(platform)? id : '',
      browser_type: document.getElementById('sa-add-browser-type')?.value || 'builtin'
    });
    // 绑定环境（如果选了）
    // 需要先获取刚添加的账号ID - 通过重新加载列表来间接处理
    const proxyId = document.getElementById('sa-add-proxy-id')?.value;
    const profileId = document.getElementById('sa-add-profile-id')?.value;
    const phoneId = document.getElementById('sa-add-phone-id')?.value;
    const chainId = document.getElementById('sa-add-chain-id')?.value;
    // 获取最新添加的账号
    if (proxyId || profileId || phoneId || chainId) {
      const all = await api('/api/social-accounts?platform=' + platform);
      const newest = all[0]; // 按created_at DESC排序，第一个是最新的
      if (newest) {
        if (proxyId) await api(`/api/social-accounts/${newest.id}/bindProxy`, 'PUT', { proxy_id: parseInt(proxyId) });
        if (profileId) await api(`/api/social-accounts/${newest.id}/bindProfile`, 'PUT', { profile_id: parseInt(profileId) });
        if (phoneId) await api(`/api/social-accounts/${newest.id}/bindPhone`, 'PUT', { phone_id: parseInt(phoneId) });
        if (chainId) await api(`/api/social-accounts/${newest.id}`, 'PUT', { chain_id: parseInt(chainId) });
      }
    }
    toast('账号已添加');
  }
  bootstrap.Modal.getInstance(document.getElementById('saAddModal'))?.hide();
  saLoadCards();
}

// ==================== TikTok OAuth 授权 ====================
async function tkOAuthConnect() {
  try {
    // 先检查是否配置了TikTok API密钥
    const config = await api('/api/settings/tiktok-api');
    if (!config || !config.data || !config.data.clientKey) {
      toast('请先在 设置 → TikTok API 中配置 Client Key 和 Client Secret', 'warning');
      return;
    }
    const clientKey = config.data.clientKey;
    const redirectUri = config.data.redirectUri || 'http://localhost:3001/oauth/tiktok/callback';
    const scope = 'user.info.basic,video.publish,video.upload,video.list';
    const csrfState = 'tk_' + Math.random().toString(36).substring(2, 15);
    const authUrl = `https://www.tiktok.com/v2/auth/authorize/?client_key=${clientKey}&scope=${scope}&response_type=code&redirect_uri=${encodeURIComponent(redirectUri)}&state=${csrfState}`;
    window.open(authUrl, 'TikTok授权', 'width=600,height=700');
    toast('TikTok授权窗口已打开，请在弹出窗口中完成授权');
  } catch (e) {
    toast('TikTok授权失败: ' + e.message, 'danger');
  }
}
</script>
