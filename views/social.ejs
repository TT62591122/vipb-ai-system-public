// ========== WhatsApp 功能 ==========
let waCurrentChat = null;
let waCurrentLabel = '';
let waQrModal = null;
let waPolling = null;

// 页面加载时初始化
document.addEventListener('DOMContentLoaded', async () => {
  waQrModal = new bootstrap.Modal(document.getElementById('waQrModal'));
  
  // 先检查WhatsApp模块是否启用
  try {
    const modRes = await fetch('/api/settings/modules/whatsapp');
    const modData = await modRes.json();
    if (!modData.enabled) {
      // 模块未启用，显示提示，不发无效请求
      const waPane = document.getElementById('tab-whatsapp');
      if (waPane) {
        waPane.innerHTML = '<div class="text-center py-5"><div style="font-size:48px;margin-bottom:16px">💬</div><h5 class="text-muted">WhatsApp 模块未启用</h5><p class="text-muted">请到 <a href="/settings#tab-modules">设置 → 模块管理</a> 中开启 WhatsApp 模块</p></div>';
      }
      return; // 不继续初始化WhatsApp
    }
  } catch(e) { /* 检查失败则继续正常加载 */ }

  waLoadStatus();
  waLoadStats();
  waLoadQuickReplies();
  waLoadAutoReplies();
  waLoadBroadcastLists();

  // Socket.IO 实时监听
  if (typeof io !== 'undefined') {
    const socket = io();
    socket.on('whatsapp:status', (data) => waUpdateStatus(data));
    socket.on('whatsapp:qr', (data) => {
      if (data.qr) {
        document.getElementById('wa-qr-container').innerHTML = `<img src="${data.qr}" style="max-width:250px;border-radius:8px">`;
        waQrModal.show();
      }
    });
    socket.on('whatsapp:message', (data) => {
      waLoadConversations();
      waLoadStats();
      if (waCurrentChat && data.chat_id === waCurrentChat) {
        waLoadMessages(waCurrentChat);
      }
      // Toast 通知
      if (data.direction === 'inbound') {
        toast(`💬 ${data.contact_name}: ${(data.content||'').substring(0,50)}`);
      }
    });
  }
});

async function waConnect() {
  const res = await api('/api/whatsapp/connect', 'POST');
  if (res.success) {
    toast('正在连接 WhatsApp...');
    document.getElementById('wa-connect-btn').disabled = true;
    document.getElementById('wa-connect-btn').innerHTML = '<span class="spinner-border spinner-border-sm"></span> 连接中...';
    // 开始轮询状态
    waPolling = setInterval(waLoadStatus, 2000);
  }
}

async function waDisconnect() {
  if (!confirm('确定断开 WhatsApp？')) return;
  await api('/api/whatsapp/disconnect', 'POST');
  waUpdateStatus({ status: 'disconnected' });
  if (waPolling) { clearInterval(waPolling); waPolling = null; }
}

async function waLoadStatus() {
  const data = await api('/api/whatsapp/status');
  waUpdateStatus(data);
  if (data.status === 'ready') {
    if (waPolling) { clearInterval(waPolling); waPolling = null; }
    waQrModal.hide();
    waLoadConversations();
  }
}

function waUpdateStatus(data) {
  const dot = document.getElementById('wa-status-dot');
  const text = document.getElementById('wa-status-text');
  const info = document.getElementById('wa-account-info');
  const connectBtn = document.getElementById('wa-connect-btn');
  const disconnectBtn = document.getElementById('wa-disconnect-btn');

  const statusMap = {
    disconnected: { color: '#dc3545', text: '❌ 未连接', showConnect: true },
    qr_pending: { color: '#ffc107', text: '📱 等待扫码...', showConnect: false },
    authenticated: { color: '#17a2b8', text: '🔄 认证中...', showConnect: false },
    ready: { color: '#28a745', text: '🟢 已连接', showConnect: false },
    error: { color: '#dc3545', text: '❌ 连接错误', showConnect: true },
    not_initialized: { color: '#6c757d', text: '未初始化', showConnect: true }
  };

  const s = statusMap[data.status] || statusMap.disconnected;
  dot.style.background = s.color;
  text.textContent = s.text;
  connectBtn.classList.toggle('d-none', !s.showConnect);
  connectBtn.disabled = false;
  connectBtn.innerHTML = '🔗 连接 WhatsApp';
  disconnectBtn.classList.toggle('d-none', data.status !== 'ready');

  if (data.info) {
    info.textContent = `${data.info.pushname || ''} (${data.info.phone || ''})`;
  } else {
    info.textContent = '';
  }
}

async function waLoadStats() {
  try {
    const s = await api('/api/whatsapp/stats');
    document.getElementById('wa-stat-conversations').textContent = s.totalConversations || 0;
    document.getElementById('wa-stat-unread').textContent = s.unreadCount || 0;
    document.getElementById('wa-stat-today').textContent = s.todayMessages || 0;
    document.getElementById('wa-stat-sent').textContent = s.todaySent || 0;
    document.getElementById('wa-stat-received').textContent = s.todayReceived || 0;
    document.getElementById('wa-stat-auto').textContent = s.autoRepliesActive || 0;
  } catch(e) {}
}

async function waLoadConversations() {
  const search = document.getElementById('wa-search')?.value || '';
  const params = new URLSearchParams();
  if (search) params.set('search', search);
  if (waCurrentLabel) params.set('label', waCurrentLabel);

  try {
    const convs = await api(`/api/whatsapp/conversations?${params}`);
    const list = document.getElementById('wa-conversation-list');

    if (!convs.length) {
      list.innerHTML = '<p class="text-muted text-center small py-3">暂无对话</p>';
      return;
    }

    list.innerHTML = convs.map(c => {
      const labels = JSON.parse(c.labels || '[]');
      const labelBadge = labels.length ? labels.map(l => {
        const colors = { new:'danger', quoting:'warning', sample:'info', deal:'success', support:'secondary' };
        return `<span class="badge bg-${colors[l]||'secondary'} badge-sm">${l}</span>`;
      }).join(' ') : '';

      const active = waCurrentChat === c.chat_id ? 'active' : '';
      const unread = c.unread_count > 0 ? `<span class="badge bg-success rounded-pill">${c.unread_count}</span>` : '';
      const pinIcon = c.is_pinned ? '📌 ' : '';
      const time = c.last_message_at ? new Date(c.last_message_at).toLocaleTimeString('zh-CN', {hour:'2-digit',minute:'2-digit'}) : '';

      return `<a href="#" class="list-group-item list-group-item-action p-2 ${active}" onclick="waOpenChat('${c.chat_id}')">
        <div class="d-flex justify-content-between">
          <strong class="small">${pinIcon}${c.contact_name || c.contact_phone || '未知'}</strong>
          <span class="small text-muted">${time} ${unread}</span>
        </div>
        <div class="small text-muted text-truncate" style="max-width:280px">${c.last_message || ''}</div>
        <div>${labelBadge}</div>
      </a>`;
    }).join('');
  } catch(e) {
    console.error('加载对话失败:', e);
  }
}

let waSearchTimeout;
function waSearchConversations() {
  clearTimeout(waSearchTimeout);
  waSearchTimeout = setTimeout(waLoadConversations, 300);
}

function waFilterLabel(btn, label) {
  document.querySelectorAll('.wa-label-filter').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  waCurrentLabel = label;
  waLoadConversations();
}

async function waOpenChat(chatId) {
  waCurrentChat = chatId;

  // 高亮当前对话
  document.querySelectorAll('#wa-conversation-list .list-group-item').forEach(el => el.classList.remove('active'));
  event?.target?.closest('.list-group-item')?.classList.add('active');

  // 显示操作按钮
  document.getElementById('wa-btn-product').classList.remove('d-none');
  document.getElementById('wa-btn-link-crm').classList.remove('d-none');
  document.getElementById('wa-label-dropdown').classList.remove('d-none');

  try {
    const data = await api(`/api/whatsapp/conversations/${encodeURIComponent(chatId)}`);
    const conv = data.conversation;
    const msgs = data.messages;

    // 更新头部
    document.getElementById('wa-chat-name').textContent = conv.contact_name || '未知';
    document.getElementById('wa-chat-phone').textContent = conv.contact_phone || '';

    // 渲染消息
    const area = document.getElementById('wa-messages-area');
    if (!msgs.length) {
      area.innerHTML = '<p class="text-muted text-center py-3 small">暂无消息记录</p>';
    } else {
      area.innerHTML = msgs.map(m => {
        const isOut = m.direction === 'outbound';
        const align = isOut ? 'text-end' : 'text-start';
        const bgColor = isOut ? '#005c4b' : '#202c33';
        const time = new Date(m.created_at).toLocaleTimeString('zh-CN', {hour:'2-digit',minute:'2-digit'});
        const statusIcon = isOut ? (m.status === 'read' ? '✓✓' : m.status === 'delivered' ? '✓✓' : '✓') : '';
        const statusColor = m.status === 'read' ? '#53bdeb' : '#8696a0';

        return `<div class="${align} mb-2">
          <div class="d-inline-block p-2 rounded-3" style="background:${bgColor};max-width:80%;text-align:left">
            <div class="small" style="white-space:pre-wrap;word-break:break-word;color:#e9edef">${escapeHtml(m.content || '')}</div>
            <div class="text-end"><small style="color:#8696a0;font-size:0.7em">${time} <span style="color:${statusColor}">${statusIcon}</span></small></div>
          </div>
        </div>`;
      }).join('');
      area.scrollTop = area.scrollHeight;
    }

    // 客户信息面板
    const panel = document.getElementById('wa-customer-panel');
    if (data.customer) {
      const c = data.customer;
      panel.innerHTML = `
        <div class="small">
          <p><strong>🏢 ${c.company || '未知公司'}</strong></p>
          <p>👤 ${c.contact_name || ''}</p>
          <p>📧 ${c.email || '-'}</p>
          <p>📱 ${c.phone || '-'}</p>
          <p>🌍 ${c.country || '-'}</p>
          <p>📊 阶段: <span class="badge bg-primary">${c.stage || 'new'}</span></p>
          <p>⭐ 评分: ${c.lead_score || 0}</p>
          <p>🏷️ 来源: ${c.source || '-'}</p>
          ${c.ai_summary ? `<hr><p class="text-muted">🤖 ${c.ai_summary}</p>` : ''}
        </div>
        <hr>
        <h6 class="small">📝 对话备注</h6>
        <textarea class="form-control form-control-sm" rows="3" id="wa-conv-notes" onchange="waSaveNotes()">${conv.notes || ''}</textarea>
      `;
    } else {
      panel.innerHTML = `
        <div class="small text-center py-2">
          <p>📱 ${conv.contact_name || ''}</p>
          <p>${conv.contact_phone || ''}</p>
          <p class="text-muted">未关联CRM客户</p>
          <button class="btn btn-sm btn-outline-primary" onclick="waLinkCRM()">🔗 关联客户</button>
          <button class="btn btn-sm btn-outline-success mt-1" onclick="waCreateCustomer()">➕ 新建客户</button>
        </div>
        <hr>
        <h6 class="small">📝 对话备注</h6>
        <textarea class="form-control form-control-sm" rows="3" id="wa-conv-notes" onchange="waSaveNotes()">${conv.notes || ''}</textarea>
      `;
    }

    // 刷新左侧列表（更新未读数）
    waLoadConversations();
  } catch(e) {
    console.error('打开对话失败:', e);
  }
}

async function waSend() {
  if (!waCurrentChat) return toast('请先选择对话');
  const input = document.getElementById('wa-input');
  const content = input.value.trim();
  if (!content) return;

  input.value = '';
  try {
    await api('/api/whatsapp/send', 'POST', { chat_id: waCurrentChat, content });
    waLoadMessages(waCurrentChat);
    waLoadConversations();
  } catch(e) {
    toast('发送失败: ' + e.message);
  }
}

async function waLoadMessages(chatId) {
  try {
    const data = await api(`/api/whatsapp/conversations/${encodeURIComponent(chatId)}`);
    const area = document.getElementById('wa-messages-area');
    const msgs = data.messages;
    area.innerHTML = msgs.map(m => {
      const isOut = m.direction === 'outbound';
      const bgColor = isOut ? '#005c4b' : '#202c33';
      const time = new Date(m.created_at).toLocaleTimeString('zh-CN',{hour:'2-digit',minute:'2-digit'});
      const statusIcon = isOut ? (m.status==='read'?'✓✓':m.status==='delivered'?'✓✓':'✓') : '';
      const statusColor = m.status==='read'?'#53bdeb':'#8696a0';
      return `<div class="${isOut?'text-end':'text-start'} mb-2">
        <div class="d-inline-block p-2 rounded-3" style="background:${bgColor};max-width:80%;text-align:left">
          <div class="small" style="white-space:pre-wrap;word-break:break-word;color:#e9edef">${escapeHtml(m.content||'')}</div>
          <div class="text-end"><small style="color:#8696a0;font-size:0.7em">${time} <span style="color:${statusColor}">${statusIcon}</span></small></div>
        </div>
      </div>`;
    }).join('');
    area.scrollTop = area.scrollHeight;
  } catch(e) {}
}

async function waSetLabel(label) {
  if (!waCurrentChat) return;
  const conv = await api(`/api/whatsapp/conversations/${encodeURIComponent(waCurrentChat)}`);
  let labels = [];
  try { labels = JSON.parse(conv.conversation?.labels || '[]'); } catch(e) { labels = []; }
