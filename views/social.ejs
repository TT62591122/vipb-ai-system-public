<%- include('partials/header') %>
<div class="main-content">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div><h4 class="mb-0">📱 社媒获客中心</h4><small class="text-muted">TikTok + Facebook + LinkedIn + 数据分析</small></div>
    <button class="btn btn-purple" data-bs-toggle="modal" data-bs-target="#addPostModal">➕ 创建内容</button>
  </div>

  <ul class="nav nav-tabs mb-4" role="tablist">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-whatsapp">💬 WhatsApp</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-tiktok">🎵 TikTok</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-facebook">📘 Facebook</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-linkedin">🔗 LinkedIn</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-leads">📊 线索管理</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-accounts">📱 账号管理</a></li>
  </ul>

  <div class="tab-content">
    <!-- WhatsApp -->
    <div class="tab-pane fade show active" id="tab-whatsapp">
      <!-- 连接状态栏 -->
      <div class="card mb-3" id="wa-status-card">
        <div class="card-body py-2 d-flex align-items-center justify-content-between">
          <div>
            <span id="wa-status-dot" class="d-inline-block rounded-circle me-2" style="width:10px;height:10px;background:#dc3545"></span>
            <span id="wa-status-text">未连接</span>
            <small class="text-muted ms-2" id="wa-account-info"></small>
          </div>
          <div>
            <button class="btn btn-sm btn-success" id="wa-connect-btn" onclick="waConnect()">🔗 连接 WhatsApp</button>
            <button class="btn btn-sm btn-danger d-none" id="wa-disconnect-btn" onclick="waDisconnect()">断开</button>
          </div>
        </div>
      </div>

      <!-- QR码弹窗 -->
      <div class="modal fade" id="waQrModal" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
          <div class="modal-content text-center">
            <div class="modal-header"><h6 class="modal-title">📱 扫描二维码连接 WhatsApp</h6><button class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
              <div id="wa-qr-container">
                <div class="spinner-border text-primary mb-3"></div>
                <p class="small text-muted">等待二维码生成...</p>
              </div>
              <p class="small text-muted mt-2">打开手机 WhatsApp → 设置 → 关联设备 → 扫描</p>
            </div>
          </div>
        </div>
      </div>

      <!-- 统计卡片 -->
      <div class="row g-3 mb-3">
        <div class="col-md-2"><div class="card text-center p-2"><div class="h5 mb-0" id="wa-stat-conversations">0</div><small class="text-muted">总对话</small></div></div>
        <div class="col-md-2"><div class="card text-center p-2"><div class="h5 mb-0 text-danger" id="wa-stat-unread">0</div><small class="text-muted">未读</small></div></div>
        <div class="col-md-2"><div class="card text-center p-2"><div class="h5 mb-0 text-primary" id="wa-stat-today">0</div><small class="text-muted">今日消息</small></div></div>
        <div class="col-md-2"><div class="card text-center p-2"><div class="h5 mb-0 text-success" id="wa-stat-sent">0</div><small class="text-muted">已发送</small></div></div>
        <div class="col-md-2"><div class="card text-center p-2"><div class="h5 mb-0 text-info" id="wa-stat-received">0</div><small class="text-muted">已接收</small></div></div>
        <div class="col-md-2"><div class="card text-center p-2"><div class="h5 mb-0 text-warning" id="wa-stat-auto">0</div><small class="text-muted">自动回复</small></div></div>
      </div>

      <!-- 主体区域：左侧对话列表 + 右侧聊天窗 -->
      <div class="row g-3">
        <!-- 对话列表 -->
        <div class="col-md-4">
          <div class="card" style="height:600px;display:flex;flex-direction:column">
            <div class="card-header py-2">
              <input type="text" class="form-control form-control-sm" id="wa-search" placeholder="🔍 搜索对话..." oninput="waSearchConversations()">
            </div>
            <div class="card-header py-1 d-flex gap-1 flex-wrap" style="border-top:0">
              <button class="btn btn-xs btn-outline-secondary wa-label-filter active" data-label="" onclick="waFilterLabel(this,'')">全部</button>
              <button class="btn btn-xs btn-outline-danger wa-label-filter" data-label="new" onclick="waFilterLabel(this,'new')">🔴 新询盘</button>
              <button class="btn btn-xs btn-outline-warning wa-label-filter" data-label="quoting" onclick="waFilterLabel(this,'quoting')">🟡 报价中</button>
              <button class="btn btn-xs btn-outline-info wa-label-filter" data-label="sample" onclick="waFilterLabel(this,'sample')">🔵 样品</button>
              <button class="btn btn-xs btn-outline-success wa-label-filter" data-label="deal" onclick="waFilterLabel(this,'deal')">🟢 成交</button>
              <button class="btn btn-xs btn-outline-secondary wa-label-filter" data-label="support" onclick="waFilterLabel(this,'support')">⚪ 售后</button>
            </div>
            <div class="card-body p-0" style="overflow-y:auto;flex:1" id="wa-conversation-list">
              <div class="text-center text-muted py-5">
                <p>💬 连接 WhatsApp 后显示对话</p>
              </div>
            </div>
          </div>
        </div>

        <!-- 聊天窗口 -->
        <div class="col-md-5">
          <div class="card" style="height:600px;display:flex;flex-direction:column">
            <!-- 聊天头部 -->
            <div class="card-header py-2 d-flex align-items-center justify-content-between" id="wa-chat-header">
              <div>
                <strong id="wa-chat-name">选择一个对话</strong>
                <small class="text-muted ms-2" id="wa-chat-phone"></small>
              </div>
              <div>
                <button class="btn btn-xs btn-outline-primary d-none" id="wa-btn-product" onclick="waShowProducts()" title="发送产品"><i>📦</i></button>
                <button class="btn btn-xs btn-outline-info d-none" id="wa-btn-link-crm" onclick="waLinkCRM()" title="关联CRM">🔗</button>
                <div class="btn-group d-none" id="wa-label-dropdown">
                  <button class="btn btn-xs btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">🏷️</button>
                  <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="#" onclick="waSetLabel('new')">🔴 新询盘</a></li>
                    <li><a class="dropdown-item" href="#" onclick="waSetLabel('quoting')">🟡 报价中</a></li>
                    <li><a class="dropdown-item" href="#" onclick="waSetLabel('sample')">🔵 样品阶段</a></li>
                    <li><a class="dropdown-item" href="#" onclick="waSetLabel('deal')">🟢 成交</a></li>
                    <li><a class="dropdown-item" href="#" onclick="waSetLabel('support')">⚪ 售后</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="#" onclick="waSetLabel('')">清除标签</a></li>
                  </ul>
                </div>
              </div>
            </div>
            <!-- 消息区域 -->
            <div class="card-body p-2" style="overflow-y:auto;flex:1;background:#0b141a" id="wa-messages-area">
              <div class="text-center text-muted py-5"><p>👈 选择左侧对话开始聊天</p></div>
            </div>
            <!-- 输入区域 -->
            <div class="card-footer p-2">
              <div class="d-flex gap-2 mb-1" id="wa-quick-reply-bar" style="display:none!important">
                <!-- 动态加载快捷回复按钮 -->
              </div>
              <div class="input-group">
                <button class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" id="wa-quick-btn" title="快捷回复">⚡</button>
                <ul class="dropdown-menu" id="wa-quick-menu">
                  <li><a class="dropdown-item small" href="#" onclick="waUseQuick('greeting')">👋 问候</a></li>
                  <li><a class="dropdown-item small" href="#" onclick="waUseQuick('catalog')">📦 产品目录</a></li>
                  <li><a class="dropdown-item small" href="#" onclick="waUseQuick('price')">💰 询问需求</a></li>
                  <li><a class="dropdown-item small" href="#" onclick="waUseQuick('followup')">🔄 跟进</a></li>
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item small" href="#" onclick="waManageQuickReplies()">⚙️ 管理快捷回复</a></li>
                </ul>
                <textarea class="form-control form-control-sm" id="wa-input" rows="1" placeholder="输入消息..." onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();waSend()}"></textarea>
                <button class="btn btn-success btn-sm" onclick="waSend()">发送</button>
                <button class="btn btn-outline-primary btn-sm" onclick="waAiReply()" title="AI生成回复">🤖</button>
              </div>
            </div>
          </div>
        </div>

        <!-- 右侧信息面板 -->
        <div class="col-md-3">
          <div class="card" style="height:600px;overflow-y:auto">
            <div class="card-header py-2"><strong>📋 客户信息</strong></div>
            <div class="card-body p-2" id="wa-customer-panel">
              <p class="text-muted small text-center py-3">选择对话查看客户信息</p>
            </div>
          </div>
        </div>
      </div>

      <!-- 下方功能区 -->
      <div class="row g-3 mt-2">
        <!-- 广播管理 -->
        <div class="col-md-4">
          <div class="card">
            <div class="card-header py-2 d-flex justify-content-between align-items-center">
              <strong>📢 广播列表</strong>
              <button class="btn btn-xs btn-purple" onclick="waAddBroadcastList()">➕</button>
            </div>
            <div class="card-body p-0" style="max-height:250px;overflow-y:auto" id="wa-broadcast-lists">
              <p class="text-muted text-center small py-3">暂无广播列表</p>
            </div>
          </div>
        </div>
        <!-- 自动回复规则 -->
        <div class="col-md-4">
          <div class="card">
            <div class="card-header py-2 d-flex justify-content-between align-items-center">
              <strong>🤖 自动回复规则</strong>
              <button class="btn btn-xs btn-purple" onclick="waAddAutoReply()">➕</button>
            </div>
            <div class="card-body p-0" style="max-height:250px;overflow-y:auto" id="wa-auto-replies">
              <p class="text-muted text-center small py-3">暂无规则</p>
            </div>
          </div>
        </div>
        <!-- 快捷回复管理 -->
        <div class="col-md-4">
          <div class="card">
            <div class="card-header py-2 d-flex justify-content-between align-items-center">
              <strong>⚡ 快捷回复</strong>
              <button class="btn btn-xs btn-purple" onclick="waAddQuickReply()">➕</button>
            </div>
            <div class="card-body p-0" style="max-height:250px;overflow-y:auto" id="wa-quick-replies-list">
              <p class="text-muted text-center small py-3">暂无快捷回复</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TikTok -->
    <div class="tab-pane fade" id="tab-tiktok">
      <div class="row g-3">
        <div class="col-md-4">
          <div class="card">
            <div class="card-header">📹 内容模板</div>
            <div class="card-body p-0">
              <div class="list-group list-group-flush">
                <a href="#" class="list-group-item list-group-item-action" onclick="useTikTokTemplate('factory')">🏭 工厂实拍 — 展示生产线、质检流程</a>
                <a href="#" class="list-group-item list-group-item-action" onclick="useTikTokTemplate('product')">📦 产品展示 — 特写、功能演示</a>
                <a href="#" class="list-group-item list-group-item-action" onclick="useTikTokTemplate('install')">🔧 安装教程 — 电表/断路器安装步骤</a>
                <a href="#" class="list-group-item list-group-item-action" onclick="useTikTokTemplate('comparison')">⚖️ 产品对比 — 我们vs竞品</a>
                <a href="#" class="list-group-item list-group-item-action" onclick="useTikTokTemplate('packing')">📦 打包发货 — 满足感+信任感</a>
                <a href="#" class="list-group-item list-group-item-action" onclick="useTikTokTemplate('testimonial')">⭐ 客户反馈 — 真实case展示</a>
                <a href="#" class="list-group-item list-group-item-action" onclick="useTikTokTemplate('behind')">👷 幕后花絮 — 团队、办公室、日常</a>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card">
            <div class="card-header">🔥 热门标签推荐</div>
            <div class="card-body">
              <div class="d-flex flex-wrap gap-1">
                <span class="badge bg-danger">#SmartMeter</span>
                <span class="badge bg-danger">#CircuitBreaker</span>
                <span class="badge bg-info">#ElectricalEngineering</span>
                <span class="badge bg-info">#PowerDistribution</span>
                <span class="badge bg-warning text-dark">#MadeInChina</span>
                <span class="badge bg-warning text-dark">#FactoryTour</span>
                <span class="badge bg-success">#B2B</span>
                <span class="badge bg-success">#Manufacturing</span>
                <span class="badge bg-primary">#EnergyMeter</span>
                <span class="badge bg-primary">#Prepaid</span>
                <span class="badge bg-secondary">#DLMS</span>
                <span class="badge bg-secondary">#STS</span>
              </div>
              <div class="alert alert-info small mt-3 mb-0">
                <strong>发布建议:</strong> 每周3-5条 | 黄金时间: 目标市场当地19:00-21:00 | 前3秒必须抓眼球
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card">
            <div class="card-header">📊 已发布内容</div>
            <div class="card-body p-0" style="max-height:400px;overflow-y:auto">
              <% const tkPosts = posts.filter(p => p.platform==='tiktok'); %>
              <% tkPosts.forEach(p => { %>
              <div class="p-2 border-bottom"><small><%= (p.content||'').substring(0,80) %></small><br><span class="badge bg-secondary"><%= p.status %></span> <small class="text-muted"><%= p.created_at %></small></div>
              <% }) %>
              <% if(!tkPosts.length) { %><p class="text-muted text-center py-3">暂无TikTok内容</p><% } %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Facebook -->
    <div class="tab-pane fade" id="tab-facebook">
      <div class="row g-3">
        <div class="col-md-6">
          <div class="card">
            <div class="card-header">📘 Facebook营销</div>
            <div class="card-body">
              <h6>群组搜索</h6>
              <div class="input-group mb-3">
                <input type="text" class="form-control" id="fb-group-search" placeholder="搜索关键词: smart meter, energy, electrical">
                <button class="btn btn-purple" onclick="searchFBGroups()">🔍 搜索</button>
              </div>
              <div id="fb-group-results"></div>
              <hr>
              <h6>推荐群组类型</h6>
              <ul class="small">
                <li><strong>行业群组:</strong> Electrical Engineers, Power Distribution</li>
                <li><strong>采购群组:</strong> B2B Buyers, Import/Export</li>
                <li><strong>地区群组:</strong> Africa Energy, Middle East Electrical</li>
                <li><strong>项目群组:</strong> Smart Grid, AMI Projects</li>
              </ul>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card">
            <div class="card-header">📊 Facebook内容</div>
            <div class="card-body p-0" style="max-height:400px;overflow-y:auto">
              <% const fbPosts = posts.filter(p => p.platform==='facebook'); %>
              <% fbPosts.forEach(p => { %>
              <div class="p-2 border-bottom"><small><%= (p.content||'').substring(0,100) %></small><br><span class="badge bg-secondary"><%= p.status %></span></div>
              <% }) %>
              <% if(!fbPosts.length) { %><p class="text-muted text-center py-3">暂无Facebook内容</p><% } %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- LinkedIn -->
    <div class="tab-pane fade" id="tab-linkedin">
      <div class="row g-3">
        <div class="col-md-6">
          <div class="card">
            <div class="card-header">🔗 LinkedIn获客</div>
            <div class="card-body">
              <h6>目标客户搜索</h6>
              <div class="row g-2 mb-3">
                <div class="col-6"><input type="text" class="form-control form-control-sm" id="li-title" placeholder="职位: Procurement Manager"></div>
                <div class="col-6"><input type="text" class="form-control form-control-sm" id="li-industry" placeholder="行业: Energy / Utilities"></div>
                <div class="col-6"><input type="text" class="form-control form-control-sm" id="li-country" placeholder="国家/地区"></div>
                <div class="col-6"><button class="btn btn-sm btn-purple w-100" onclick="searchLinkedIn()">🔍 搜索</button></div>
              </div>
              <div id="li-results"></div>
              <hr>
              <h6>InMail模板</h6>
              <div class="list-group list-group-flush">
                <a href="#" class="list-group-item list-group-item-action small" onclick="useInMailTemplate('intro')">👋 自我介绍 — 首次连接请求</a>
                <a href="#" class="list-group-item list-group-item-action small" onclick="useInMailTemplate('value')">💡 价值提供 — 分享行业洞察</a>
                <a href="#" class="list-group-item list-group-item-action small" onclick="useInMailTemplate('meeting')">📅 约会面谈 — 邀请线上会议</a>
                <a href="#" class="list-group-item list-group-item-action small" onclick="useInMailTemplate('case')">📋 案例分享 — 成功项目介绍</a>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card">
            <div class="card-header">📊 LinkedIn内容</div>
            <div class="card-body p-0" style="max-height:400px;overflow-y:auto">
              <% const liPosts = posts.filter(p => p.platform==='linkedin'); %>
              <% liPosts.forEach(p => { %>
              <div class="p-2 border-bottom"><small><%= (p.content||'').substring(0,100) %></small><br><span class="badge bg-secondary"><%= p.status %></span></div>
              <% }) %>
              <% if(!liPosts.length) { %><p class="text-muted text-center py-3">暂无LinkedIn内容</p><% } %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 线索管理 -->
    <div class="tab-pane fade" id="tab-leads">
      <div class="table-container">
        <table class="table table-hover">
          <thead><tr><th>平台</th><th>用户名</th><th>消息</th><th>状态</th><th>时间</th></tr></thead>
          <tbody>
            <% leads.forEach(l => { %>
            <tr><td><%= l.platform %></td><td><%= l.username %></td><td><%= (l.message||'').substring(0,50) %></td><td><span class="badge badge-stage badge-new"><%= l.status %></span></td><td><small><%= l.created_at %></small></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- 账号管理 -->
    <div class="tab-pane fade" id="tab-accounts">
      <!-- 顶部统计卡片 -->
      <div class="row g-3 mb-3" id="sa-stats-row">
        <div class="col"><div class="card text-center p-3 border-0 shadow-sm" style="background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border-radius:12px"><div class="h3 mb-0 fw-bold" id="sa-stat-total">0</div><small>总账号</small></div></div>
        <div class="col"><div class="card text-center p-3 border-0 shadow-sm" style="background:linear-gradient(135deg,#43e97b,#38f9d7);color:#fff;border-radius:12px"><div class="h3 mb-0 fw-bold" id="sa-stat-online">0</div><small>在线</small></div></div>
        <div class="col"><div class="card text-center p-3 border-0 shadow-sm" style="background:linear-gradient(135deg,#f6d365,#fda085);color:#fff;border-radius:12px"><div class="h3 mb-0 fw-bold" id="sa-stat-warming">0</div><small>养号中</small></div></div>
        <div class="col"><div class="card text-center p-3 border-0 shadow-sm" style="background:linear-gradient(135deg,#f78ca0,#f85032);color:#fff;border-radius:12px"><div class="h3 mb-0 fw-bold" id="sa-stat-abnormal">0</div><small>异常</small></div></div>
        <div class="col"><div class="card text-center p-3 border-0 shadow-sm" style="background:linear-gradient(135deg,#a18cd1,#fbc2eb);color:#fff;border-radius:12px"><div class="h3 mb-0 fw-bold" id="sa-stat-ops">0</div><small>今日操作</small></div></div>
      </div>

      <!-- 平台筛选 + 搜索 -->
      <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="btn-group" id="sa-platform-filter">
          <button class="btn btn-sm btn-purple active" onclick="saFilterPlatform(this,'all')">全部</button>
          <button class="btn btn-sm btn-outline-secondary" onclick="saFilterPlatform(this,'whatsapp')">💬 WhatsApp</button>
          <button class="btn btn-sm btn-outline-secondary" onclick="saFilterPlatform(this,'tiktok')">🎵 TikTok</button>
          <button class="btn btn-sm btn-outline-secondary" onclick="saFilterPlatform(this,'facebook')">📘 Facebook</button>
          <button class="btn btn-sm btn-outline-secondary" onclick="saFilterPlatform(this,'linkedin')">🔗 LinkedIn</button>
        </div>
        <div class="d-flex gap-2">
          <input class="form-control form-control-sm" style="width:200px" placeholder="🔍 搜索账号..." id="sa-search-all" oninput="saLoadCards()">
          <button class="btn btn-sm btn-success" onclick="tkOAuthConnect()" title="通过TikTok官方API授权">🎵 TikTok授权</button>
          <button class="btn btn-sm btn-info" data-bs-toggle="modal" data-bs-target="#tiktokPublishModal">📤 发布TikTok视频</button>
