    document.getElementById('sa-stat-online').textContent = s.online || 0;
    document.getElementById('sa-stat-warming').textContent = s.warming || 0;
    document.getElementById('sa-stat-abnormal').textContent = s.abnormal || 0;
    document.getElementById('sa-stat-ops').textContent = s.todayOps || 0;
  } catch(e) {}
