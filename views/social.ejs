}

async function waAiReply() {
  if (!waCurrentChat) return toast('请先选择对话');
  const input = document.getElementById('wa-input');
  input.value = '🤖 AI正在生成回复...';
  input.disabled = true;

  try {
    const data = await api(`/api/whatsapp/conversations/${encodeURIComponent(waCurrentChat)}`);
    const msgs = data.messages.slice(-10);
    const context = msgs.map(m => `${m.direction==='inbound'?'Customer':'Sales'}: ${m.content}`).join('\n');
    const lastMsg = msgs.filter(m => m.direction==='inbound').pop();

    const aiRes = await api('/api/ai/chat', 'POST', {
      message: `Based on this WhatsApp conversation with a B2B customer, generate a professional reply in the customer's language:\n\n${context}\n\nGenerate ONLY the reply text, no explanation.`,
      agent: 'sales'
    });

    input.disabled = false;
    input.value = aiRes.result || aiRes.content || 'AI生成失败';
    input.focus();
  } catch(e) {
    input.disabled = false;
    input.value = '';
    toast('AI回复生成失败');
  }
}

