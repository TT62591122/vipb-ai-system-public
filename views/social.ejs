<script>
// TikTok发布视频相关的JS
document.addEventListener('DOMContentLoaded', () => {
  const tiktokPublishModal = document.getElementById('tiktokPublishModal');
  if (tiktokPublishModal) {
    tiktokPublishModal.addEventListener('show.bs.modal', async () => {
      await loadTikTokAuthStatus();
      await loadTikTokPublishHistory();
    });
  }

  const tiktokPublishForm = document.getElementById('tiktok-publish-form');
  if (tiktokPublishForm) {
    tiktokPublishForm.addEventListener('submit', handleTikTokPublish);
  }
});

async function loadTikTokAuthStatus() {
  const statusEl = document.getElementById('tiktok-auth-status');
  const nameEl = document.getElementById('tiktok-display-name');
  statusEl.className = 'badge bg-secondary';
  statusEl.textContent = '加载中...';
  nameEl.textContent = '';

  const res = await api('/api/tiktok/auth-status');
  if (res.success) {
    if (res.authorized) {
      statusEl.className = 'badge bg-success';
      statusEl.textContent = '已授权';
      nameEl.textContent = `(${res.displayName})`;
      document.getElementById('tiktok-publish-btn').disabled = false;
    } else {
      statusEl.className = 'badge bg-danger';
      statusEl.textContent = '未授权或授权过期';
      nameEl.textContent = res.message || '';
      document.getElementById('tiktok-publish-btn').disabled = true;
      toast('TikTok未授权或授权过期，请先授权', 'danger');
    }
  } else {
    statusEl.className = 'badge bg-danger';
    statusEl.textContent = '获取授权状态失败';
    nameEl.textContent = res.error || '';
    document.getElementById('tiktok-publish-btn').disabled = true;
    toast(`获取TikTok授权状态失败: ${res.error}`, 'danger');
  }
}

async function loadTikTokPublishHistory() {
  const historyContainer = document.getElementById('tiktok-publish-history');
  historyContainer.innerHTML = '<p class="text-muted text-center">加载中...</p>';

  const res = await api('/api/tiktok/videos');
  if (res.success && res.videos.length > 0) {
    historyContainer.innerHTML = '';
    res.videos.forEach(video => {
      const item = document.createElement('div');
      item.className = 'd-flex align-items-center mb-2';
      item.innerHTML = `
        <i class="fas fa-video me-2"></i>
        <div>
          <strong class="text-white">${video.title}</strong>
          <small class="text-muted d-block">${new Date(video.publishedAt).toLocaleString()} - ${video.status}</small>
        </div>
      `;
      historyContainer.appendChild(item);
    });
  } else {
    historyContainer.innerHTML = '<p class="text-muted text-center">暂无发布记录</p>';
  }
}

async function handleTikTokPublish(event) {
  event.preventDefault();

  const form = event.target;
  const formData = new FormData(form);
  const videoFile = document.getElementById('tiktok-video-file').files[0];

  if (!videoFile) {
    toast('请选择一个视频文件', 'warning');
    return;
  }
  if (!formData.get('title').trim()) {
    toast('请输入视频标题', 'warning');
    return;
  }

  const publishBtn = document.getElementById('tiktok-publish-btn');
  const progressContainer = document.getElementById('tiktok-upload-progress');
  const progressBar = progressContainer.querySelector('.progress-bar');

  publishBtn.disabled = true;
  publishBtn.textContent = '发布中...';
  progressContainer.classList.remove('d-none');
  progressBar.style.width = '0%';
  progressBar.textContent = '0%';

  try {
    const res = await fetch('/api/tiktok/publish', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${localStorage.getItem('accessToken')}` // 假设你的API需要认证
      },
      body: formData
    });
    
    // Check if the response is JSON
    const contentType = res.headers.get('content-type');
    if (contentType && contentType.indexOf('application/json') !== -1) {
      const data = await res.json();
      if (res.ok && data.success) {
        toast('视频发布成功!', 'success');
        form.reset();
        loadTikTokPublishHistory();
        $('#tiktokPublishModal').modal('hide'); // 关闭模态框
      } else {
        toast(`发布失败: ${data.error || data.message || res.statusText}`, 'danger');
      }
    } else {
      // Handle non-JSON response (e.g., HTML error page)
      const errorText = await res.text();
      toast(`发布失败: ${res.status} ${res.statusText}. 错误详情: ${errorText.substring(0, 100)}...`, 'danger');
    }

  } catch (error) {
    console.error('TikTok发布失败:', error);
    toast(`发布异常: ${error.message}`, 'danger');
  } finally {
    publishBtn.disabled = false;
    publishBtn.textContent = '发布视频';
    progressContainer.classList.add('d-none');
  }
}
</script>
