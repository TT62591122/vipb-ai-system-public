// ========== 工具函数 ==========
function formatBytes(bytes) {
  if (!bytes || bytes <= 0) return '0 B';
  var units = ['B','KB','MB','GB','TB'];
  var i = Math.floor(Math.log(bytes) / Math.log(1024));
  if (i >= units.length) i = units.length - 1;
  return (bytes / Math.pow(1024, i)).toFixed(i > 0 ? 2 : 0) + ' ' + units[i];
}
function formatDate(ts) {
  if (!ts) return '-';
  var d = new Date(ts * 1000);
  return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
}
function daysUntil(ts) {
  if (!ts) return Infinity;
  return Math.ceil((ts * 1000 - Date.now()) / 86400000);
}

// ========== 订阅管理 ==========
var _subscriptions = [];
var _vpnFilterSubId = null;

async function loadSubscriptions() {
  try {
    _subscriptions = await api('/api/env/subscriptions');
    var subs = _subscriptions;
    var el = document.getElementById('subscription-cards');
    if (!subs.length) { el.innerHTML = '<div class="text-center text-muted py-3 small">暂无订阅，点击➕添加</div>'; updateVpnSubFilterBtns(); return; }
    el.innerHTML = subs.map(function(s) {
      var usedBytes = (s.upload_bytes||0) + (s.download_bytes||0);
      var totalBytes = s.total_bytes || 0;
      var usedPercent = totalBytes > 0 ? Math.min(100, Math.round(usedBytes / totalBytes * 100)) : 0;
      var barColor = usedPercent < 60 ? '#28a745' : (usedPercent < 80 ? '#ffc107' : '#dc3545');
      var expDays = daysUntil(s.expire_time);
      var expireClass = expDays < 7 ? 'text-danger fw-bold' : 'text-muted';
      var autoChecked = s.auto_update ? 'checked' : '';
      var isActive = _vpnFilterSubId === s.id ? ' border-primary' : '';
      return '<div class="border-bottom px-3 py-2 vpn-sub-card' + isActive + '" style="cursor:pointer" onclick="filterVpnBySubscription('+s.id+',null)">' +
        '<div class="d-flex justify-content-between align-items-center">' +
        '<div style="flex:1;min-width:0"><div class="fw-bold small">' + (s.name || '未命名') + '</div>' +
        '<div class="text-muted text-truncate" style="font-size:11px" title="' + s.url + '">' + s.url + '</div></div>' +
        '<span class="badge bg-info ms-1">' + (s.node_count || 0) + '</span></div>' +
        // 流量信息
        (totalBytes > 0 ? '<div class="sub-traffic mt-1">' +
          '<div class="traffic-bar"><div class="traffic-used" style="width:'+usedPercent+'%;background:'+barColor+'"></div></div>' +
          '<div class="d-flex justify-content-between" style="font-size:10px"><span class="text-muted">已用 '+formatBytes(usedBytes)+' / '+formatBytes(totalBytes)+'</span>' +
          '<span class="'+expireClass+'">到期: '+formatDate(s.expire_time)+'</span></div></div>' : '') +
        // 操作栏
        '<div class="d-flex justify-content-between align-items-center mt-1">' +
        '<div class="form-check form-switch mb-0" style="font-size:11px" onclick="event.stopPropagation()">' +
        '<input class="form-check-input" type="checkbox" '+autoChecked+' onchange="toggleAutoUpdate('+s.id+',this.checked)" title="自动更新(30分钟)">' +
        '<label class="form-check-label text-muted">自动</label></div>' +
        '<div class="btn-group btn-group-sm" onclick="event.stopPropagation()">' +
        '<button class="btn btn-outline-secondary btn-xs" onclick="editSubscription('+s.id+')" title="编辑">✏️</button>' +
        '<button class="btn btn-outline-primary btn-xs" onclick="refreshSubscription('+s.id+',this)">🔄</button>' +
        '<button class="btn btn-outline-danger btn-xs" onclick="deleteSubscription('+s.id+')">🗑️</button></div>' +
        '</div></div>';
    }).join('');
    updateVpnSubFilterBtns();
  } catch(e) { /* ignore */ }
}

function updateVpnSubFilterBtns() {
  var el = document.getElementById('vpn-sub-filter-btns');
  if (!el) return;
  el.innerHTML = _subscriptions.map(function(s) {
    var active = _vpnFilterSubId === s.id ? ' active' : '';
    return '<button class="btn btn-xs btn-outline-secondary vpn-filter-btn'+active+'" onclick="filterVpnBySubscription('+s.id+',this)">'+(s.name||'未命名')+'</button>';
  }).join('');
}

