.vpn-filter-btn { font-size: 11px; padding: 1px 6px; }
.vpn-filter-btn.active { background: var(--bs-primary); color: #fff; border-color: var(--bs-primary); }
</style>
<!-- eSIM管理所需库 -->
<script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js"></script>
<script>
// ========== 代理IP池（NekoBox风格） ==========
let _allProxies = [];
let _selectedProxies = new Set();
let _currentGroupFilter = '';

async function loadProxies() {
  try { _allProxies = await api('/api/env/proxies'); } catch(e) { _allProxies = []; }
  var roleFilter = document.getElementById('proxy-role-filter').value;
  var search = (document.getElementById('proxy-search').value || '').toLowerCase();
  var sortBy = document.getElementById('proxy-sort').value;
  var filtered = _allProxies;
  if (roleFilter) filtered = filtered.filter(function(p) { return p.role === roleFilter; });
  if (_currentGroupFilter) filtered = filtered.filter(function(p) { return (p.group_name||'') === _currentGroupFilter || (p.subscription_id && p.subscription_id+'' === _currentGroupFilter); });
  if (search) filtered = filtered.filter(function(p) {
    return (p.host||'').toLowerCase().includes(search) || (p.label||'').toLowerCase().includes(search) ||
      (p.country||'').toLowerCase().includes(search) || (p.protocol||'').toLowerCase().includes(search) ||
      (p.group_name||'').toLowerCase().includes(search);
  });
  // 排序
  if (sortBy === 'latency-asc') filtered.sort(function(a,b) { return (a.latency_ms||99999) - (b.latency_ms||99999); });
  else if (sortBy === 'latency-desc') filtered.sort(function(a,b) { return (b.latency_ms||0) - (a.latency_ms||0); });
  else if (sortBy === 'name') filtered.sort(function(a,b) { return (a.label||'').localeCompare(b.label||''); });

  // 更新统计
  var alive = _allProxies.filter(function(p) { return p.is_alive; });
  var dead = _allProxies.filter(function(p) { return p.latency_ms !== null && !p.is_alive; });
  document.getElementById('stat-total').textContent = _allProxies.length;
  document.getElementById('stat-alive').textContent = alive.length;
  document.getElementById('stat-dead').textContent = dead.length;
  var avgLatency = alive.length ? Math.round(alive.reduce(function(s,p){return s+(p.latency_ms||0);},0)/alive.length) : 0;
  document.getElementById('stat-avg-latency').textContent = alive.length ? avgLatency + 'ms' : '-';
  var aliveEl = document.getElementById('alive-proxy-stat');
  if (aliveEl) aliveEl.textContent = alive.length + '/' + _allProxies.length;

  // 更新分组树
  updateGroupTree();

  var tbody = document.getElementById('proxy-table-body');
  if (!filtered.length) { tbody.innerHTML = '<tr><td colspan="10" class="text-center text-muted py-3">暂无代理IP</td></tr>'; return; }
  var roleBadges = { frontend:'<span class="badge bg-success">🔰前置</span>', vpn:'<span class="badge bg-info">🔗VPN</span>', landing:'<span class="badge bg-warning text-dark">🎯落地</span>' };
  tbody.innerHTML = filtered.map(function(p) {
    var lh = '<span class="text-muted">未测</span>';
    if (p.latency_ms != null) {
      if (p.latency_ms < 0) lh = '<span class="badge bg-danger">超时</span>';
      else if (p.latency_ms < 100) lh = '<span class="badge bg-success">' + p.latency_ms + 'ms</span>';
      else if (p.latency_ms < 300) lh = '<span class="badge bg-warning text-dark">' + p.latency_ms + 'ms</span>';
      else lh = '<span class="badge bg-danger">' + p.latency_ms + 'ms</span>';
    }
    var checked = _selectedProxies.has(p.id) ? 'checked' : '';
    return '<tr class="' + (p.is_alive === 0 && p.latency_ms !== null ? 'opacity-50' : '') + '">' +
      '<td><input type="checkbox" class="form-check-input proxy-check" value="'+p.id+'" '+checked+' onchange="onProxySelect(this)"></td>' +
      '<td>' + (roleBadges[p.role] || roleBadges.landing) + '</td>' +
      '<td><span class="badge bg-secondary">' + (p.protocol||'http') + '</span></td>' +
      '<td><small>' + p.host + ':' + p.port + '</small></td>' +
      '<td>' + (p.country ? flagEmoji(p.country) + ' ' + p.country : '-') + '</td>' +
      '<td><small>' + (p.label||'-') + '</small></td><td><small>' + (p.group_name||'-') + '</small></td>' +
      '<td>' + lh + '</td><td>' + (p.is_alive ? '🟢' : (p.latency_ms !== null ? '🔴' : '⚪')) + '</td>' +
      '<td><div class="btn-group btn-group-sm">' +
      '<button class="btn btn-outline-info btn-xs" onclick="testProxy('+p.id+',this)" title="测速">⚡</button>' +
      '<button class="btn btn-outline-primary btn-xs" onclick="editProxy('+p.id+')" title="编辑">✏️</button>' +
      '<button class="btn btn-outline-secondary btn-xs" onclick="copyShareLink('+p.id+')" title="复制链接">📋</button>' +
      '<button class="btn btn-outline-danger btn-xs" onclick="deleteProxy('+p.id+')" title="删除">🗑️</button>' +
      '</div></td></tr>';
  }).join('');
  updateBatchButtons();
}

function flagEmoji(country) {
  var flags = { 'US':'🇺🇸','CN':'🇨🇳','HK':'🇭🇰','JP':'🇯🇵','KR':'🇰🇷','SG':'🇸🇬','TW':'🇹🇼','DE':'🇩🇪','UK':'🇬🇧','GB':'🇬🇧','FR':'🇫🇷','CA':'🇨🇦','AU':'🇦🇺','RU':'🇷🇺','IN':'🇮🇳','BR':'🇧🇷','NL':'🇳🇱','TR':'🇹🇷','TH':'🇹🇭','VN':'🇻🇳','PH':'🇵🇭','MY':'🇲🇾','ID':'🇮🇩' };
  var c = (country||'').toUpperCase().substring(0,2);
  return flags[c] || '🌐';
}

function updateGroupTree() {
  var groups = {};
  _allProxies.forEach(function(p) {
    var g = p.group_name || '未分组';
    if (!groups[g]) groups[g] = { count: 0, alive: 0 };
    groups[g].count++;
    if (p.is_alive) groups[g].alive++;
  });
  var el = document.getElementById('group-list');
  var html = '<a href="#" class="list-group-item list-group-item-action small py-2' + (!_currentGroupFilter ? ' active' : '') + '" onclick="filterByGroup(\'\',this)">📋 全部 <span class="badge bg-secondary float-end">' + _allProxies.length + '</span></a>';
  Object.keys(groups).sort().forEach(function(g) {
    var isActive = _currentGroupFilter === g ? ' active' : '';
    html += '<a href="#" class="list-group-item list-group-item-action small py-2' + isActive + '" onclick="filterByGroup(\''+g.replace(/'/g,"\\'")+'\',this)">📁 ' + g + ' <span class="badge bg-secondary float-end">' + groups[g].count + '</span></a>';
  });
  el.innerHTML = html;
  document.getElementById('grp-count-all') && (document.getElementById('grp-count-all').textContent = _allProxies.length);
}

function filterByGroup(group, el) {
  _currentGroupFilter = group;
  document.querySelectorAll('#group-list .list-group-item').forEach(function(a) { a.classList.remove('active'); });
  if (el) el.classList.add('active');
  loadProxies();
}

function onProxySelect(cb) {
  if (cb.checked) _selectedProxies.add(parseInt(cb.value));
  else _selectedProxies.delete(parseInt(cb.value));
  updateBatchButtons();
}

function toggleSelectAll(cb) {
  var checks = document.querySelectorAll('.proxy-check');
  checks.forEach(function(c) { c.checked = cb.checked; if (cb.checked) _selectedProxies.add(parseInt(c.value)); else _selectedProxies.delete(parseInt(c.value)); });
  updateBatchButtons();
}

function updateBatchButtons() {
  var n = _selectedProxies.size;
  document.getElementById('batch-delete-btn').classList.toggle('d-none', n === 0);
  document.getElementById('batch-test-btn').classList.toggle('d-none', n === 0);
  if (n > 0) {
    document.getElementById('batch-delete-btn').textContent = '🗑️ 删除(' + n + ')';
    document.getElementById('batch-test-btn').textContent = '⚡ 测速(' + n + ')';
  }
}

async function batchDeleteProxies() {
  if (!confirm('确定删除选中的 ' + _selectedProxies.size + ' 个代理？')) return;
  for (var id of _selectedProxies) { try { await api('/api/env/proxies/' + id, 'DELETE'); } catch(e){} }
  _selectedProxies.clear();
  toast('批量删除完成');
  loadProxies();
}

async function batchTestSelected() {
  var ids = Array.from(_selectedProxies);
  toast('测速 ' + ids.length + ' 个节点...');
  try {
    var r = await api('/api/env/proxies/test-batch', 'POST', { ids: ids });
    var alive = r.results.filter(function(x) { return x.is_alive; }).length;
    toast('测速完成: ' + alive + '/' + r.results.length + ' 存活');
    loadProxies();
  } catch(e) { toast('测速失败'); }
}

function copyShareLink(id) {
  var p = _allProxies.find(function(x) { return x.id === id; });
  if (!p) return;
  var link = p.share_link || (p.protocol + '://' + p.host + ':' + p.port);
  navigator.clipboard.writeText(link).then(function() { toast('链接已复制'); });
}

async function importFromClipboard() {
  try {
    var text = await navigator.clipboard.readText();
    if (!text || !text.trim()) { toast('剪贴板为空'); return; }
    document.getElementById('import-links-text').value = text;
    new bootstrap.Modal(document.getElementById('importLinksModal')).show();
  } catch(e) { toast('无法读取剪贴板，请手动粘贴'); }
}
function onProtocolChange() {
  var proto = document.getElementById('pf-protocol').value;
  document.getElementById('pf-ss-extra').classList.toggle('d-none', proto !== 'shadowsocks');
  document.getElementById('pf-vmess-extra').classList.toggle('d-none', proto !== 'vmess' && proto !== 'vless');
  document.getElementById('pf-vless-extra').classList.toggle('d-none', proto !== 'vless');
  document.getElementById('pf-trojan-extra').classList.toggle('d-none', proto !== 'trojan' && proto !== 'hysteria2');
  var ul = document.getElementById('pf-user-label');
  if (proto === 'vmess' || proto === 'vless' || proto === 'tuic') ul.textContent = 'UUID';
  else ul.textContent = '用户名';
}

function buildExtraConfig() {
  var proto = document.getElementById('pf-protocol').value;
  var cfg = {};
  if (proto === 'shadowsocks') { cfg.method = document.getElementById('pf-ss-method').value; }
  else if (proto === 'vmess') {
    cfg.aid = parseInt(document.getElementById('pf-vmess-aid').value) || 0;
    cfg.net = document.getElementById('pf-vmess-net').value;
    cfg.path = document.getElementById('pf-vmess-path').value;
    cfg.tls = document.getElementById('pf-vmess-tls').value;
  } else if (proto === 'vless') {
    cfg.net = document.getElementById('pf-vmess-net').value;
    cfg.path = document.getElementById('pf-vmess-path').value;
    cfg.tls = document.getElementById('pf-vmess-tls').value;
    cfg.flow = document.getElementById('pf-vless-flow').value;
    cfg.sni = document.getElementById('pf-vless-sni').value;
    cfg.fp = document.getElementById('pf-vless-fp').value;
  } else if (proto === 'trojan' || proto === 'hysteria2') {
    cfg.sni = document.getElementById('pf-trojan-sni').value;
    cfg.alpn = document.getElementById('pf-trojan-alpn').value;
  }
  return JSON.stringify(cfg);
}

function showAddProxyModal() {
  document.getElementById('proxy-edit-id').value = '';
  document.getElementById('proxy-form').reset();
  document.getElementById('addProxyModalTitle').textContent = '🌐 添加代理IP';
  onProtocolChange();
  new bootstrap.Modal(document.getElementById('addProxyModal')).show();
}

async function saveProxy() {
  var form = document.getElementById('proxy-form');
  var data = Object.fromEntries(new FormData(form));
