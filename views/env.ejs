<%- include('partials/header') %>
<div class="main-content">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div><h4 class="mb-0">🛡️ 账号环境管理</h4><small class="text-muted">指纹浏览器 + 代理IP + 接码 + 风控</small></div>
  </div>

  <ul class="nav nav-tabs mb-4" role="tablist">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-profiles">🖥️ 浏览器环境</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-proxies">🌐 代理IP池</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-phones">📱 接码管理</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-vpn">🔐 VPN管理</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-risk">🛡️ 风控监测</a></li>
  </ul>

  <div class="tab-content">
    <!-- 浏览器环境 -->
    <div class="tab-pane fade show active" id="tab-profiles">
      <div class="card">
        <div class="card-header d-flex justify-content-between"><span>浏览器环境 (<%= profiles.length %>)</span><button class="btn btn-sm btn-purple" data-bs-toggle="modal" data-bs-target="#addProfileModal">➕ 新建环境</button></div>
        <div class="card-body p-0">
          <table class="table table-hover mb-0">
            <thead><tr><th>名称</th><th>平台</th><th>代理</th><th>健康度</th><th>状态</th><th>最后使用</th></tr></thead>
            <tbody>
              <% profiles.forEach(p => { %>
              <tr><td><%= p.name %></td><td><%= p.platform %></td><td><%= p.proxy_id||'无' %></td><td><%= p.health_score %>%</td><td><%= p.status %></td><td><small><%= p.last_used||'未使用' %></small></td></tr>
              <% }) %>
              <% if(!profiles.length) { %><tr><td colspan="6" class="text-center text-muted py-3">暂无浏览器环境</td></tr><% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- 代理IP池（NekoBox风格） -->
    <div class="tab-pane fade" id="tab-proxies">
      <!-- 统计卡片 -->
      <div class="row g-3 mb-3">
        <div class="col-6 col-md-3"><div class="card text-center py-2"><div class="card-body p-2"><div class="fs-4 fw-bold" id="stat-total">0</div><small class="text-muted">总节点</small></div></div></div>
        <div class="col-6 col-md-3"><div class="card text-center py-2"><div class="card-body p-2"><div class="fs-4 fw-bold text-success" id="stat-alive">0</div><small class="text-muted">存活</small></div></div></div>
        <div class="col-6 col-md-3"><div class="card text-center py-2"><div class="card-body p-2"><div class="fs-4 fw-bold text-danger" id="stat-dead">0</div><small class="text-muted">超时/离线</small></div></div></div>
        <div class="col-6 col-md-3"><div class="card text-center py-2"><div class="card-body p-2"><div class="fs-4 fw-bold text-info" id="stat-avg-latency">-</div><small class="text-muted">平均延迟</small></div></div></div>
      </div>
      <div class="row g-3">
        <!-- 左侧：分组树 -->
        <div class="col-md-3">
          <div class="card" style="min-height:400px">
            <div class="card-header py-2"><small class="fw-bold">📁 分组 / 订阅</small></div>
            <div class="card-body p-0" id="proxy-group-tree" style="overflow-y:auto;max-height:500px">
              <div class="list-group list-group-flush" id="group-list">
                <a href="#" class="list-group-item list-group-item-action active small py-2" data-group="" onclick="filterByGroup('',this)">📋 全部节点 <span class="badge bg-secondary float-end" id="grp-count-all">0</span></a>
              </div>
            </div>
          </div>
        </div>
        <!-- 右侧：节点列表 -->
        <div class="col-md-9">
          <div class="card">
            <div class="card-header py-2">
              <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex gap-2 align-items-center">
                  <div class="form-check form-check-inline mb-0"><input class="form-check-input" type="checkbox" id="select-all-proxies" onchange="toggleSelectAll(this)"><label class="form-check-label small" for="select-all-proxies">全选</label></div>
                  <select class="form-select form-select-sm" id="proxy-role-filter" style="width:auto" onchange="loadProxies()">
                    <option value="">全部角色</option><option value="frontend">🔰 前置</option><option value="vpn">🔗 VPN</option><option value="landing">🎯 落地</option>
                  </select>
                  <select class="form-select form-select-sm" id="proxy-sort" style="width:auto" onchange="loadProxies()">
                    <option value="default">默认排序</option><option value="latency-asc">延迟 ↑</option><option value="latency-desc">延迟 ↓</option><option value="name">名称 A-Z</option>
                  </select>
                  <input type="text" class="form-control form-control-sm" id="proxy-search" placeholder="搜索..." style="width:130px" oninput="loadProxies()">
                </div>
                <div class="d-flex gap-1 flex-wrap">
                  <button class="btn btn-sm btn-purple" onclick="showAddProxyModal()">➕ 添加</button>
                  <button class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#importLinksModal">📋 粘贴</button>
                  <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#importSubModal">🔗 订阅</button>
                  <button class="btn btn-sm btn-outline-warning" onclick="testAllProxies()">⚡ 全测</button>
                  <button class="btn btn-sm btn-outline-danger d-none" id="batch-delete-btn" onclick="batchDeleteProxies()">🗑️ 批量删除</button>
                  <button class="btn btn-sm btn-outline-success d-none" id="batch-test-btn" onclick="batchTestSelected()">⚡ 批量测速</button>
                </div>
              </div>
            </div>
            <div class="card-body p-0">
              <div class="table-responsive" style="max-height:500px;overflow-y:auto">
                <table class="table table-hover mb-0 table-sm">
                  <thead class="sticky-top" style="background:var(--bs-body-bg,#1a1a2e)"><tr><th style="width:30px"></th><th>角色</th><th>协议</th><th>地址</th><th>国家</th><th>标签</th><th>分组</th><th>延迟</th><th>存活</th><th>操作</th></tr></thead>
                  <tbody id="proxy-table-body">
                    <tr><td colspan="10" class="text-center text-muted py-3">加载中...</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 接码 -->
    <div class="tab-pane fade" id="tab-phones">
      <div class="card">
        <div class="card-header d-flex justify-content-between"><span>接码号码 (<%= phones.length %>)</span><button class="btn btn-sm btn-purple" data-bs-toggle="modal" data-bs-target="#addPhoneModal">➕ 添加号码</button></div>
        <div class="card-body p-0">
          <table class="table table-hover mb-0">
            <thead><tr><th>号码</th><th>国家</th><th>平台</th><th>供应商</th><th>类型</th><th>状态</th></tr></thead>
            <tbody>
              <% phones.forEach(p => { %>
              <tr><td><%= p.number %></td><td><%= p.country %></td><td><%= p.platform %></td><td><%= p.provider %></td><td><%= p.type %></td><td><%= p.status %></td></tr>
              <% }) %>
              <% if(!phones.length) { %><tr><td colspan="6" class="text-center text-muted py-3">暂无号码</td></tr><% } %>
            </tbody>
          </table>
        </div>
      </div>
      
      <!-- eSIM管理区域 -->
      <div class="mt-4">
        <!-- A. 主人号码设置卡片 -->
        <div class="card border-danger mb-4">
          <div class="card-header text-white bg-danger d-flex justify-content-between align-items-center">
            <span>📱 主人号码设置</span>
          </div>
          <div class="card-body">
            <p class="text-danger small mb-3">⚠️ 所有eSIM号码仅能向此号码发送短信（安全硬限制）</p>
            <div class="d-flex gap-2 align-items-center">
              <div class="flex-grow-1">
                <input type="text" class="form-control" id="masterPhoneInput" placeholder="+8613800138000">
              </div>
              <button class="btn btn-purple" onclick="saveMasterPhone()">保存主人号码</button>
            </div>
            <div class="mt-2 text-muted small" id="currentMasterPhone">当前主人号码：<span class="fw-bold">无</span></div>
          </div>
        </div>

        <!-- B. eSIM号码管理卡片 -->
        <div class="card mb-4">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span>📶 eSIM号码管理 (<span id="esimPhoneCount">0</span>)</span>
            <button class="btn btn-sm btn-purple" data-bs-toggle="modal" data-bs-target="#addEsimModal">➕ 添加eSIM号码</button>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead>
                  <tr>
                    <th>号码</th>
                    <th>国家</th>
                    <th>供应商</th>
                    <th>短信启用</th>
                    <th>今日已发</th>
                    <th>操作</th>
                  </tr>
                </thead>
                <tbody id="esimPhoneTable">
                  <tr><td colspan="6" class="text-center text-muted py-3">加载中...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- D. 供应商管理折叠面板 -->
        <div class="card mb-4">
          <div class="card-header d-flex justify-content-between align-items-center" data-bs-toggle="collapse" data-bs-target="#providerCollapse" style="cursor:pointer">
            <span>🏢 供应商管理</span>
            <span>▼</span>
          </div>
          <div class="collapse" id="providerCollapse">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="mb-0">预置供应商</h6>
                <button class="btn btn-sm btn-purple" data-bs-toggle="modal" data-bs-target="#addProviderModal">➕ 添加自定义供应商</button>
              </div>
              <div class="table-responsive">
                <table class="table table-sm">
                  <thead><tr><th>名称</th><th>代码</th><th>支持国家</th><th>官网</th></tr></thead>
                  <tbody id="providerTable">
                    <tr><td colspan="4" class="text-center text-muted py-2">加载中...</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <!-- E. 短信日志折叠面板 -->
        <div class="card">
          <div class="card-header d-flex justify-content-between align-items-center" data-bs-toggle="collapse" data-bs-target="#smsLogCollapse" style="cursor:pointer">
            <span>📨 短信日志（最近50条）</span>
            <span>▼</span>
          </div>
          <div class="collapse" id="smsLogCollapse">
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-hover mb-0">
                  <thead><tr><th>时间</th><th>号码</th><th>方向</th><th>内容</th><th>状态</th></tr></thead>
                  <tbody id="smsLogTable">
                    <tr><td colspan="5" class="text-center text-muted py-2">加载中...</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- eSIM管理区域结束 -->
    </div>

    <!-- VPN / 代理链管理 (NekoBox风格) -->
    <div class="tab-pane fade" id="tab-vpn">
      <div class="row g-3">
        <!-- 左侧：订阅管理 -->
        <div class="col-md-4">
          <div class="card" style="min-height:350px">
            <div class="card-header py-2 d-flex justify-content-between align-items-center">
              <small class="fw-bold">📡 订阅源</small>
              <button class="btn btn-xs btn-purple" data-bs-toggle="modal" data-bs-target="#importSubModal">➕ 添加</button>
            </div>
            <div class="card-body p-0" style="overflow-y:auto;max-height:500px">
              <div id="subscription-cards">
                <div class="text-center text-muted py-3 small">暂无订阅</div>
              </div>
            </div>
          </div>
          <!-- 快捷导入 -->
          <div class="card mt-3">
            <div class="card-header py-2"><small class="fw-bold">⚡ 快捷导入</small></div>
            <div class="card-body py-2">
              <div class="d-grid gap-2">
                <button class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#importLinksModal">📋 粘贴分享链接</button>
                <button class="btn btn-sm btn-outline-secondary" onclick="importFromClipboard()">📎 从剪贴板导入</button>
              </div>
            </div>
          </div>
          <!-- 代理链管理 -->
          <div class="card mt-3">
            <div class="card-header py-2 d-flex justify-content-between align-items-center">
              <small class="fw-bold">🔗 代理链路 <span class="badge bg-secondary" id="chain-count">0</span></small>
              <button class="btn btn-xs btn-purple" onclick="showAddChainModal()">➕ 新建</button>
            </div>
            <div class="card-body p-2" style="overflow-y:auto;max-height:300px">
              <div id="chain-list"><div class="text-center text-muted py-3 small">暂无链路</div></div>
            </div>
          </div>
        </div>
        <!-- 右侧：VPN节点列表（按订阅分组） -->
        <div class="col-md-8">
          <div class="card" style="min-height:350px">
            <div class="card-header py-2 d-flex justify-content-between align-items-center">
              <div class="d-flex align-items-center gap-2">
                <small class="fw-bold">🔗 VPN节点</small>
                <span class="badge bg-secondary" id="vpn-node-count">0</span>
              </div>
              <div class="d-flex gap-1">
                <button class="btn btn-xs btn-outline-success" onclick="batchTestVpnNodes()" title="全部测速">⚡全部测速</button>
                <button class="btn btn-xs btn-outline-secondary vpn-filter-btn active" onclick="filterVpnBySubscription(null,this)">全部</button>
                <span id="vpn-sub-filter-btns"></span>
              </div>
            </div>
            <div class="card-body p-0" style="overflow-y:auto;max-height:600px">
              <div id="vpn-node-list">
                <div class="text-center text-muted py-3 small">加载中...</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 风控 -->
    <div class="tab-pane fade" id="tab-risk">
      <div class="card">
        <div class="card-header">🛡️ 风控监测</div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-md-3"><div class="stat-card text-center"><div class="stat-number text-success"><%= profiles.filter(p=>p.health_score>=80).length %></div><div class="stat-label">健康环境</div></div></div>
            <div class="col-md-3"><div class="stat-card text-center"><div class="stat-number text-warning"><%= profiles.filter(p=>p.health_score>=50&&p.health_score<80).length %></div><div class="stat-label">需关注</div></div></div>
            <div class="col-md-3"><div class="stat-card text-center"><div class="stat-number text-danger"><%= profiles.filter(p=>p.health_score<50).length %></div><div class="stat-label">高风险</div></div></div>
            <div class="col-md-3"><div class="stat-card text-center"><div class="stat-number" id="alive-proxy-stat">-</div><div class="stat-label">存活代理</div></div></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modals -->
<!-- 添加号码弹窗 -->
<div class="modal fade" id="addPhoneModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title">📱 添加号码</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <form id="phone-form">
      <div class="mb-3"><label class="form-label">号码</label><input type="text" class="form-control" name="number" placeholder="+8613800138000" required></div>
      <div class="row mb-3">
        <div class="col-6"><label class="form-label">国家</label><input type="text" class="form-control" name="country" placeholder="CN" value="CN"></div>
        <div class="col-6"><label class="form-label">平台</label><select class="form-select" name="platform"><option value="通用">通用</option><option>TikTok</option><option>Facebook</option><option>WhatsApp</option><option>Instagram</option><option>Twitter</option><option>LinkedIn</option></select></div>
      </div>
      <div class="row mb-3">
        <div class="col-6"><label class="form-label">供应商</label><input type="text" class="form-control" name="provider" placeholder="手动/接码平台名"></div>
        <div class="col-6"><label class="form-label">类型</label><select class="form-select" name="type"><option value="real">实体卡</option><option value="virtual">虚拟号</option><option value="voip">VoIP</option></select></div>
      </div>
    </form>
  </div>
  <div class="modal-footer"><button class="btn btn-purple" onclick="addPhone()">保存</button></div>
</div></div></div>

<div class="modal fade" id="addProfileModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title">🖥️ 新建浏览器环境</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <form id="profile-form">
      <div class="mb-3"><label class="form-label">名称</label><input type="text" class="form-control" name="name" required></div>
      <div class="mb-3"><label class="form-label">平台</label><select class="form-select" name="platform"><option>TikTok</option><option>Facebook</option><option>LinkedIn</option><option>WhatsApp</option><option>通用</option></select></div>
    </form>
  </div>
  <div class="modal-footer"><button class="btn btn-purple" onclick="addProfile()">保存</button></div>
</div></div></div>

<!-- 添加代理弹窗 -->
<div class="modal fade" id="addProxyModal" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title" id="addProxyModalTitle">🌐 添加代理IP</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <form id="proxy-form">
      <input type="hidden" id="proxy-edit-id" value="">
      <div class="row mb-3">
        <div class="col-4"><label class="form-label">角色</label><select class="form-select" name="role" id="pf-role"><option value="landing">🎯 落地代理</option><option value="frontend">🔰 前置代理</option><option value="vpn">🔗 VPN节点</option></select></div>
        <div class="col-4"><label class="form-label">协议</label><select class="form-select" name="protocol" id="pf-protocol" onchange="onProtocolChange()">
          <option value="http">HTTP(S)</option><option value="socks5">SOCKS5</option><option value="socks4">SOCKS4</option>
          <option value="shadowsocks">Shadowsocks</option><option value="vmess">VMess</option><option value="vless">VLESS</option>
          <option value="trojan">Trojan</option><option value="hysteria2">Hysteria2</option><option value="tuic">TUIC</option>
          <option value="wireguard">WireGuard</option>
        </select></div>
        <div class="col-4"><label class="form-label">标签</label><input type="text" class="form-control" name="label" placeholder="如：香港HK-01"></div>
      </div>
      <div class="row mb-3">
        <div class="col-6"><label class="form-label">主机</label><input type="text" class="form-control" name="host" required></div>
        <div class="col-3"><label class="form-label">端口</label><input type="number" class="form-control" name="port" required></div>
        <div class="col-3"><label class="form-label">国家</label><input type="text" class="form-control" name="country"></div>
      </div>
      <div class="row mb-3" id="pf-auth-row">
        <div class="col-6"><label class="form-label" id="pf-user-label">用户名</label><input type="text" class="form-control" name="username"></div>
        <div class="col-6"><label class="form-label">密码</label><input type="text" class="form-control" name="password"></div>
      </div>
      <!-- Shadowsocks -->
      <div class="row mb-3 d-none" id="pf-ss-extra">
        <div class="col-6"><label class="form-label">加密方式</label><select class="form-select" id="pf-ss-method">
          <option>aes-256-gcm</option><option>aes-128-gcm</option><option>chacha20-ietf-poly1305</option><option>2022-blake3-aes-256-gcm</option><option>none</option>
        </select></div>
      </div>
      <!-- VMess/VLESS -->
      <div class="row mb-3 d-none" id="pf-vmess-extra">
        <div class="col-3"><label class="form-label">alterId</label><input type="number" class="form-control" id="pf-vmess-aid" value="0"></div>
        <div class="col-3"><label class="form-label">传输</label><select class="form-select" id="pf-vmess-net"><option>tcp</option><option>ws</option><option>grpc</option><option>h2</option><option>quic</option></select></div>
        <div class="col-3"><label class="form-label">路径</label><input type="text" class="form-control" id="pf-vmess-path" placeholder="/path"></div>
        <div class="col-3"><label class="form-label">TLS</label><select class="form-select" id="pf-vmess-tls"><option value="">无</option><option value="tls">TLS</option><option value="reality">Reality</option></select></div>
      </div>
      <!-- VLESS extra -->
      <div class="row mb-3 d-none" id="pf-vless-extra">
        <div class="col-4"><label class="form-label">Flow</label><input type="text" class="form-control" id="pf-vless-flow" placeholder="xtls-rprx-vision"></div>
        <div class="col-4"><label class="form-label">SNI</label><input type="text" class="form-control" id="pf-vless-sni"></div>
        <div class="col-4"><label class="form-label">Fingerprint</label><input type="text" class="form-control" id="pf-vless-fp" placeholder="chrome"></div>
      </div>
      <!-- Trojan/Hy2 -->
      <div class="row mb-3 d-none" id="pf-trojan-extra">
        <div class="col-6"><label class="form-label">SNI</label><input type="text" class="form-control" id="pf-trojan-sni"></div>
