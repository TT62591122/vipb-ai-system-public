  try {
    const [providers, phones, masterRes] = await Promise.all([
      api('/api/esim/providers'),
      api('/api/esim/phones'),
      api('/api/esim/master-phone')
    ]);
    esimProviders = providers?.providers || [];
    esimPhones = phones?.phones || [];
    // 渲染主人号码
    const mp = masterRes?.masterPhone || '';
    document.getElementById('masterPhoneInput').value = mp;
    document.getElementById('currentMasterPhone').innerHTML = '当前主人号码：<span class="fw-bold">' + (mp || '未设置') + '</span>';
    // 渲染号码表格
    renderEsimPhones();
    // 渲染供应商表格
    renderProviders();
    // 填充供应商下拉
    const sel = document.getElementById('esimProviderSelect');
    sel.innerHTML = '<option value="">请选择...</option>' + esimProviders.map(p => '<option value="' + p.id + '">' + p.name + ' (' + p.code + ')</option>').join('');
  } catch(e) { console.error('加载eSIM数据失败', e); }
}

function renderEsimPhones() {
  const tbody = document.getElementById('esimPhoneTable');
  document.getElementById('esimPhoneCount').textContent = esimPhones.length;
  if (!esimPhones.length) { tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-3">暂无eSIM号码</td></tr>'; return; }
  tbody.innerHTML = esimPhones.map(p => {
    const provName = p.provider_name || '未知';
    const smsOn = p.sms_enabled ? '<span class="badge bg-success">已启用</span>' : '<span class="badge bg-secondary">未启用</span>';
    return '<tr><td>' + (p.number||'') + '</td><td>' + (p.country||'') + '</td><td>' + provName + '</td><td>' + smsOn + '</td><td>' + (p.sms_today||0) + '/20</td><td>' +
      '<button class="btn btn-xs btn-outline-success me-1" onclick="testSms(' + p.id + ')" title="测试发送">📤</button>' +
      '<button class="btn btn-xs btn-outline-danger" onclick="deleteEsimPhone(' + p.id + ')" title="删除">🗑️</button></td></tr>';
  }).join('');
}

function renderProviders() {
  const tbody = document.getElementById('providerTable');
  if (!esimProviders.length) { tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-2">暂无供应商</td></tr>'; return; }
  tbody.innerHTML = esimProviders.map(p => {
    let countries = '[]';
    try { countries = JSON.parse(p.countries || '[]').join(', '); } catch(e) { countries = p.countries || ''; }
    const link = p.website ? '<a href="' + p.website + '" target="_blank">🔗</a>' : '-';
    return '<tr><td>' + p.name + '</td><td><code>' + p.code + '</code></td><td class="small">' + countries + '</td><td>' + link + '</td></tr>';
  }).join('');
}

async function saveMasterPhone() {
  const phone = document.getElementById('masterPhoneInput').value.trim();
  if (!phone) { toast('请输入主人号码', 'warning'); return; }
  try {
    const res = await api('/api/esim/master-phone', 'PUT', { phone });
    if (res.success) {
      toast('主人号码已保存');
      loadEsimData();
    } else {
      toast('保存失败: ' + (res.error || '未知错误'), 'danger');
    }
  } catch(e) { toast('保存失败: ' + (e.message||e), 'danger'); }
}

function renderProviderFields(providerId) {
  const container = document.getElementById('providerFieldsContainer');
  if (!providerId) { container.innerHTML = ''; return; }
  const prov = esimProviders.find(p => p.id == providerId);
  if (!prov) { container.innerHTML = ''; return; }
  let fields = [];
  try { fields = JSON.parse(prov.config_fields || '[]'); } catch(e) {}
  if (!fields.length) { container.innerHTML = '<p class="text-muted small">该供应商无需额外配置</p>'; return; }
  container.innerHTML = '<label class="form-label fw-bold">供应商凭证</label>' + fields.map(f =>
    '<div class="mb-2"><label class="form-label small">' + (f.label||f.key) + '</label>' +
    '<input type="' + (f.type||'text') + '" class="form-control form-control-sm" name="cred_' + f.key + '" placeholder="' + (f.label||f.key) + '"></div>'
  ).join('');
}

async function addEsimPhone() {
  const form = document.getElementById('esimManualForm');
  const providerId = form.querySelector('[id="esimProviderSelect"]').value;
  const number = form.querySelector('[name="number"]').value.trim();
  const country = form.querySelector('[name="country"]').value.trim();
  const notes = form.querySelector('[name="notes"]').value.trim();
  if (!providerId || !number) { toast('请填写供应商和号码', 'warning'); return; }
  // 收集凭证
  const creds = {};
  form.querySelectorAll('[name^="cred_"]').forEach(el => { creds[el.name.replace('cred_','')] = el.value; });
  try {
    await api('/api/esim/phones', 'POST', { provider_id: parseInt(providerId), number, country, notes, credentials: creds, sms_enabled: 1 });
    toast('eSIM号码已添加');
    bootstrap.Modal.getInstance(document.getElementById('addEsimModal'))?.hide();
    loadEsimData();
  } catch(e) { toast('添加失败: ' + (e.message||e), 'danger'); }
}

async function deleteEsimPhone(id) {
  if (!confirm('确定删除此eSIM号码？')) return;
  try {
    await api('/api/esim/phones/' + id, 'DELETE');
    toast('已删除');
    loadEsimData();
  } catch(e) { toast('删除失败: ' + (e.message||e), 'danger'); }
}

async function testSms(id) {
  const content = prompt('输入测试短信内容：', '这是一条测试短信');
  if (!content) return;
  try {
    const res = await api('/api/esim/phones/' + id + '/test', 'POST', { content });
    toast(res.message || '测试短信已发送');
  } catch(e) { toast('发送失败: ' + (e.message||e), 'danger'); }
}

async function validateEsimCredentials() {
  const form = document.getElementById('esimManualForm');
  const providerId = form.querySelector('[id="esimProviderSelect"]').value;
  if (!providerId) { toast('请先选择供应商', 'warning'); return; }
  const creds = {};
  form.querySelectorAll('[name^="cred_"]').forEach(el => { creds[el.name.replace('cred_','')] = el.value; });
  try {
    const res = await api('/api/esim/phones/0/validate', 'POST', { provider_id: parseInt(providerId), credentials: creds });
    toast(res.valid ? '✅ 凭证验证通过' : '❌ 凭证无效: ' + (res.error||''), res.valid ? 'success' : 'danger');
  } catch(e) { toast('验证失败: ' + (e.message||e), 'danger'); }
}

async function loadSmsLogs() {
  try {
    const logs = await api('/api/esim/logs?limit=50');
    const tbody = document.getElementById('smsLogTable');
    if (!logs || !logs.length) { tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-2">暂无日志</td></tr>'; return; }
    tbody.innerHTML = logs.map(l => {
      const dir = l.direction === 'out' ? '<span class="badge bg-primary">出</span>' : '<span class="badge bg-info">入</span>';
      const st = l.status === 'sent' ? '<span class="badge bg-success">已发送</span>' : l.status === 'blocked' ? '<span class="badge bg-danger">已拦截</span>' : '<span class="badge bg-secondary">' + (l.status||'') + '</span>';
      return '<tr><td class="small">' + (l.created_at||'') + '</td><td>' + (l.from_number||'') + '</td><td>' + dir + '</td><td class="small text-truncate" style="max-width:200px">' + (l.content||'') + '</td><td>' + st + '</td></tr>';
    }).join('');
  } catch(e) { console.error('加载日志失败', e); }
}

// 二维码解码
async function handleQrFileSelect(files) {
  if (!files || !files[0]) return;
  try {
    const data = await decodeQR(files[0]);
    document.getElementById('qrLpaContent').textContent = data;
    document.getElementById('qrDecodeResult').classList.remove('d-none');
  } catch(e) { toast('二维码识别失败: ' + e.message, 'danger'); }
}

function decodeQR(file) {
  return new Promise((resolve, reject) => {
    const img = new Image();
    img.onload = () => {
      const canvas = document.createElement('canvas');
      canvas.width = img.width; canvas.height = img.height;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(img, 0, 0);
      const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
      if (typeof jsQR === 'undefined') { reject(new Error('jsQR库未加载')); return; }
      const code = jsQR(imageData.data, imageData.width, imageData.height);
      if (code) resolve(code.data);
      else reject(new Error('无法识别二维码'));
    };
    img.onerror = () => reject(new Error('图片加载失败'));
    img.src = URL.createObjectURL(file);
  });
}

async function useQrDecodeResult() {
  const lpa = document.getElementById('qrLpaContent').textContent.trim();
  if (!lpa) { toast('未检测到LPA信息', 'warning'); return; }
  
  try {
    // 调后端解析LPA结构
    const resp = await fetch('/api/esim/phones/parse-qr', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ lpaString: lpa })
    });
    const data = await resp.json();
    if (!data.success) { toast(data.error || '解析失败', 'danger'); return; }
    
    // 切换到手动输入tab
    const manualTab = document.querySelector('[href="#esim-manual-tab"]');
    if (manualTab) new bootstrap.Tab(manualTab).show();
    
    // 自动选择推荐的供应商
    if (data.data.suggested_provider) {
      const sel = document.getElementById('esimProviderSelect');
      if (sel) { sel.value = data.data.suggested_provider.id; sel.dispatchEvent(new Event('change')); }
    }
    
    toast('✅ LPA解析成功: ' + data.data.activation_server, 'success');
  } catch (e) {
    toast('解析请求失败: ' + e.message, 'danger');
  }
}

// 拖拽上传
document.addEventListener('DOMContentLoaded', function() {
  const area = document.getElementById('qrUploadArea');
  if (area) {
    area.addEventListener('dragover', e => { e.preventDefault(); area.style.borderColor = '#663399'; });
    area.addEventListener('dragleave', () => { area.style.borderColor = ''; });
    area.addEventListener('drop', e => { e.preventDefault(); area.style.borderColor = ''; handleQrFileSelect(e.dataTransfer.files); });
  }
});

// CSV批量导入
function handleCsvFileSelect(files) {
  if (!files || !files[0]) return;
  const reader = new FileReader();
  reader.onload = e => {
    csvParsedRows = parseCSV(e.target.result);
    if (!csvParsedRows.length) { toast('CSV为空或格式错误', 'warning'); return; }
    document.getElementById('csvPreviewContainer').classList.remove('d-none');
    document.getElementById('csvRowCount').textContent = csvParsedRows.length;
    document.getElementById('csvPreviewTable').innerHTML = csvParsedRows.slice(0, 20).map(r =>
      '<tr><td>' + (r.number||'') + '</td><td>' + (r.country||'') + '</td><td>' + (r.provider_code||'') + '</td><td>' + (r.notes||'') + '</td></tr>'
    ).join('');
  };
  reader.readAsText(files[0]);
}

function parseCSV(text) {
  const lines = text.trim().split('\n').filter(l => l.trim());
  if (lines.length < 2) return lines.length === 1 ? parseCsvLine(lines[0]) : [];
  // 跳过表头
  const first = lines[0].toLowerCase();
  const start = (first.includes('号码') || first.includes('number') || first.includes('phone')) ? 1 : 0;
  return lines.slice(start).map(line => {
    const cols = line.split(',').map(c => c.trim().replace(/^["']|["']$/g, ''));
    return { number: cols[0]||'', country: cols[1]||'', provider_code: cols[2]||'', notes: cols[3]||'' };
  }).filter(r => r.number);
}

function parseCsvLine(line) {
  const cols = line.split(',').map(c => c.trim());
  if (cols[0] && /^\+?\d/.test(cols[0])) return [{ number: cols[0], country: cols[1]||'', provider_code: cols[2]||'', notes: cols[3]||'' }];
  return [];
}

async function batchImport() {
  if (!csvParsedRows.length) { toast('没有可导入的数据', 'warning'); return; }
  try {
    const res = await api('/api/esim/phones/batch-import', 'POST', { phones: csvParsedRows });
    toast('成功导入 ' + (res.imported||csvParsedRows.length) + ' 个号码');
    bootstrap.Modal.getInstance(document.getElementById('addEsimModal'))?.hide();
    csvParsedRows = [];
    loadEsimData();
  } catch(e) { toast('导入失败: ' + (e.message||e), 'danger'); }
}

async function saveCustomProvider() {
  const form = document.getElementById('providerForm');
  const data = {
    name: form.querySelector('[name="name"]').value.trim(),
    code: form.querySelector('[name="code"]').value.trim(),
    countries: form.querySelector('[name="countries"]').value.trim(),
    website: form.querySelector('[name="website"]').value.trim(),
    config_fields: form.querySelector('[name="config_fields"]').value.trim()
  };
  if (!data.name || !data.code) { toast('名称和代码必填', 'warning'); return; }
  // 转换countries为JSON数组
  if (data.countries && !data.countries.startsWith('[')) {
    data.countries = JSON.stringify(data.countries.split(',').map(c => c.trim()));
  }
  try {
    await api('/api/esim/providers', 'POST', data);
    toast('供应商已添加');
    bootstrap.Modal.getInstance(document.getElementById('addProviderModal'))?.hide();
    form.reset();
    loadEsimData();
  } catch(e) { toast('添加失败: ' + (e.message||e), 'danger'); }
}

