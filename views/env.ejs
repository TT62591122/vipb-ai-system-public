  document.querySelector('[href="#tab-phones"]')?.addEventListener('shown.bs.tab', function() { loadEsimData(); });
  // 短信日志折叠展开时加载
  document.getElementById('smsLogCollapse')?.addEventListener('shown.bs.collapse', function() { loadSmsLogs(); });
  // 首次如果已在phones tab则加载
  if (document.getElementById('tab-phones')?.classList.contains('active')) loadEsimData();
});
</script>
