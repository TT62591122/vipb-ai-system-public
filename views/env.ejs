document.addEventListener('DOMContentLoaded', function() {
  // 代理IP池tab被点击时加载
  document.querySelector('[href="#tab-proxies"]')?.addEventListener('shown.bs.tab', function() { loadProxies(); });
  // VPN管理tab
  document.querySelector('[href="#tab-vpn"]')?.addEventListener('shown.bs.tab', function() { loadChains(); loadSubscriptions(); loadVpnNodes(); });
