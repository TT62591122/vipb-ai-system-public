    if (c.landing_proxy_id) steps.push('<span class="badge bg-warning text-dark">🎯 ' + (c.lp_label||c.lp_protocol||'落地') + '</span><small class="text-muted d-block" style="font-size:10px">' + (c.lp_host||'')+':'+(c.lp_port||'') + '</small>');
    if (!steps.length) steps.push('<span class="text-muted small">未配置节点</span>');
    var chainVisual = '<div class="d-flex align-items-center gap-1 flex-wrap">' +
      '<span class="badge bg-dark">🖥️ 本机</span><span class="text-muted">→</span>' +
      steps.join('<span class="text-muted">→</span>') +
      '<span class="text-muted">→</span><span class="badge bg-dark">🌍 目标</span></div>';
    return '<div class="card mb-2 shadow-sm" style="border-radius:8px;border-left:3px solid var(--bs-info)"><div class="card-body py-2 px-3">' +
      '<div class="d-flex justify-content-between align-items-start mb-2">' +
      '<strong class="small">🔗 ' + (c.name || '未命名') + '</strong>' +
      '<div><button class="btn btn-xs btn-outline-primary" onclick="editChain('+c.id+')">✏️</button> ' +
      '<button class="btn btn-xs btn-outline-danger" onclick="deleteChain('+c.id+')">🗑️</button></div></div>' +
      chainVisual +
      (c.notes ? '<div class="text-muted small mt-1">📝 '+c.notes+'</div>' : '') +
      '</div></div>';
  }).join('');
}

async function _loadChainProxies() {
  if (!_chainProxies) _chainProxies = await api('/api/env/proxies');
  var subs = [];
  try { subs = await api('/api/env/subscriptions'); } catch(e) {}
  var subMap = {};
  subs.forEach(function(s) { subMap[s.id] = s.name || ('订阅#'+s.id); });

  var fe = document.getElementById('chain-frontend');
  var vp = document.getElementById('chain-vpn');
  var lp = document.getElementById('chain-landing');
  fe.innerHTML = '<option value="">不使用</option>';
  vp.innerHTML = '<option value="">不使用</option>';
  lp.innerHTML = '<option value="">不使用</option>';

  // VPN节点按订阅源分组
  var vpnByGroup = {};
  _chainProxies.forEach(function(p) {
    var txt = (p.label||p.type) + ' | ' + (p.protocol||'http') + ' | ' + p.host + ':' + p.port + ' | ' + (p.country||'-');
    if (p.role === 'frontend') fe.insertAdjacentHTML('beforeend', '<option value="'+p.id+'">'+txt+'</option>');
    if (p.role === 'vpn') {
      var gName = p.subscription_id ? (subMap[p.subscription_id] || '订阅#'+p.subscription_id) : '手动添加';
      if (!vpnByGroup[gName]) vpnByGroup[gName] = [];
      vpnByGroup[gName].push('<option value="'+p.id+'">'+txt+'</option>');
    }
    if (p.role === 'landing' || !p.role) lp.insertAdjacentHTML('beforeend', '<option value="'+p.id+'">'+txt+'</option>');
  });
  // 按机场分组插入optgroup
  Object.keys(vpnByGroup).forEach(function(gName) {
    vp.insertAdjacentHTML('beforeend', '<optgroup label="✈️ '+gName+' ('+vpnByGroup[gName].length+'个)">'+vpnByGroup[gName].join('')+'</optgroup>');
  });
}

