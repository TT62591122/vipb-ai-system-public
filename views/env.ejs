var _vpnNodes = [];

function filterVpnBySubscription(subId, btn) {
  _vpnFilterSubId = subId;
  // Update active state on filter buttons
  document.querySelectorAll('.vpn-filter-btn').forEach(function(b){b.classList.remove('active');});
  if (btn) btn.classList.add('active');
  else {
    // Find correct button
    document.querySelectorAll('.vpn-filter-btn').forEach(function(b){
      if (subId === null && b.textContent.includes('全部')) b.classList.add('active');
    });
  }
  // Highlight sub card
  document.querySelectorAll('.vpn-sub-card').forEach(function(c){c.classList.remove('border-primary');});
  renderVpnNodes();
}

async function loadVpnNodes() {
  try { _vpnNodes = (await api('/api/env/proxies')).filter(function(p){return p.role==='vpn';}); } catch(e) { _vpnNodes = []; }
  renderVpnNodes();
}

function renderVpnNodes() {
  var el = document.getElementById('vpn-node-list');
  var nodes = _vpnNodes;
  var filtered = _vpnFilterSubId ? nodes.filter(function(n){return n.subscription_id === _vpnFilterSubId;}) : nodes;
  document.getElementById('vpn-node-count').textContent = filtered.length;

  if (!filtered.length) { el.innerHTML = '<div class="text-center text-muted py-3 small">暂无VPN节点</div>'; return; }

  // Group by subscription
  var groups = {};
  var subNames = {};
  _subscriptions.forEach(function(s){subNames[s.id]=s.name||'未命名';});
  filtered.forEach(function(n) {
    var gid = n.subscription_id || 0;
    var gname = gid ? (subNames[gid] || '订阅#'+gid) : '手动添加';
    if (!groups[gid]) groups[gid] = { name: gname, nodes: [] };
    groups[gid].nodes.push(n);
  });

  var html = '';
  Object.keys(groups).forEach(function(gid) {
    var g = groups[gid];
    html += '<div class="vpn-group">' +
      '<div class="vpn-group-header px-3 py-1 d-flex justify-content-between align-items-center" onclick="this.parentElement.classList.toggle(\'collapsed\')" style="cursor:pointer;background:rgba(255,255,255,0.05);border-bottom:1px solid rgba(255,255,255,0.1)">' +
      '<small class="fw-bold">📁 '+g.name+' <span class="badge bg-secondary">'+g.nodes.length+'</span></small>' +
      '<small class="text-muted vpn-collapse-icon">▼</small></div>' +
      '<div class="vpn-group-body"><table class="table table-hover table-sm mb-0"><thead><tr><th>协议</th><th>地址</th><th>国家</th><th>标签</th><th>订阅</th><th>延迟</th><th>状态</th><th>操作</th></tr></thead><tbody>';
    g.nodes.forEach(function(p) {
      var lh = '<span class="text-muted">未测</span>';
      if (p.latency_ms != null) {
        if (p.latency_ms < 0) lh = '<span class="badge bg-danger">超时</span>';
        else if (p.latency_ms < 100) lh = '<span class="badge bg-success">'+p.latency_ms+'ms</span>';
        else if (p.latency_ms < 300) lh = '<span class="badge bg-warning text-dark">'+p.latency_ms+'ms</span>';
        else lh = '<span class="badge bg-danger">'+p.latency_ms+'ms</span>';
      }
      html += '<tr><td><span class="badge bg-secondary">'+(p.protocol||'http')+'</span></td>' +
        '<td><small>'+p.host+':'+p.port+'</small></td>' +
        '<td>'+(p.country ? flagEmoji(p.country)+' '+p.country : '-')+'</td>' +
        '<td><small>'+(p.label||'-')+'</small></td>' +
        '<td><small>'+(subNames[p.subscription_id]||'-')+'</small></td>' +
        '<td>'+lh+'</td>' +
        '<td>'+(p.is_alive ? '🟢' : (p.latency_ms !== null ? '🔴' : '⚪'))+'</td>' +
        '<td><button class="btn btn-outline-info btn-sm py-0 px-1" onclick="testVpnNode('+p.id+',this)" title="测延迟">⚡</button></td></tr>';
    });
    html += '</tbody></table></div></div>';
  });
  el.innerHTML = html;
}

