<%- include('partials/header') %>
<div class="main-content">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div><h4 class="mb-0">💰 交易中心</h4><small class="text-muted">报价 → 订单 → 发货 → 收款 (看板视图)</small></div>
    <button class="btn btn-purple" data-bs-toggle="modal" data-bs-target="#addDealModal">➕ 新建交易</button>
  </div>

  <!-- 搜索和筛选栏 -->
  <div class="row g-2 mb-3">
    <div class="col-md-4">
      <input type="text" class="form-control" id="search-deals" placeholder="🔍 搜索交易（标题/公司）" oninput="filterDeals()">
    </div>
    <div class="col-md-2">
      <input type="number" class="form-control" id="filter-amount-min" placeholder="最低金额" oninput="filterDeals()">
    </div>
    <div class="col-md-2">
      <input type="number" class="form-control" id="filter-amount-max" placeholder="最高金额" oninput="filterDeals()">
    </div>
    <div class="col-md-2">
      <button class="btn btn-outline-secondary w-100" onclick="clearDealFilters()">🔄 清除筛选</button>
    </div>
    <div class="col-md-2">
      <span id="deal-filter-count" class="text-muted small"></span>
    </div>
  </div>

  <% const stageLabels = { ai_pending:'🔍待审核', inquiry:'📋询盘', quote:'💲报价', negotiation:'🤝谈判', pi_confirmed:'✅PI确认', production:'🏭生产', inspection:'🔍验货', shipping:'🚢发货', payment:'💳收款', completed:'✅完成' }; %>

  <div class="kanban-board">
    <% stages.forEach(s => { %>
    <div class="kanban-column" data-stage="<%= s %>">
      <h6><%= stageLabels[s]||s %> (<%= (deals[s]||[]).length %>)</h6>
      <% (deals[s]||[]).forEach(d => { %>
      <div class="kanban-card" draggable="true" data-id="<%= d.id %>" data-amount="<%= d.amount||0 %>" data-company="<%= (d.company||'').toLowerCase() %>" data-title="<%= (d.title||'').toLowerCase() %>" onclick="showDealDetail(<%= d.id %>)" style="cursor:pointer">
        <% if (d.stage === 'ai_pending') { %>
        <div class="badge bg-warning mb-1">🤖 AI生成 - 待审核</div>
        <% } %>
        <strong><%= d.title||d.company||'未命名' %></strong>
        <div class="d-flex justify-content-between mt-1">
          <small class="text-muted"><%= d.company||'' %></small>
          <small class="fw-bold text-success">$<%= (d.amount||0).toLocaleString() %></small>
        </div>
        <% if (d.ai_generated) { %>
        <small class="text-muted">🤖 AI建议</small>
        <% } %>
      </div>
      <% }) %>
    </div>
    <% }) %>
  </div>
</div>

<!-- 新建交易Modal -->
<div class="modal fade" id="addDealModal" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">➕ 新建交易</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
      <form id="deal-form">
        <div class="mb-3"><label class="form-label">标题 <span class="text-danger">*</span></label><input type="text" class="form-control" name="title" required placeholder="例如：智能电表500台出口订单"></div>
        <div class="mb-3"><label class="form-label">客户</label>
          <select class="form-select" name="customer_id">
            <option value="">-- 选择客户 --</option>
            <% (customers||[]).forEach(c => { %>
            <option value="<%= c.id %>"><%= c.company||c.contact_name %> (ID:<%= c.id %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="mb-3"><label class="form-label">金额(USD)</label><input type="number" class="form-control" name="amount" step="0.01" placeholder="例如：50000"></div>
        <div class="mb-3"><label class="form-label">阶段</label><select class="form-select" name="stage"><% stages.forEach(s => { %><option value="<%= s %>"><%= stageLabels[s]||s %></option><% }) %></select></div>
        <div class="mb-3"><label class="form-label">产品</label><input type="text" class="form-control" name="products" placeholder="Smart Meter x 500"></div>
        <div class="mb-3"><label class="form-label">备注</label><textarea class="form-control" name="notes" rows="2"></textarea></div>
      </form>
    </div>
    <div class="modal-footer"><button class="btn btn-purple" onclick="addDeal()">保存</button></div>
  </div></div>
</div>

<!-- 交易详情Modal -->
<div class="modal fade" id="dealDetailModal" tabindex="-1">
  <div class="modal-dialog modal-lg"><div class="modal-content">
    <div class="modal-header">
      <h5 class="modal-title" id="detail-title">交易详情</h5>
      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body" id="deal-detail-body">
      <div class="text-center"><div class="spinner-border"></div></div>
    </div>
    <div class="modal-footer" id="deal-detail-footer">
      <button class="btn btn-danger" id="btn-delete-deal" onclick="deleteDeal()">🗑️ 删除</button>
      <button class="btn btn-success" id="btn-approve-deal" onclick="approveDeal()" style="display:none">✅ 审核通过</button>
      <button class="btn btn-warning" id="btn-reject-deal" onclick="rejectDeal()" style="display:none">❌ 驳回</button>
      <button class="btn btn-purple" id="btn-edit-deal" onclick="showEditDeal()">✏️ 编辑</button>
    </div>
  </div></div>
</div>

<!-- 编辑交易Modal -->
<div class="modal fade" id="editDealModal" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">✏️ 编辑交易</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
      <form id="edit-deal-form">
        <input type="hidden" name="id" id="edit-deal-id">
        <div class="mb-3"><label class="form-label">标题</label><input type="text" class="form-control" name="title" id="edit-title" required></div>
        <div class="mb-3"><label class="form-label">金额(USD)</label><input type="number" class="form-control" name="amount" id="edit-amount" step="0.01"></div>
        <div class="mb-3"><label class="form-label">阶段</label><select class="form-select" name="stage" id="edit-stage"><% stages.forEach(s => { %><option value="<%= s %>"><%= stageLabels[s]||s %></option><% }) %></select></div>
        <div class="mb-3"><label class="form-label">备注</label><textarea class="form-control" name="notes" id="edit-notes" rows="2"></textarea></div>
      </form>
    </div>
    <div class="modal-footer"><button class="btn btn-purple" onclick="saveDealEdit()">💾 保存</button></div>
  </div></div>
</div>

<!-- AI助手 -->
<div class="card mt-3 mx-3">
  <div class="card-header">🤖 AI助手 — 交易分析</div>
  <div class="card-body">
    <div class="input-group">
      <input type="text" class="form-control" id="ai-input" placeholder="分析客户信用、市场情报、报价策略...">
      <button class="btn btn-purple" onclick="aiChat('sales')">🧑‍💼 销售</button>
      <button class="btn btn-outline-success" onclick="aiChat('research')">🔍 调研</button>
      <button class="btn btn-outline-danger" onclick="aiChat('risk')">🛡️ 风控</button>
    </div>
    <div id="ai-output" class="mt-3"></div>
  </div>
</div>

<script>
let currentDealId = null;

// ========== 搜索和筛选 ==========
function filterDeals() {
  const search = document.getElementById('search-deals').value.toLowerCase();
  const minAmount = parseFloat(document.getElementById('filter-amount-min').value) || 0;
  const maxAmount = parseFloat(document.getElementById('filter-amount-max').value) || Infinity;
  let visible = 0, total = 0;
  
  document.querySelectorAll('.kanban-card[data-id]').forEach(card => {
    total++;
    const title = card.dataset.title || '';
    const company = card.dataset.company || '';
    const amount = parseFloat(card.dataset.amount) || 0;
    
    const matchSearch = !search || title.includes(search) || company.includes(search);
    const matchAmount = amount >= minAmount && amount <= maxAmount;
    
    if (matchSearch && matchAmount) {
      card.style.opacity = '1';
      card.style.transform = '';
      visible++;
    } else {
      card.style.opacity = '0.2';
      card.style.transform = 'scale(0.95)';
    }
  });
  
  const info = document.getElementById('deal-filter-count');
  if (search || minAmount > 0 || maxAmount < Infinity) {
    info.textContent = `匹配 ${visible}/${total} 笔交易`;
  } else {
    info.textContent = '';
  }
}

function clearDealFilters() {
  document.getElementById('search-deals').value = '';
  document.getElementById('filter-amount-min').value = '';
  document.getElementById('filter-amount-max').value = '';
  document.querySelectorAll('.kanban-card[data-id]').forEach(card => {
    card.style.opacity = '1';
    card.style.transform = '';
  });
  document.getElementById('deal-filter-count').textContent = '';
}

async function addDeal() {
  const form = document.getElementById('deal-form');
  const data = Object.fromEntries(new FormData(form));
  data.amount = parseFloat(data.amount) || 0;
  data.customer_id = parseInt(data.customer_id) || null;
  if (data.products) data.products = [data.products];
  const res = await api('/api/trade/deals', 'POST', data);
  if (res.success) { toast('交易已创建'); location.reload(); }
}

async function showDealDetail(id) {
  currentDealId = id;
  const modal = new bootstrap.Modal(document.getElementById('dealDetailModal'));
  const body = document.getElementById('deal-detail-body');
  body.innerHTML = '<div class="text-center"><div class="spinner-border"></div></div>';
  modal.show();

  const deals = await api('/api/trade/deals');
  const d = deals.find(x => x.id === id);
  if (!d) { body.innerHTML = '<div class="alert alert-danger">交易不存在</div>'; return; }

  const stageLabels = { ai_pending:'🔍待审核', inquiry:'📋询盘', quote:'💲报价', negotiation:'🤝谈判', pi_confirmed:'✅PI确认', production:'🏭生产', inspection:'🔍验货', shipping:'🚢发货', payment:'💳收款', completed:'✅完成' };

  let products = '无';
  try { const p = JSON.parse(d.products || '[]'); if (p.length) products = p.join(', '); } catch(e) { products = d.products || '无'; }

  // 显示/隐藏审核按钮
  const btnApprove = document.getElementById('btn-approve-deal');
  const btnReject = document.getElementById('btn-reject-deal');
  if (d.stage === 'ai_pending') {
    btnApprove.style.display = 'inline-block';
    btnReject.style.display = 'inline-block';
  } else {
    btnApprove.style.display = 'none';
    btnReject.style.display = 'none';
  }

  let aiWarning = '';
  if (d.stage === 'ai_pending') {
    aiWarning = `
      <div class="alert alert-warning">
        <strong>⚠️ 此交易由AI生成，需要人工审核确认</strong><br>
        <small>AI分析: ${d.ai_analysis || '无'}</small>
      </div>
    `;
  }

  body.innerHTML = `
    ${aiWarning}
    <div class="row">
      <div class="col-md-6">
        <h5>${d.title || '未命名'}</h5>
        <p><strong>客户:</strong> ${d.company || '-'}</p>
        <p><strong>金额:</strong> <span class="text-success fw-bold">$${(d.amount||0).toLocaleString()}</span> ${d.currency||'USD'}</p>
        <p><strong>阶段:</strong> <span class="badge bg-primary">${stageLabels[d.stage]||d.stage}</span></p>
      </div>
      <div class="col-md-6">
        <p><strong>产品:</strong> ${products}</p>
        <p><strong>PI号:</strong> ${d.pi_number || '-'}</p>
        <p><strong>备注:</strong> ${d.notes || '-'}</p>
        <p><strong>创建时间:</strong> ${d.created_at || '-'}</p>
        <p><strong>更新时间:</strong> ${d.updated_at || '-'}</p>
      </div>
    </div>
    ${d.ai_generated ? '<p class="text-muted mt-2"><small>🤖 此交易由AI生成</small></p>' : ''}
  `;
}

async function deleteDeal() {
  if (!currentDealId || !confirm('确定删除此交易？')) return;
  const res = await api(`/api/trade/deals/${currentDealId}`, 'DELETE');
  if (res.success) { toast('交易已删除'); location.reload(); }
}

function showEditDeal() {
  bootstrap.Modal.getInstance(document.getElementById('dealDetailModal'))?.hide();
  // Fetch deal data and populate edit form
  api('/api/trade/deals').then(deals => {
    const d = deals.find(x => x.id === currentDealId);
    if (!d) return;
    document.getElementById('edit-deal-id').value = d.id;
    document.getElementById('edit-title').value = d.title || '';
    document.getElementById('edit-amount').value = d.amount || '';
    document.getElementById('edit-stage').value = d.stage || 'inquiry';
    document.getElementById('edit-notes').value = d.notes || '';
    new bootstrap.Modal(document.getElementById('editDealModal')).show();
  });
}

async function saveDealEdit() {
  const form = document.getElementById('edit-deal-form');
  const data = Object.fromEntries(new FormData(form));
  const id = data.id; delete data.id;
  data.amount = parseFloat(data.amount) || 0;
  const res = await api(`/api/trade/deals/${id}`, 'PUT', data);
  if (res.success) { toast('交易已更新'); location.reload(); }
}

async function approveDeal() {
  if (!currentDealId || !confirm('确认审核通过此交易？')) return;
  const res = await api(`/api/trade/deals/${currentDealId}/approve`, 'POST');
  if (res.success) { 
    toast('✅ 交易已审核通过'); 
    location.reload(); 
  } else {
    toast(res.error || '审核失败', 'danger');
  }
}

async function rejectDeal() {
  const reason = prompt('请输入驳回原因：');
  if (!reason) return;
  if (!currentDealId) return;
  const res = await api(`/api/trade/deals/${currentDealId}/reject`, 'POST', { reason });
  if (res.success) { 
    toast('❌ 交易已驳回'); 
    location.reload(); 
  } else {
    toast(res.error || '驳回失败', 'danger');
  }
}

// ========== AI助手对话（复用CRM同款） ==========
function aiChat(role) {
  var roleNames = { sales: '销售顾问', research: '市场调研', risk: '风控专家' };
  var roleName = roleNames[role] || role;
  var modal = document.getElementById('aiChatModal');
  if (!modal) {
    modal = document.createElement('div');
    modal.id = 'aiChatModal';
    modal.className = 'modal fade';
    modal.tabIndex = -1;
    modal.innerHTML = '<div class="modal-dialog modal-lg"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="aiChatTitle">🤖 AI助手</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div><div class="modal-body"><div id="aiChatHistory" style="height:300px;overflow-y:auto;background:#1a1a2e;border-radius:8px;padding:12px;margin-bottom:12px;font-size:14px"></div><div class="input-group"><input type="text" class="form-control" id="aiChatInput" placeholder="输入问题..."><button class="btn btn-purple" onclick="sendAiChat()">发送</button></div></div></div></div>';
    document.body.appendChild(modal);
    document.getElementById('aiChatInput').addEventListener('keydown', function(e) { if (e.key === 'Enter') sendAiChat(); });
  }
  document.getElementById('aiChatTitle').textContent = '🤖 ' + roleName;
  document.getElementById('aiChatHistory').innerHTML = '<div class="text-muted text-center small py-3">你好，我是' + roleName + '助手，请问有什么可以帮您？</div>';
  document.getElementById('aiChatModal').dataset.role = role;
  new bootstrap.Modal(modal).show();
  setTimeout(function() { document.getElementById('aiChatInput').focus(); }, 300);
}

async function sendAiChat() {
  var input = document.getElementById('aiChatInput');
  var msg = input.value.trim();
  if (!msg) return;
  input.value = '';
  var history = document.getElementById('aiChatHistory');
  var role = document.getElementById('aiChatModal').dataset.role;
  history.innerHTML += '<div class="mb-2"><span class="badge bg-primary">你</span> ' + msg + '</div>';
  history.innerHTML += '<div class="mb-2 text-muted" id="ai-typing"><span class="badge bg-secondary">AI</span> 思考中...</div>';
  history.scrollTop = history.scrollHeight;
  try {
    var res = await api('/api/ai/chat', 'POST', { message: msg, context: role });
    var typing = document.getElementById('ai-typing');
    if (typing) typing.remove();
    var reply = res.reply || res.message || res.response || JSON.stringify(res);
    history.innerHTML += '<div class="mb-2"><span class="badge bg-success">AI</span> ' + reply.replace(/\n/g, '<br>') + '</div>';
  } catch(e) {
    var typing = document.getElementById('ai-typing');
    if (typing) typing.remove();
    history.innerHTML += '<div class="mb-2 text-danger"><span class="badge bg-danger">错误</span> ' + e.message + '</div>';
  }
  history.scrollTop = history.scrollHeight;
}
</script>
<%- include('partials/footer') %>
