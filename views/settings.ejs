<%- include('partials/header') %>
<div class="main-content">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div><h4 class="mb-0">⚙️ 设置</h4><small class="text-muted">AI Provider + 邮件账号 + 爬虫代理 + 公司信息 + 指纹浏览器</small></div>
  </div>

  <ul class="nav nav-tabs mb-4" role="tablist">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-account">🔐 账户安全</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-ai">🤖 AI Provider</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-email-config">📬 邮件配置</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-company">🏢 公司信息</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-system">🔧 系统</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-antiban">🛡️ 防封规则</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-audit">📜 操作日志</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-modules">🔌 模块管理</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-tiktok-api">🎵 TikTok API</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-youtube-api">&#9654; YouTube API</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-instagram-api">&#128247; Instagram API</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-fingerprint">🔒 指纹浏览器</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-agent">🤖 Agent控制</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-knowledge">🧠 知识库</a></li>
  </ul>

  <div class="tab-content">
    <!-- 账户安全 -->
    <div class="tab-pane fade show active" id="tab-account">
      <div class="card">
        <div class="card-header">🔐 修改密码</div>
        <div class="card-body">
          <form id="change-password-form">
            <div class="mb-3">
              <label class="form-label">当前密码</label>
              <input type="password" class="form-control" name="currentPassword" required>
            </div>
            <div class="mb-3">
              <label class="form-label">新密码</label>
              <input type="password" class="form-control" name="newPassword" required minlength="6">
              <small class="text-muted">至少6个字符</small>
            </div>
            <div class="mb-3">
              <label class="form-label">确认新密码</label>
              <input type="password" class="form-control" name="confirmPassword" required minlength="6">
            </div>
            <button type="button" class="btn btn-purple" onclick="changePassword()">💾 修改密码</button>
          </form>
        </div>
      </div>
      
      <div class="card mt-3">
        <div class="card-header">🔐 双因素认证 (TOTP)</div>
        <div class="card-body" id="totp-section">
          <div id="totp-status">
            <p>加载中...</p>
          </div>
          
          <!-- 未启用时显示 -->
          <div id="totp-setup" style="display:none;">
            <p class="text-muted">启用Google Authenticator双因素认证，登录时需要额外输入动态验证码，大幅提升账户安全性。</p>
            <button class="btn btn-purple" onclick="setupTotp()">🔐 启用双因素认证</button>
          </div>
          
          <!-- 设置流程 -->
          <div id="totp-qrcode" style="display:none;">
            <div class="alert alert-info">
              <strong>步骤1：</strong>打开手机上的 Google Authenticator App<br>
              <strong>步骤2：</strong>扫描下方二维码<br>
              <strong>步骤3：</strong>输入App显示的6位验证码确认
            </div>
            <div class="text-center mb-3">
              <img id="totp-qr-img" src="" alt="TOTP QR Code" style="max-width:200px;">
            </div>
            <div class="mb-3">
              <label class="form-label">手动输入密钥（如果无法扫码）</label>
              <div class="input-group">
                <input type="text" class="form-control" id="totp-secret-text" readonly>
                <button class="btn btn-outline-secondary" onclick="navigator.clipboard.writeText(document.getElementById('totp-secret-text').value)">复制</button>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label">输入验证码确认</label>
              <input type="text" class="form-control" id="totp-verify-code" maxlength="6" pattern="[0-9]{6}" inputmode="numeric" placeholder="6位数字验证码">
            </div>
            <button class="btn btn-success" onclick="enableTotp()">✅ 确认启用</button>
            <button class="btn btn-secondary ms-2" onclick="cancelTotp()">取消</button>
          </div>
          
          <!-- 已启用时显示 -->
          <div id="totp-enabled" style="display:none;">
            <div class="alert alert-success">
              <strong>✅ 双因素认证已启用</strong><br>
              登录时需要输入Google Authenticator动态验证码。
            </div>
            <button class="btn btn-outline-danger" onclick="showDisableTotp()">禁用双因素认证</button>
          </div>
          
          <!-- 禁用确认 -->
          <div id="totp-disable" style="display:none;">
            <div class="alert alert-warning">
              <strong>⚠️ 禁用双因素认证会降低账户安全性</strong>
            </div>
            <div class="mb-3">
              <label class="form-label">当前密码</label>
              <input type="password" class="form-control" id="totp-disable-password" required>
            </div>
            <div class="mb-3">
              <label class="form-label">当前验证码</label>
              <input type="text" class="form-control" id="totp-disable-code" maxlength="6" pattern="[0-9]{6}" inputmode="numeric" placeholder="6位数字验证码">
            </div>
            <button class="btn btn-danger" onclick="disableTotp()">确认禁用</button>
            <button class="btn btn-secondary ms-2" onclick="cancelDisableTotp()">取消</button>
          </div>
        </div>
      </div>

      <div class="card mt-3">
        <div class="card-header">👤 账户信息</div>
        <div class="card-body">
          <p><strong>用户名:</strong> <%= locals.username || '未知' %></p>
          <p><strong>角色:</strong> <%= locals.role || 'user' %></p>
          <p><strong>最后登录:</strong> 当前会话</p>
        </div>
      </div>
    </div>

    <!-- AI Provider -->
    <div class="tab-pane fade" id="tab-ai">
      <div class="text-center mb-4">
        <h4 class="mb-0">🤖 AI 智能调度配置</h4>
        <small class="text-muted">可视化4角色分布图布局：主脑AI → 6专家Agent → 3种执行引擎</small>
      </div>

      <!-- 主脑AI -->
      <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
          <div>
            <span class="fs-5">🧠 主脑 AI</span>
            <small class="text-muted ms-2">理解指令 · 调度专家 · 汇总结果</small>
          </div>
          <button class="btn btn-sm btn-purple" onclick="addProviderToRole('brain')">➕ 添加</button>
        </div>
        <div class="card-body" id="role-brain-providers">
          <!-- Provider条目动态渲染 -->
        </div>
        <div class="card-footer d-flex gap-2">
          <button class="btn btn-sm btn-purple" onclick="saveRoleProviders('brain')">💾 保存设置</button>
          <button class="btn btn-sm btn-outline-primary" onclick="testRoleProviders('brain')">🔗 测试连接</button>
          <span id="role-brain-status" class="ms-2 small align-self-center"></span>
        </div>
      </div>

      <!-- 箭头连接线 -->
      <div class="text-center mb-3" style="font-size: 1.5rem;">▼</div>

      <!-- 6专家Agent -->
      <div class="card bg-light mb-3">
        <div class="card-body text-center py-2">
          <div class="mb-1"><strong>🧠 主脑自动调度 → 6专家Agent</strong></div>
          <div class="d-flex justify-content-center gap-3 flex-wrap">
            <span class="badge bg-primary">🧑‍💼 销售专家</span>
            <span class="badge bg-success">📧 邮件专家</span>
            <span class="badge bg-info">📊 数据分析</span>
            <span class="badge bg-warning text-dark">📝 内容专家</span>
            <span class="badge bg-secondary">🔍 市场调研</span>
            <span class="badge bg-danger">🛡️ 风控专家</span>
          </div>
          <small class="text-muted">每个专家自动选择合适的引擎执行任务</small>
        </div>
      </div>

      <!-- 箭头连接线 -->
      <div class="text-center mb-3" style="font-size: 1.5rem;">▼ 使用以下引擎执行</div>

      <!-- 3种引擎 -->
      <div class="row mb-4">
        <!-- 视频引擎 -->
        <div class="col-md-4">
          <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
              <div>
                <span class="fs-5">🎬 视频引擎</span>
                <small class="text-muted ms-2">视频生成 · 数字人/混剪</small>
              </div>
              <button class="btn btn-sm btn-purple" onclick="addProviderToRole('video')">➕ 添加</button>
            </div>
            <div class="card-body" id="role-video-providers">
              <!-- Provider条目动态渲染 -->
            </div>
            <div class="card-footer d-flex gap-2">
              <button class="btn btn-sm btn-purple" onclick="saveRoleProviders('video')">💾 保存</button>
              <button class="btn btn-sm btn-outline-primary" onclick="testRoleProviders('video')">🔗 测试</button>
              <span id="role-video-status" class="ms-2 small align-self-center"></span>
            </div>
          </div>
        </div>

        <!-- 视觉引擎 -->
        <div class="col-md-4">
          <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
              <div>
                <span class="fs-5">👁️ 视觉引擎</span>
                <small class="text-muted ms-2">看图分析 · 产品图识别</small>
              </div>
              <button class="btn btn-sm btn-purple" onclick="addProviderToRole('vision')">➕ 添加</button>
            </div>
            <div class="card-body" id="role-vision-providers">
              <!-- Provider条目动态渲染 -->
            </div>
            <div class="card-footer d-flex gap-2">
              <button class="btn btn-sm btn-purple" onclick="saveRoleProviders('vision')">💾 保存</button>
              <button class="btn btn-sm btn-outline-primary" onclick="testRoleProviders('vision')">🔗 测试</button>
              <span id="role-vision-status" class="ms-2 small align-self-center"></span>
            </div>
          </div>
        </div>

        <!-- 文本引擎 -->
        <div class="col-md-4">
          <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
              <div>
                <span class="fs-5">✍️ 文本引擎</span>
                <small class="text-muted ms-2">写邮件/翻译/SEO · 文案/分析/报表</small>
              </div>
              <button class="btn btn-sm btn-purple" onclick="addProviderToRole('text')">➕ 添加</button>
            </div>
            <div class="card-body" id="role-text-providers">
              <!-- Provider条目动态渲染 -->
            </div>
            <div class="card-footer d-flex gap-2">
              <button class="btn btn-sm btn-purple" onclick="saveRoleProviders('text')">💾 保存</button>
              <button class="btn btn-sm btn-outline-primary" onclick="testRoleProviders('text')">🔗 测试</button>
              <span id="role-text-status" class="ms-2 small align-self-center"></span>
            </div>
          </div>
        </div>
      </div>

      <!-- 操作按钮 -->
      <div class="d-flex justify-content-center gap-3">
        <button class="btn btn-purple" onclick="saveAIProviders()">💾 保存全部</button>
        <button class="btn btn-outline-primary" onclick="testAllProviders()">🔗 全部测试</button>
        <span id="ai-test-status" class="ms-2"></span>
      </div>
    </div>

    <!-- 邮件配置 -->
    <div class="tab-pane fade" id="tab-email-config">
      <div class="card">
        <div class="card-header d-flex justify-content-between">
          <span>📬 邮件账号 (<%= accounts.length %>)</span>
          <div>
            <button class="btn btn-sm btn-purple" data-bs-toggle="modal" data-bs-target="#addEmailAccountModal">➕ 单个添加</button>
            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#batchAddEmailModal">📋 批量添加</button>
            <button class="btn btn-sm btn-outline-danger" onclick="batchDeleteEmails()" id="btn-batch-delete" style="display:none">🗑️ 批量删除</button>
          </div>
          <div class="d-flex align-items-center gap-2 ms-auto">
            <small class="text-muted">默认发件账号:</small>
            <select id="default-email-account" class="form-select form-select-sm" style="width:auto;min-width:200px" onchange="setDefaultEmailAccount(this.value)">
              <option value="">自动轮询</option>
              <% (locals.emailAccounts || []).forEach(a => { %>
                <option value="<%= a.id %>" <%= a.id == locals.defaultEmailAccountId ? 'selected' : '' %>><%= a.email %> (<%= a.auth_type === 'gmail_api' ? 'Gmail API' : 'SMTP' %>)</option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="card-body p-0">
          <table class="table table-hover mb-0" id="email-accounts-table">
            <thead>
              <tr>
                <th><input type="checkbox" id="select-all-emails" onchange="toggleSelectAll(this)"></th>
                <th>邮箱</th>
                <th>认证</th>
                <th>预热</th>
                <th>限额</th>
                <th>健康度</th>
                <th>状态</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody>
              <% accounts.forEach(a => { %>
              <tr>
                <td><input type="checkbox" class="email-checkbox" value="<%= a.id %>" onchange="updateBatchDeleteBtn()"></td>
                <td><%= a.email %></td>
                <td><%= a.auth_type === 'gmail_api' ? '🔗 Gmail API' : '🔑 SMTP' %></td>
                <td><%= a.warmup_stage %></td>
                <td><%= a.daily_limit %>/天</td>
                <td><%= a.health_score %>%</td>
                <td><%= a.is_active ? '✅' : '⏸️' %></td>
                <td>
                  <button class="btn btn-sm btn-outline-primary me-1" onclick="testSmtpConnection(<%= a.id %>)" title="测试连接">🔗</button>
                  <% if (a.auth_type === 'gmail_api' && !a.oauth_credentials) { %>
                  <button class="btn btn-sm btn-warning me-1" onclick="startGmailAuth(<%= a.id %>)" title="Gmail OAuth授权">🔐 授权</button>
                  <% } else if (a.auth_type === 'gmail_api' && a.oauth_credentials) { %>
                  <button class="btn btn-sm btn-outline-success me-1" onclick="startGmailAuth(<%= a.id %>)" title="重新授权">✅ 已授权</button>
                  <% } %>
                  <button class="btn btn-sm btn-outline-danger" onclick="deleteEmail(<%= a.id %>)">删除</button>
                </td>
              </tr>
              <% }) %>
              <% if(!accounts.length) { %><tr><td colspan="8" class="text-center text-muted py-3">暂无邮箱</td></tr><% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- 公司信息 -->
    <div class="tab-pane fade" id="tab-company">
      <div class="card">
        <div class="card-header">🏢 公司信息</div>
        <div class="card-body">
          <form id="company-form">
            <div class="mb-3"><label class="form-label">公司名称</label><input type="text" class="form-control" name="name" value="<%= settings.company_info?.name || '' %>"></div>
            <div class="mb-3"><label class="form-label">主营产品</label><input type="text" class="form-control" name="products" value="<%= settings.company_info?.products || 'Smart Meters, Circuit Breakers' %>"></div>
            <div class="mb-3"><label class="form-label">目标市场</label><input type="text" class="form-control" name="markets" value="<%= settings.company_info?.markets || '中东, 东南亚, 非洲, 南美' %>"></div>
            <div class="mb-3"><label class="form-label">公司地址</label><input type="text" class="form-control" name="address" value="<%= settings.company_info?.address || '' %>"></div>
            <div class="mb-3"><label class="form-label">联系电话</label><input type="text" class="form-control" name="phone" value="<%= settings.company_info?.phone || '' %>"></div>
            <div class="mb-3"><label class="form-label">网站</label><input type="text" class="form-control" name="website" value="<%= settings.company_info?.website || '' %>"></div>
            <button type="button" class="btn btn-purple" onclick="saveCompanyInfo()">💾 保存</button>
          </form>
        </div>
      </div>
    </div>

    <!-- 系统 -->
    <div class="tab-pane fade" id="tab-system">
      <div class="card">
        <div class="card-header">🔧 系统信息</div>
        <div class="card-body">
          <p><strong>版本:</strong> VIPB AI System V2.0</p>
          <p><strong>技术栈:</strong> Node.js + Express + EJS + Bootstrap 5 + better-sqlite3</p>
          <p><strong>数据库:</strong> SQLite (data/vipb.db)</p>
          <p><strong>端口:</strong> 3000</p>
          <p><strong>架构:</strong> 8大模块 + AI大脑5层架构</p>
        </div>
      </div>

      <!-- 数据库备份管理 -->
      <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span>💾 数据库备份</span>
          <div>
            <button class="btn btn-sm btn-purple" onclick="manualBackup()" id="btn-backup">💾 立即备份</button>
            <button class="btn btn-sm btn-outline-warning ms-2" onclick="cleanBackups()">🧹 清理旧备份</button>
          </div>
        </div>
        <div class="card-body">
          <div class="alert alert-info small mb-3">
            <strong>自动备份:</strong> 每天凌晨3:00自动备份 | 服务器启动时自动备份 | 保留最近7天
          </div>
          <div id="backup-status" class="mb-3"></div>
          <div id="backup-list">
            <div class="text-center text-muted py-2"><div class="spinner-border spinner-border-sm"></div> 加载中...</div>
          </div>
        </div>
      </div>

      <div class="card mt-3">
        <div class="card-header">💾 数据导入导出</div>
        <div class="card-body">
          <div class="d-flex gap-3">
            <button class="btn btn-purple" onclick="exportData()">📤 导出所有数据 (JSON)</button>
            <div>
              <label class="btn btn-outline-primary mb-0">📥 导入数据 (JSON)<input type="file" accept=".json" onchange="importData(this)" hidden></label>
            </div>
          </div>
          <div id="data-io-status" class="mt-2"></div>
        </div>
      </div>
    </div>

    <!-- 防封规则 -->
    <div class="tab-pane fade" id="tab-antiban">
      <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
          <strong>🛡️ 防封 & 养号规则引擎</strong>
          <div>
            <span class="badge bg-info me-2" id="ab-version">v-</span>
            <button class="btn btn-sm btn-outline-warning" onclick="abReset()">🔄 恢复默认</button>
            <button class="btn btn-sm btn-success" onclick="abSave()">💾 保存修改</button>
          </div>
        </div>
        <div class="card-body">
          <p class="small text-muted">所有平台的养号阶段、发送限额、内容安全、时间控制规则集中管理。修改后立即生效，无需重启。</p>

          <ul class="nav nav-pills mb-3 flex-wrap">
            <li class="nav-item"><a class="nav-link active" data-bs-toggle="pill" href="#ab-whatsapp">💬 WhatsApp</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="pill" href="#ab-linkedin">🔗 LinkedIn</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="pill" href="#ab-facebook">📘 Facebook</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="pill" href="#ab-tiktok">🎵 TikTok</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="pill" href="#ab-email">📧 Email</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="pill" href="#ab-instagram">📷 Instagram</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="pill" href="#ab-youtube">▶️ YouTube</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="pill" href="#ab-twitter">🐦 Twitter</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="pill" href="#ab-vk">🔵 VK</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="pill" href="#ab-reddit">🟠 Reddit</a></li>
          </ul>

          <div class="tab-content">
            <div class="tab-pane fade show active" id="ab-whatsapp"><div id="ab-editor-whatsapp"></div></div>
            <div class="tab-pane fade" id="ab-linkedin"><div id="ab-editor-linkedin"></div></div>
            <div class="tab-pane fade" id="ab-facebook"><div id="ab-editor-facebook"></div></div>
            <div class="tab-pane fade" id="ab-tiktok"><div id="ab-editor-tiktok"></div></div>
            <div class="tab-pane fade" id="ab-email"><div id="ab-editor-email"></div></div>
            <div class="tab-pane fade" id="ab-instagram"><div id="ab-editor-instagram"></div></div>
            <div class="tab-pane fade" id="ab-youtube"><div id="ab-editor-youtube"></div></div>
            <div class="tab-pane fade" id="ab-twitter"><div id="ab-editor-twitter"></div></div>
