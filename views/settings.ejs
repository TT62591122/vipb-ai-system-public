// ===== 指纹浏览器配置 =====
async function fpLoadConfig() {
  try {
    const res = await fetch('/api/browser-adapters/status');
    const data = await res.json();
    if (data.success && data.data) {
      for (const [type, info] of Object.entries(data.data)) {
        const prefix = type === 'adspower' ? 'ads' : type === 'multilogin' ? 'ml' : 'gl';
        const el = document.getElementById(`fp-${prefix}-status`);
        if (el) {
          if (info.online) {
            el.className = 'badge bg-success';
            el.textContent = '✅ 在线';
          } else {
            el.className = 'badge bg-danger';
            el.textContent = '❌ 离线';
          }
        }
      }
    }
  } catch(e) { console.error('加载指纹浏览器状态失败:', e); }
}

async function fpCheck(type) {
  const prefix = type === 'adspower' ? 'ads' : type === 'multilogin' ? 'ml' : 'gl';
  const el = document.getElementById(`fp-${prefix}-status`);
  if (el) { el.className = 'badge bg-warning'; el.textContent = '检测中...'; }
  try {
    const res = await fetch('/api/browser-adapters/status');
    const data = await res.json();
    if (data.success && data.data?.[type]) {
      const info = data.data[type];
      if (el) {
        el.className = info.online ? 'badge bg-success' : 'badge bg-danger';
        el.textContent = info.online ? '✅ 在线' : '❌ 离线';
      }
      toast(info.online ? `${type} 连接成功` : `${type} 未连接: ${info.error || '未知'}`);
    }
  } catch(e) {
    if (el) { el.className = 'badge bg-danger'; el.textContent = '❌ 错误'; }
    toast('检测失败: ' + e.message);
  }
}

async function fpCheckAll() {
  await Promise.all(['adspower', 'multilogin', 'geelark'].map(t => fpCheck(t)));
}

async function fpSaveConfig() {
  const config = {
    adspower: {
      enabled: document.getElementById('fp-ads-enabled').checked,
      apiUrl: document.getElementById('fp-ads-url').value
    },
    multilogin: {
      enabled: document.getElementById('fp-ml-enabled').checked,
      apiUrl: document.getElementById('fp-ml-url').value,
      token: document.getElementById('fp-ml-token').value
    },
    geelark: {
      enabled: document.getElementById('fp-gl-enabled').checked,
      apiUrl: document.getElementById('fp-gl-url').value,
      apiKey: document.getElementById('fp-gl-apikey').value
    }
  };
  try {
    const res = await fetch('/api/browser-adapters/config', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(config)
    });
    const data = await res.json();
    if (data.success) toast('指纹浏览器配置已保存');
    else toast('保存失败: ' + (data.error || '未知错误'));
  } catch(e) { toast('保存失败: ' + e.message); }
}

async function fpViewProfiles(type) {
  const prefix = type === 'adspower' ? 'ads' : type === 'multilogin' ? 'ml' : 'gl';
  const container = document.getElementById(`fp-${prefix}-profiles`);
  if (!container) return;
  container.style.display = container.style.display === 'none' ? 'block' : 'none';
  if (container.style.display === 'none') return;
  container.innerHTML = '<div class="text-center"><div class="spinner-border spinner-border-sm"></div> 加载中...</div>';
  try {
    const res = await fetch(`/api/browser-adapters/${type}/profiles`);
    const data = await res.json();
    if (data.success && data.data?.length) {
      let html = '<table class="table table-sm table-bordered mb-0"><thead><tr><th>ID</th><th>名称</th><th>状态</th></tr></thead><tbody>';
      data.data.forEach(p => {
        html += `<tr><td><code>${p.id}</code></td><td>${p.name}</td><td>${p.status}</td></tr>`;
      });
      html += '</tbody></table>';
      container.innerHTML = html;
    } else {
      container.innerHTML = '<div class="text-muted small">暂无配置文件。请先在 AdsPower 中创建浏览器配置。</div>';
    }
  } catch(e) {
    container.innerHTML = `<div class="text-danger small">加载失败: ${e.message}（请确认软件已启动）</div>`;
  }
}

