function parseBatchEmails() {
  const input = document.getElementById('batch-email-input').value.trim();
  if (!input) { toast('请输入邮箱数据', 'warning'); return; }
  
  const lines = input.split('\n').filter(l => l.trim());
  parsedEmails = [];
  const duplicates = [];
  const existing = <%- JSON.stringify(accounts.map(a => a.email)) %>;
  const needPresetFill = [];
  
  lines.forEach(line => {
    line = line.trim();
    let email = null;
    
    // 尝试JSON格式
    if (line.startsWith('{')) {
      try {
        const obj = JSON.parse(line);
        if (obj.email) email = obj;
      } catch {}
    }
    
    // 尝试分隔符格式
    if (!email) {
      const parts = line.split(/[|,\t]/);
      if (parts.length >= 1 && parts[0].includes('@')) {
        email = {
          email: parts[0].trim(),
          smtp_pass: parts[1]?.trim() || '',
          smtp_host: parts[2]?.trim() || '',
          smtp_port: parseInt(parts[3]) || 587,
          smtp_user: parts[0].trim()
        };
        // 没填SMTP主机的，标记需要自动填充
        if (!email.smtp_host) needPresetFill.push(email);
      }
    }
    
    if (email) {
      if (existing.includes(email.email) || parsedEmails.find(e => e.email === email.email)) {
        duplicates.push(email.email);
      } else {
        parsedEmails.push(email);
      }
    }
  });
  
  // 自动填充预设配置
  (async () => {
    let filled = 0;
    for (const em of needPresetFill) {
      try {
        const res = await api('/api/email-presets?email=' + encodeURIComponent(em.email), 'GET');
        if (res.success && res.data && res.data.matched) {
          em.smtp_host = res.data.smtp_host;
          em.smtp_port = res.data.smtp_port;
          if (res.data.imap_host) em.imap_host = res.data.imap_host;
          if (res.data.imap_port) em.imap_port = res.data.imap_port;
          filled++;
        }
      } catch(e) {}
    }
    
    const result = document.getElementById('batch-parse-result');
    result.innerHTML = `
      <div class="alert alert-success">✅ 解析成功 ${parsedEmails.length} 个邮箱${filled ? '，自动填充 ' + filled + ' 个SMTP配置' : ''}</div>
      ${duplicates.length ? `<div class="alert alert-warning">⚠️ 跳过重复: ${duplicates.join(', ')}</div>` : ''}
      <div class="table-container" style="max-height:200px;overflow-y:auto">
        <table class="table table-sm">
          <thead><tr><th>邮箱</th><th>SMTP主机</th><th>端口</th></tr></thead>
          <tbody>
            ${parsedEmails.map(e => `<tr><td>${e.email}</td><td>${e.smtp_host||'<span class="text-danger">未识别</span>'}</td><td>${e.smtp_port||587}</td></tr>`).join('')}
          </tbody>
        </table>
      </div>
    `;
  })();
}

async function submitBatchEmails() {
  if (!parsedEmails.length) { toast('请先解析邮箱数据', 'warning'); return; }
  
  const result = document.getElementById('batch-parse-result');
  result.innerHTML = '<div class="spinner-border spinner-border-sm"></div> 批量添加中...';
  
  const res = await api('/api/marketing/accounts/batch', 'POST', { accounts: parsedEmails });
  
  if (res.success) {
    toast(`成功添加 ${res.added} 个邮箱`);
    // 收集所有需要授权的邮箱，按服务商去重
    const guideMap = {};
    for (const em of parsedEmails) {
      if (!em.email || !em.email.includes('@')) continue;
      try {
        const presetRes = await api('/api/email-presets?email=' + encodeURIComponent(em.email), 'GET');
        if (presetRes.success && presetRes.data && presetRes.data.matched && presetRes.data.guide_url) {
          if (!guideMap[presetRes.data.domain]) {
            guideMap[presetRes.data.domain] = { url: presetRes.data.guide_url, note: presetRes.data.note, emails: [] };
          }
          guideMap[presetRes.data.domain].emails.push(em.email);
        }
      } catch(e) {}
    }
    const domains = Object.keys(guideMap);
    if (domains.length > 0) {
      let html = '<div class="alert alert-info mt-3"><b>📋 以下邮箱需要获取授权码/应用密码：</b><br><br>';
      domains.forEach(d => {
        const g = guideMap[d];
        html += '<div class="mb-2"><b>' + d + '</b>（' + g.emails.length + '个邮箱）<br>';
        html += '<small class="text-muted">💡 ' + (g.note || '') + '</small><br>';
        html += '<a href="' + g.url + '" target="_blank" class="btn btn-sm btn-outline-primary mt-1" onclick="this.classList.add(\'disabled\')">🔗 打开' + d + '授权页面</a></div>';
      });
      html += '<hr><small>获取授权码后，在邮箱列表中编辑对应邮箱，填入授权码并测试连接。</small></div>';
      result.innerHTML = `<div class="alert alert-success">✅ 成功添加 ${res.added} 个邮箱</div>` + html;
    } else {
      setTimeout(() => reloadKeepTab(), 1000);
    }
  } else {
    result.innerHTML = `<div class="alert alert-danger">${res.error}</div>`;
  }
}

