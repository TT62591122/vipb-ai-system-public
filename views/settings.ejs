// ========== TikTok API 配置 ==========
async function loadTikTokApi() {
  try {
    var res = await fetch('/api/settings/tiktok-api');
    var result = await res.json();
    if (result.success && result.data) {
      document.getElementById('tk-client-key').value = result.data.clientKey || '';
      document.getElementById('tk-redirect-uri').value = result.data.redirectUri || 'http://localhost:3001/oauth/tiktok/callback';
      if (result.data.clientSecretMasked) {
        document.getElementById('tk-secret-masked').textContent = '当前密钥: ' + result.data.clientSecretMasked;
      }
    }
  } catch(e) { console.error('加载TikTok配置失败:', e); }
}

async function saveTikTokApi() {
  var clientKey = document.getElementById('tk-client-key').value.trim();
  var clientSecret = document.getElementById('tk-client-secret').value.trim();
  var redirectUri = document.getElementById('tk-redirect-uri').value.trim();
  if (!clientKey) { toast('请填写 Client Key', 'warning'); return; }
  var body = { clientKey, redirectUri };
  if (clientSecret) body.clientSecret = clientSecret;
  try {
    var res = await fetch('/api/settings/tiktok-api', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
    var result = await res.json();
    if (result.success) {
      toast('TikTok API 配置已保存');
      document.getElementById('tk-client-secret').value = '';
      loadTikTokApi();
    } else {
      toast('保存失败: ' + (result.error || '未知错误'), 'danger');
    }
  } catch(e) { toast('保存失败: ' + e.message, 'danger'); }
}

document.querySelector('[href="#tab-tiktok-api"]')?.addEventListener('shown.bs.tab', loadTikTokApi);
if (location.hash === '#tab-tiktok-api') loadTikTokApi();

