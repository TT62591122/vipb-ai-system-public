let auditCurrentPage = 1;

async function loadAuditLogs(page) {
  if (page) auditCurrentPage = page;
  
  const action = document.getElementById('audit-action-filter').value;
  const entityType = document.getElementById('audit-entity-filter').value;
  const dateFrom = document.getElementById('audit-date-from').value;
  const dateTo = document.getElementById('audit-date-to').value;
  
  const params = new URLSearchParams({
    page: auditCurrentPage,
    limit: 50
  });
  if (action) params.set('action', action);
  if (entityType) params.set('entityType', entityType);
  if (dateFrom) params.set('dateFrom', dateFrom);
  if (dateTo) params.set('dateTo', dateTo);
  
  const body = document.getElementById('audit-table-body');
  body.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-2"><div class="spinner-border spinner-border-sm"></div> 加载中...</td></tr>';
  
  try {
    const res = await api(`/api/settings/audit-logs?${params}`);
    const logs = res.data || [];
    const pg = res.pagination || {};
    
    document.getElementById('audit-stats').textContent = `共 ${pg.total || 0} 条记录，第 ${pg.page || 1}/${pg.totalPages || 1} 页`;
    
    if (!logs.length) {
      body.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">暂无日志记录</td></tr>';
    } else {
      const actionIcons = {
        login: '🔑', logout: '🚪', created: '✨', updated: '📝', deleted: '🗑️',
        stage_change: '🔄', approved: '✅', rejected: '❌',
        email_sent: '📧', ai_call: '🤖', backup: '💾',
        settings_change: '⚙️', password_change: '🔒', clean_logs: '🧹'
      };
      const entityIcons = {
        user: '👤', customer: '🏢', deal: '💰', inquiry: '📋',
        email: '📧', product: '📦', settings: '⚙️', ai: '🤖', system: '🖥️'
      };
      
      body.innerHTML = logs.map(log => {
        const actionIcon = actionIcons[log.action] || '📄';
        const entityIcon = entityIcons[log.entity_type] || '📄';
        let details = '';
        try {
          const d = JSON.parse(log.details || '{}');
          const esc = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
          details = Object.entries(d).map(([k,v]) => `<span class="badge bg-light text-dark me-1">${esc(k)}: ${esc(typeof v === 'object' ? JSON.stringify(v) : v)}</span>`).join('');
        } catch { details = (log.details || '').replace(/</g,'&lt;'); }
        
        return `<tr>
          <td><small>${log.created_at || '-'}</small></td>
          <td>${actionIcon} <small>${log.action || '-'}</small></td>
          <td>${entityIcon} <small>${log.entity_type || '-'}</small></td>
          <td><small>${log.entity_id || '-'}</small></td>
          <td><div style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${details}</div></td>
        </tr>`;
      }).join('');
    }
    
    // 分页
    const paginationEl = document.getElementById('audit-pagination');
    if (pg.totalPages > 1) {
      paginationEl.innerHTML = `
        <small class="text-muted">第 ${pg.page}/${pg.totalPages} 页</small>
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item ${pg.page <= 1 ? 'disabled' : ''}"><a class="page-link" href="#" onclick="loadAuditLogs(${pg.page - 1});return false;">‹</a></li>
          <li class="page-item active"><a class="page-link">${pg.page}</a></li>
          <li class="page-item ${pg.page >= pg.totalPages ? 'disabled' : ''}"><a class="page-link" href="#" onclick="loadAuditLogs(${pg.page + 1});return false;">›</a></li>
        </ul>
      `;
    } else {
      paginationEl.innerHTML = '';
    }
  } catch(e) {
    body.innerHTML = '<tr><td colspan="5" class="text-danger text-center py-2">加载失败</td></tr>';
  }
}

