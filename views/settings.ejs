async function loadAgentActionLog() {
  try {
    const res = await api('/api/agent/action-log?limit=30');
    const el = document.getElementById('agent-action-log');
    if (!res.success || !res.data.length) { el.innerHTML = '<p class="text-muted">暂无操作记录</p>'; return; }
    el.innerHTML = res.data.map(a => `
      <div class="border-start border-3 ${a.triggered_by === 'agent' ? 'border-primary' : 'border-success'} ps-2 mb-2">
        <small class="text-muted">${a.created_at}</small>
        <span class="badge bg-${a.status === 'executed' ? 'success' : a.status === 'cancelled' ? 'secondary' : 'warning'} ms-1">${a.status}</span>
        <span class="badge bg-${a.triggered_by === 'agent' ? 'primary' : 'info'}">${a.triggered_by}</span>
        <div><strong>${a.action_type}</strong> ${a.action_detail || ''}</div>
        ${a.result ? '<small class="text-muted">' + a.result + '</small>' : ''}
      </div>
    `).join('');
  } catch(e) { console.error('loadAgentActionLog:', e); }
}

