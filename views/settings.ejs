      } else {
        html += `<div class="col-md-4"><label class="form-label small">${getFieldLabel(k)}</label><input type="${typeof v==='number'?'number':'text'}" class="form-control form-control-sm" value="${v}" onchange="abUpdateField('${platform}','schedule','${k}',this.value)"></div>`;
