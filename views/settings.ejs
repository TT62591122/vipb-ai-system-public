}

async function loadUpgradeRequests() {
  try {
    const res = await api('/api/agent/upgrade-requests');
    const el = document.getElementById('upgrade-requests-list');
    if (!res.success || !res.data?.length) { el.innerHTML = '<p class="text-muted">暂无升级申请</p>'; return; }
    el.innerHTML = res.data.map(r => `
      <div class="border-start border-3 ${r.status === 'pending' ? 'border-warning' : r.status === 'approved' ? 'border-success' : 'border-danger'} ps-2 mb-2">
        <small class="text-muted">${r.created_at}</small>
        <span class="badge bg-${r.status === 'pending' ? 'warning' : r.status === 'approved' ? 'success' : 'danger'}">${r.status === 'pending' ? '待审核' : r.status === 'approved' ? '已同意' : '已拒绝'}</span>
        <div>Lv${r.from_level} → Lv${r.to_level}: ${r.reason}</div>
        ${r.status === 'pending' ? `<button class="btn btn-sm btn-success mt-1" onclick="respondUpgrade(${r.id},true)">✅ 同意</button> <button class="btn btn-sm btn-danger mt-1" onclick="respondUpgrade(${r.id},false)">❌ 拒绝</button>` : ''}
      </div>
    `).join('');
  } catch(e) { console.error('loadUpgradeRequests:', e); }
}

async function respondUpgrade(id, approved) {
  try {
    const res = await api('/api/agent/upgrade-requests/' + id, 'PUT', { approved });
    if (res.success) {
      toast(approved ? '已同意升级' : '已拒绝，Agent需积累更多经验后再申请', 'success');
      loadAutonomy(); loadUpgradeRequests();
    }
  } catch(e) { toast('操作失败', 'danger'); }
}

// ========== 巡检规则 ==========
async function loadScanRules() {
  try {
    const res = await api('/api/agent/scan-rules');
    if (!res.success) return;
    const d = res.data;
    document.getElementById('rule-first-touch').value = d.first_touch_hours || 24;
    document.getElementById('rule-follow-up').value = d.follow_up_days || 3;
    document.getElementById('rule-inquiry').value = d.inquiry_reply_hours || 2;
    document.getElementById('rule-hot-lead').value = d.hot_lead_hours || 12;
    document.getElementById('rule-max-actions').value = d.max_actions_per_scan || 10;
  } catch(e) { console.error('loadScanRules:', e); }
}

async function saveScanRules() {
  try {
    const rules = {
      first_touch_hours: parseInt(document.getElementById('rule-first-touch').value),
      follow_up_days: parseInt(document.getElementById('rule-follow-up').value),
      inquiry_reply_hours: parseInt(document.getElementById('rule-inquiry').value),
      hot_lead_hours: parseInt(document.getElementById('rule-hot-lead').value),
      max_actions_per_scan: parseInt(document.getElementById('rule-max-actions').value)
    };
    const res = await api('/api/agent/scan-rules', 'PUT', rules);
    if (res.success) toast('巡检规则已保存', 'success');
  } catch(e) { toast('保存失败', 'danger'); }
}

async function triggerManualScan() {
  toast('正在执行巡检...', 'info');
  try {
    const res = await api('/api/agent/scan', 'POST');
    if (res.success) {
      if (res.skipped) toast('巡检跳过: ' + (res.reason || 'Agent未启用'), 'warning');
      else toast(`巡检完成: 发现${res.total || 0}个机会, 执行${res.executed || 0}/草稿${res.drafted || 0}/通知${res.notified || 0}`, 'success');
      loadScanResults(); loadAgentActionLog();
    } else toast('巡检失败: ' + res.error, 'danger');
  } catch(e) { toast('巡检失败', 'danger'); }
}

async function loadScanResults() {
  try {
    const res = await api('/api/agent/scan-results?limit=20');
    const el = document.getElementById('scan-results-list');
    if (!res.success || !res.data?.length) { el.innerHTML = '<p class="text-muted">暂无巡检结果</p>'; return; }
    el.innerHTML = res.data.map(r => `
      <div class="border-start border-2 ${r.status === 'executed' ? 'border-success' : r.status === 'pending' ? 'border-warning' : 'border-secondary'} ps-2 mb-1">
        <small class="text-muted">${r.created_at}</small>
        <span class="badge bg-${r.status === 'executed' ? 'success' : r.status === 'pending' ? 'warning' : 'secondary'} ms-1">${r.status}</span>
        <span class="badge bg-info">${r.trigger_type}</span>
        <div class="small">${r.trigger_reason || ''}</div>
        ${r.decision_reason ? '<small class="text-muted">决策: ' + r.decision_reason + '</small>' : ''}
      </div>
    `).join('');
  } catch(e) { console.error('loadScanResults:', e); }
}

// ========== 效果看板 ==========
async function loadDashboard() {
  try {
    const res = await api('/api/agent/dashboard/overview?days=30');
    if (!res.success) return;
    document.getElementById('dash-scans').textContent = res.scans?.scan_count || 0;
    document.getElementById('dash-opportunities').textContent = res.scans?.total || 0;
    document.getElementById('dash-executed').textContent = res.scans?.executed || 0;
    document.getElementById('dash-experiences').textContent = res.experiences?.total || 0;
    document.getElementById('dash-autonomy').textContent = 'Lv' + (res.autonomyLevel || 1);
    document.getElementById('dash-agent-rate').textContent = res.emailComparison?.agent?.rate || 'N/A';
    document.getElementById('dash-manual-rate').textContent = res.emailComparison?.manual?.rate || 'N/A';
    // 草稿数从drafts API获取
  } catch(e) { console.error('loadDashboard:', e); }
}

// ========== Agent草稿审核 ==========
async function loadAgentDrafts() {
  try {
    const res = await api('/api/agent/dashboard/drafts');
    const el = document.getElementById('agent-drafts-list');
    document.getElementById('draft-count').textContent = res.total || 0;
    document.getElementById('dash-drafts').textContent = res.total || 0;
    if (!res.success || !res.data?.length) { el.innerHTML = '<p class="text-muted">暂无待审核草稿</p>'; return; }
    el.innerHTML = res.data.map(d => `
      <div class="border-start border-2 border-warning ps-2 mb-2">
        <div class="d-flex justify-content-between">
          <strong>${d.company || d.contact_name || d.to_addr}</strong>
          <small class="text-muted">${d.created_at}</small>
        </div>
        <div class="small">📧 ${d.subject || '(无主题)'}</div>
        <div class="small text-muted text-truncate" style="max-width:500px">${(d.body || '').substring(0, 100)}...</div>
        <button class="btn btn-sm btn-outline-primary mt-1" onclick='openDraftEdit(${JSON.stringify(d).replace(/'/g,"&#39;")})'>✏️ 查看/编辑</button>
        <button class="btn btn-sm btn-success mt-1" onclick="sendDraft(${d.id})">✅ 发送</button>
        <button class="btn btn-sm btn-danger mt-1" onclick="deleteDraft(${d.id})">🗑️ 删除</button>
      </div>
    `).join('');
  } catch(e) { console.error('loadAgentDrafts:', e); }
}

async function sendDraft(id) {
  try {
    const res = await api('/api/agent/dashboard/drafts/' + id + '/send', 'POST');
    if (res.success) { toast('已加入发送队列', 'success'); loadAgentDrafts(); loadDashboard(); }
    else toast('发送失败: ' + res.error, 'danger');
  } catch(e) { toast('发送失败', 'danger'); }
}

async function deleteDraft(id) {
  try {
    const res = await api('/api/agent/dashboard/drafts/' + id, 'DELETE');
    if (res.success) { toast('草稿已删除', 'success'); loadAgentDrafts(); loadDashboard(); }
    else toast('删除失败: ' + res.error, 'danger');
  } catch(e) { toast('删除失败', 'danger'); }
}

function openDraftEdit(d) {
  document.getElementById('draft-edit-id').value = d.id;
  document.getElementById('draft-edit-to').value = d.to_addr || '';
  document.getElementById('draft-edit-subject').value = d.subject || '';
  document.getElementById('draft-edit-body').value = d.body || '';
  new bootstrap.Modal(document.getElementById('draftEditModal')).show();
}

async function saveDraft() {
  const id = document.getElementById('draft-edit-id').value;
  const subject = document.getElementById('draft-edit-subject').value;
  const body = document.getElementById('draft-edit-body').value;
  try {
    const res = await api('/api/agent/dashboard/drafts/' + id, 'PUT', { subject, body });
    if (res.success) { toast('草稿已保存', 'success'); bootstrap.Modal.getInstance(document.getElementById('draftEditModal')).hide(); loadAgentDrafts(); }
    else toast('保存失败: ' + res.error, 'danger');
  } catch(e) { toast('保存失败', 'danger'); }
}

async function saveThenSendDraft() {
  const id = document.getElementById('draft-edit-id').value;
  const subject = document.getElementById('draft-edit-subject').value;
  const body = document.getElementById('draft-edit-body').value;
  try {
    const saveRes = await api('/api/agent/dashboard/drafts/' + id, 'PUT', { subject, body });
    if (!saveRes.success) { toast('保存失败: ' + saveRes.error, 'danger'); return; }
    const sendRes = await api('/api/agent/dashboard/drafts/' + id + '/send', 'POST');
    if (sendRes.success) { toast('已保存并加入发送队列', 'success'); bootstrap.Modal.getInstance(document.getElementById('draftEditModal')).hide(); loadAgentDrafts(); loadDashboard(); }
    else toast('发送失败: ' + sendRes.error, 'danger');
  } catch(e) { toast('操作失败', 'danger'); }
}

// ========== Socket.IO Agent事件监听 ==========
if (typeof io !== 'undefined') {
  const socket = io();
  socket.on('agent_event', (event) => {
    console.log('[Agent Event]', event.type, event.data);
    switch(event.type) {
      case 'scan_complete':
        toast('巡检完成: 发现' + (event.data.total || 0) + '个机会', 'info');
        loadScanResults(); loadDashboard(); loadAgentActionLog(); loadAgentDrafts();
        break;
      case 'draft_created':
        toast('Agent为 ' + (event.data.customer || '客户') + ' 生成了邮件草稿', 'info');
        loadAgentDrafts();
        break;
      case 'auto_executed':
        toast('Agent自动发送邮件给 ' + (event.data.customer || '客户'), 'success');
        loadAgentActionLog(); loadDashboard();
        break;
      case 'upgrade_request':
        toast('Agent申请升级到 ' + event.data.toName + ': ' + event.data.reason, 'warning');
        loadUpgradeRequests();
        break;
      case 'autonomy_changed':
        toast('自主权等级已变更为 ' + event.data.levelName, 'info');
        loadAutonomy(); loadDashboard();
        break;
      case 'learning_complete':
        if (event.data.strategiesCreated > 0) {
          toast('主动学习: 发现' + event.data.strategiesCreated + '个新策略草稿', 'info');
        }
        break;
      case 'agent_trigger':
        toast(event.data.reason, 'info');
        break;
    }
  });
}

// ========== 知识库管理 ==========
async function loadExperiences() {
  try {
    const cat = document.getElementById('kb-filter-category').value;
    const sent = document.getElementById('kb-filter-sentiment').value;
    let url = '/api/agent/experiences?limit=50';
    if (cat) url += '&category=' + cat;
    if (sent) url += '&sentiment=' + sent;
    const res = await api(url);
    const el = document.getElementById('kb-experiences-list');
    document.getElementById('kb-exp-count').textContent = res.total || 0;
    if (!res.success || !res.rows?.length) { el.innerHTML = '<p class="text-muted">暂无经验记录</p>'; return; }
    el.innerHTML = res.rows.map(e => `
      <div class="card card-body p-2 mb-2">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <span class="badge bg-info">${e.category}</span>
            <span class="badge bg-${e.result_sentiment === 'positive' ? 'success' : e.result_sentiment === 'negative' ? 'danger' : 'secondary'}">${e.result_sentiment}</span>
            <span class="badge bg-warning text-dark">置信度: ${(e.confidence || 0).toFixed(2)}</span>
            ${e.is_valid === 1 ? '<span class="badge bg-success">✓有效</span>' : e.is_valid === 0 ? '<span class="badge bg-danger">✗无效</span>' : ''}
          </div>
          <div>
            <button class="btn btn-sm btn-outline-success" onclick="markExp(${e.id},1)" title="标记有效">✓</button>
            <button class="btn btn-sm btn-outline-danger" onclick="markExp(${e.id},0)" title="标记无效">✗</button>
            <button class="btn btn-sm btn-outline-secondary" onclick="deleteExp(${e.id})" title="删除">🗑</button>
          </div>
        </div>
        <div class="mt-1"><strong>场景:</strong> ${e.situation || '-'}</div>
        <div><strong>做法:</strong> ${e.action || '-'}</div>
        <div><strong>结果:</strong> ${e.result || '-'}</div>
        ${e.lesson ? '<div><strong>教训:</strong> ' + e.lesson + '</div>' : ''}
        <small class="text-muted">来源: ${e.source} | 应用${e.times_applied || 0}次 | ${e.created_at}</small>
      </div>
    `).join('');
  } catch(e) { console.error('loadExperiences:', e); }
}

async function markExp(id, valid) {
  await api('/api/agent/experiences/' + id + '/validate', 'PUT', { is_valid: valid });
  loadExperiences();
}
async function deleteExp(id) {
  if (!confirm('确定删除这条经验？')) return;
  await api('/api/agent/experiences/' + id, 'DELETE');
  loadExperiences();
}

async function loadStrategies() {
  try {
    const res = await api('/api/agent/strategies');
    const el = document.getElementById('kb-strategies-list');
    if (!res.success || !res.data?.length) { el.innerHTML = '<p class="text-muted">暂无策略</p>'; return; }
    el.innerHTML = res.data.map(s => `
      <div class="card card-body p-2 mb-2">
        <div class="d-flex justify-content-between">
          <strong>${s.name}</strong>
          <span class="badge bg-${s.is_active ? 'success' : 'secondary'}">${s.is_active ? '启用' : '停用'}</span>
        </div>
        <div>${s.description || ''}</div>
        ${s.target_segment ? '<small class="text-muted">适用: ' + s.target_segment + '</small>' : ''}
      </div>
    `).join('');
  } catch(e) { console.error('loadStrategies:', e); }
}

async function loadStaticKnowledge() {
  try {
    const res = await api('/api/agent/knowledge');
    const el = document.getElementById('kb-static-list');
    if (!res.success || !res.data) { el.innerHTML = '<p class="text-muted">暂无静态知识</p>'; return; }
    el.innerHTML = Object.entries(res.data).map(([cat, items]) => `
      <div class="mb-3">
        <h6 class="text-primary">${cat}</h6>
        ${Object.entries(items).map(([k, v]) => `<div class="ps-3 mb-1"><strong>${k}:</strong> <code>${typeof v === 'object' ? JSON.stringify(v).substring(0, 200) : String(v).substring(0, 200)}</code></div>`).join('')}
      </div>
    `).join('');
  } catch(e) { console.error('loadStaticKnowledge:', e); }
}

document.querySelector('[href="#tab-knowledge"]')?.addEventListener('shown.bs.tab', () => { loadExperiences(); });
document.querySelector('a[href="#kb-static"]')?.addEventListener('shown.bs.tab', loadStaticKnowledge);

// ========== TOTP 双因素认证 ==========
async function loadTotpStatus() {
  try {
    const res = await fetch('/api/settings/totp');
    const data = await res.json();
    document.getElementById('totp-status').style.display = 'none';
    if (data.enabled) {
      document.getElementById('totp-enabled').style.display = 'block';
      document.getElementById('totp-setup').style.display = 'none';
    } else {
      document.getElementById('totp-setup').style.display = 'block';
      document.getElementById('totp-enabled').style.display = 'none';
    }
  } catch(e) {
    document.getElementById('totp-status').innerHTML = '<p class="text-danger">加载TOTP状态失败</p>';
  }
}

async function setupTotp() {
  try {
    const res = await fetch('/api/settings/totp/setup', { method: 'POST', headers: {'Content-Type':'application/json'} });
    const data = await res.json();
    if (data.success) {
      document.getElementById('totp-qr-img').src = data.qrCodeUrl;
      document.getElementById('totp-secret-text').value = data.secret;
      document.getElementById('totp-setup').style.display = 'none';
      document.getElementById('totp-qrcode').style.display = 'block';
    }
  } catch(e) {
    alert('生成TOTP密钥失败');
  }
}

async function enableTotp() {
  const token = document.getElementById('totp-verify-code').value;
  if (!token || token.length !== 6) { alert('请输入6位验证码'); return; }
  try {
    const res = await fetch('/api/settings/totp/enable', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ token })
    });
    const data = await res.json();
    if (data.success) {
      alert('✅ 双因素认证已启用！');
      document.getElementById('totp-qrcode').style.display = 'none';
      loadTotpStatus();
    } else {
      alert(data.error || '启用失败');
    }
  } catch(e) {
    alert('启用失败');
  }
}

function cancelTotp() {
  document.getElementById('totp-qrcode').style.display = 'none';
  document.getElementById('totp-setup').style.display = 'block';
}

function showDisableTotp() {
  document.getElementById('totp-enabled').style.display = 'none';
  document.getElementById('totp-disable').style.display = 'block';
}

function cancelDisableTotp() {
  document.getElementById('totp-disable').style.display = 'none';
  document.getElementById('totp-enabled').style.display = 'block';
}

async function disableTotp() {
  const password = document.getElementById('totp-disable-password').value;
  const token = document.getElementById('totp-disable-code').value;
  if (!password) { alert('请输入密码'); return; }
  if (!token || token.length !== 6) { alert('请输入6位验证码'); return; }
  try {
    const res = await fetch('/api/settings/totp/disable', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ token, password })
    });
    const data = await res.json();
    if (data.success) {
      alert('双因素认证已禁用');
      document.getElementById('totp-disable').style.display = 'none';
      loadTotpStatus();
    } else {
      alert(data.error || '禁用失败');
    }
  } catch(e) {
    alert('禁用失败');
  }
}

// 页面加载时获取TOTP状态
document.addEventListener('DOMContentLoaded', () => {
  loadTotpStatus();
});
</script>
