function autoDetectEmailProvider(email) {
  clearTimeout(_emailDetectTimer);
  _emailDetectTimer = setTimeout(async () => {
    const hint = document.getElementById('email-preset-hint');
    if (!email || !email.includes('@')) { hint.style.display = 'none'; return; }
    try {
      const res = await api('/api/email-presets?email=' + encodeURIComponent(email), 'GET');
      if (!res.success || !res.data) return;
      const d = res.data;
      const form = document.getElementById('email-account-form');
      if (d.matched) {
        form.smtp_host.value = d.smtp_host;
        form.smtp_port.value = d.smtp_port;
        if (d.imap_host) form.imap_host.value = d.imap_host;
        if (d.imap_port) form.imap_port.value = d.imap_port;
        if (!form.smtp_user.value) form.smtp_user.value = email;
        hint.innerHTML = '<div class="alert alert-success small mb-0 py-1">✅ 已识别 <b>' + d.domain + '</b>，配置已自动填充' + (d.note ? '<br>💡 ' + d.note : '') + (d.steps ? '<br>📋 <b>操作步骤：</b>' + d.steps : '') + (d.guide_url ? '<br><a href="' + d.guide_url + '" target="_blank">🔗 前往设置页面</a>' : '') + '</div>';
        hint.style.display = 'block';
      } else {
        hint.innerHTML = '<div class="alert alert-warning small mb-0 py-1">⚠️ 未识别 <b>' + d.domain + '</b>，请手动填写SMTP/IMAP配置</div>';
        hint.style.display = 'block';
      }
    } catch(e) { console.error('preset detect error', e); }
  }, 500);
}

