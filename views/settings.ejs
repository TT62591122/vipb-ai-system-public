function abUpdateStage(platform, index, field, value) {
  if (field === 'only_reply') {
    abRulesCache[platform].warmup.stages[index][field] = value;
  } else {
    abRulesCache[platform].warmup.stages[index][field] = parseInt(value);
  }
}

function abUpdateField(platform, section, field, value) {
  if (typeof value === 'string' && !isNaN(value) && !Array.isArray(abRulesCache[platform][section][field])) {
    value = parseFloat(value);
  }
  abRulesCache[platform][section][field] = value;
}

async function abSave() {
  abRulesCache.version = new Date().toISOString().split('T')[0].replace(/-/g,'.');
  const res = await api('/api/antiban/rules', 'PUT', abRulesCache);
  if (res.success) { toast('防封规则已保存'); document.getElementById('ab-version').textContent = 'v' + abRulesCache.version; }
  else toast('保存失败: ' + (res.error||''), 'danger');
}

async function abReset() {
  if (!confirm('确定恢复默认规则？所有修改将丢失！')) return;
  const res = await api('/api/antiban/rules/reset', 'POST');
  if (res.success) { toast('已恢复默认规则'); abLoadRules(); }
}

async function abLoadAccounts() {
  try {
    const accounts = await api('/api/antiban/accounts');
    const tbody = document.getElementById('ab-accounts-table');
    if (!accounts.length) { tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-3">暂无注册账号</td></tr>'; return; }
    tbody.innerHTML = accounts.map(a => {
      const statsStr = Object.entries(a.todayStats || {}).map(([k,v]) => `${k}:${v}`).join(' ') || '-';
      const statusBadge = a.paused ? `<span class="badge bg-danger">暂停</span>` : `<span class="badge bg-success">正常</span>`;
      return `<tr>
        <td>${a.platform}</td><td>${a.accountId}</td><td>${a.age}天</td>
        <td><span class="badge bg-info">${a.stage}</span></td><td class="small">${statsStr}</td>
        <td>${statusBadge}</td>
        <td>${a.paused ? 
          `<button class="btn btn-xs btn-success" onclick="abUnpause('${a.platform}','${a.accountId}')">恢复</button>` :
          `<button class="btn btn-xs btn-warning" onclick="abPause('${a.platform}','${a.accountId}')">暂停</button>`
        }</td>
      </tr>`;
    }).join('');
  } catch(e) {}
}

async function abRegisterAccount() {
  const platform = document.getElementById('ab-new-platform').value;
  const accountId = document.getElementById('ab-new-id').value.trim();
  const createdDate = document.getElementById('ab-new-date').value || undefined;
  if (!accountId) return toast('请输入账号标识', 'danger');
  await api('/api/antiban/accounts', 'POST', { platform, accountId, createdDate });
  toast(`${platform} 账号已注册，开始养号计时`);
  document.getElementById('ab-new-id').value = '';
  abLoadAccounts();
}

async function abPause(platform, accountId) {
  const hours = prompt('暂停多少小时？', '24');
  if (!hours) return;
  await api(`/api/antiban/accounts/${platform}/${accountId}/pause`, 'POST', { hours: parseInt(hours) });
  toast('账号已暂停');
  abLoadAccounts();
}

async function abUnpause(platform, accountId) {
  await api(`/api/antiban/accounts/${platform}/${accountId}/unpause`, 'POST');
  toast('账号已恢复');
  abLoadAccounts();
}

// ========== AI Providers 4角色分组管理 ==========
const AI_ROLES = {
  brain: { label: '🧠 主脑 AI', desc: '理解指令·调度专家' },
  video: { label: '🎬 视频引擎', desc: '视频生成·数字人·混剪' },
  vision: { label: '👁️ 视觉引擎', desc: '看图分析·产品图识别' },
  text: { label: '✍️ 文本引擎', desc: '邮件·翻译·文案·SEO' }
};
let aiProvidersByRole = { brain: [], video: [], vision: [], text: [] };

document.addEventListener('DOMContentLoaded', loadAIProviders);

async function loadAIProviders() {
  try {
    const res = await api('/api/settings/ai-providers');
    const data = res.providers;
    if (data && !Array.isArray(data) && data.brain !== undefined) {
      aiProvidersByRole = { brain: data.brain || [], video: data.video || [], vision: data.vision || [], text: data.text || [] };
    } else if (Array.isArray(data)) {
      aiProvidersByRole = { brain: [], video: [], vision: [], text: data };
    }
  } catch(e) {
    try {
      const old = '<%- settings.ai_provider ? JSON.stringify(settings.ai_provider).replace(/\x27/g, "\\\x27") : "" %>';
      if (old) {
        const parsed = JSON.parse(old);
        if (parsed.baseUrl) aiProvidersByRole.text = [{ ...parsed, name: '默认', enabled: true }];
      }
    } catch(e2) {}
  }
  renderAllRoles();
}

function renderAllRoles() {
  Object.keys(AI_ROLES).forEach(role => renderRoleProviders(role));
}

function renderRoleProviders(role) {
  const container = document.getElementById('role-' + role + '-providers');
  if (!container) return;
  const list = aiProvidersByRole[role] || [];
  if (list.length === 0) {
    container.innerHTML = '<div class="text-muted small text-center py-2">暂未配置，点击右上角"添加"</div>';
    return;
  }
  container.innerHTML = list.map((p, i) => `
    <div class="card mb-2 ${p.enabled === false ? 'opacity-50' : ''}">
      <div class="card-body p-2">
        <div class="d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center gap-2">
            <span class="badge bg-${p.enabled === false ? 'secondary' : 'success'}">#${i+1}</span>
            <strong class="small">${p.name || '未命名'}</strong>
            <span class="badge bg-info small">${p.model || '未设置'}</span>
            <span id="pstatus-${role}-${i}"></span>
          </div>
          <div class="d-flex gap-1">
            ${i > 0 ? `<button class="btn btn-sm btn-outline-secondary py-0 px-1" onclick="moveRoleProvider('${role}',${i},-1)">⬆</button>` : ''}
            ${i < list.length-1 ? `<button class="btn btn-sm btn-outline-secondary py-0 px-1" onclick="moveRoleProvider('${role}',${i},1)">⬇</button>` : ''}
            <button class="btn btn-sm btn-outline-${p.enabled===false?'success':'warning'} py-0 px-1" onclick="toggleRoleProvider('${role}',${i})">${p.enabled===false?'启用':'禁用'}</button>
            <button class="btn btn-sm btn-outline-primary py-0 px-1" onclick="editRoleProvider('${role}',${i})">✏️</button>
            <button class="btn btn-sm btn-outline-danger py-0 px-1" onclick="removeRoleProvider('${role}',${i})">🗑️</button>
          </div>
        </div>
        <div class="row g-2 mt-1" id="pfields-${role}-${i}" style="display:none">
          <div class="col-md-3"><input class="form-control form-control-sm" placeholder="名称" value="${p.name||''}" oninput="aiProvidersByRole['${role}'][${i}].name=this.value" onchange="aiProvidersByRole['${role}'][${i}].name=this.value"></div>
          <div class="col-md-4"><input class="form-control form-control-sm" placeholder="API Base URL" value="${p.baseUrl||''}" oninput="aiProvidersByRole['${role}'][${i}].baseUrl=this.value" onchange="aiProvidersByRole['${role}'][${i}].baseUrl=this.value"></div>
          <div class="col-md-3"><input class="form-control form-control-sm" type="password" placeholder="API Key" value="${p.apiKey||''}" oninput="aiProvidersByRole['${role}'][${i}].apiKey=this.value" onchange="aiProvidersByRole['${role}'][${i}].apiKey=this.value"></div>
          <div class="col-md-2"><input class="form-control form-control-sm" placeholder="模型" value="${p.model||''}" oninput="aiProvidersByRole['${role}'][${i}].model=this.value" onchange="aiProvidersByRole['${role}'][${i}].model=this.value"></div>
        </div>
        <small class="text-muted">${p.baseUrl ? p.baseUrl.replace(/\/+$/, '').substring(0, 40) + '...' : '未配置URL'}</small>
      </div>
    </div>
  `).join('');
}

function addProviderToRole(role) {
  aiProvidersByRole[role].push({ name: 'Provider ' + (aiProvidersByRole[role].length + 1), baseUrl: '', apiKey: '', model: '', enabled: true });
  renderRoleProviders(role);
  editRoleProvider(role, aiProvidersByRole[role].length - 1);
}

function editRoleProvider(role, i) {
  const el = document.getElementById('pfields-' + role + '-' + i);
  if (el) el.style.display = el.style.display === 'none' ? '' : 'none';
}

function removeRoleProvider(role, i) {
  if (!confirm('确定删除？')) return;
  aiProvidersByRole[role].splice(i, 1);
  renderRoleProviders(role);
}

function toggleRoleProvider(role, i) {
  aiProvidersByRole[role][i].enabled = aiProvidersByRole[role][i].enabled === false ? true : false;
  renderRoleProviders(role);
}

function moveRoleProvider(role, i, dir) {
  const list = aiProvidersByRole[role];
  const j = i + dir;
  if (j < 0 || j >= list.length) return;
  [list[i], list[j]] = [list[j], list[i]];
  renderRoleProviders(role);
}

async function saveAIProviders() {
  // 保存前强制同步所有展开的输入框值到aiProvidersByRole
  _syncAllRoleInputs();
  const res = await api('/api/settings/ai-providers', 'PUT', { providers: aiProvidersByRole });

  if (res.success) {
    const allEnabled = Object.values(aiProvidersByRole).flat().filter(p => p.enabled !== false && p.baseUrl && p.apiKey);
    Object.keys(AI_ROLES).forEach(role => renderRoleProviders(role));
    toast('AI Provider 已保存（' + allEnabled.length + '个启用）');
  } else {
    toast(res.error || '保存失败', 'danger');
  }
}

/** 单角色保存 */
async function saveRoleProviders(role) {
  _syncRoleInputs(role);
  // 保存时发送完整的providers对象（后端需要完整数据）
  const res = await api('/api/settings/ai-providers', 'PUT', { providers: aiProvidersByRole });
  const statusEl = document.getElementById('role-' + role + '-status');
  if (res.success) {
    const enabled = (aiProvidersByRole[role] || []).filter(p => p.enabled !== false && p.baseUrl && p.apiKey);
    renderRoleProviders(role);
    const statusEl2 = document.getElementById('role-' + role + '-status');
    if (statusEl2) statusEl2.innerHTML = '<span class="text-success">✅ 已保存（' + enabled.length + '个启用）</span>';
    setTimeout(() => { if (statusEl2) statusEl2.innerHTML = ''; }, 3000);
  } else {
    if (statusEl) statusEl.innerHTML = '<span class="text-danger">❌ ' + (res.error || '保存失败') + '</span>';
  }
}

/** 单角色测试 */
async function testRoleProviders(role) {
  _syncRoleInputs(role);
  const list = aiProvidersByRole[role] || [];
  const statusEl = document.getElementById('role-' + role + '-status');
  if (statusEl) statusEl.innerHTML = '<span class="text-info">⏳ 测试中...</span>';
  let passed = 0, total = 0;
  for (let i = 0; i < list.length; i++) {
    const p = list[i];
    if (p.enabled === false || !p.baseUrl || !p.apiKey) {
      const el = document.getElementById('pstatus-' + role + '-' + i);
      if (el) el.innerHTML = '<span class="badge bg-secondary">跳过</span>';
      continue;
    }
    total++;
    const el = document.getElementById('pstatus-' + role + '-' + i);
    if (el) el.innerHTML = '<span class="badge bg-info">测试中...</span>';
    try {
      const res = await api('/api/settings/test-ai-provider', 'POST', { baseUrl: p.baseUrl, apiKey: p.apiKey, model: p.model, role: role });
      if (res.success) {
        if (el) el.innerHTML = '<span class="badge bg-success">✅ ' + (res.latency || '') + '</span>';
        passed++;
      } else {
        if (el) el.innerHTML = '<span class="badge bg-danger">❌ ' + (res.error || '').substring(0,30) + '</span>';
      }
    } catch(e) {
      if (el) el.innerHTML = '<span class="badge bg-danger">❌ 网络错误</span>';
    }
  }
  if (statusEl) statusEl.innerHTML = '<span class="text-' + (passed > 0 ? 'success' : 'danger') + '">' + passed + '/' + total + ' 通过</span>';
}

/** 同步单个角色的输入框值 */
function _syncRoleInputs(role) {
  const list = aiProvidersByRole[role] || [];
  for (let i = 0; i < list.length; i++) {
    const fields = document.getElementById('pfields-' + role + '-' + i);
    if (fields) {
      const inputs = fields.querySelectorAll('input');
      if (inputs[0]) list[i].name = inputs[0].value;
      if (inputs[1]) list[i].baseUrl = inputs[1].value;
      if (inputs[2]) list[i].apiKey = inputs[2].value;
      if (inputs[3]) list[i].model = inputs[3].value;
    }
  }
}

/** 同步所有角色的输入框值 */
function _syncAllRoleInputs() {
  for (const role of Object.keys(AI_ROLES)) {
    _syncRoleInputs(role);
  }
}

async function testAllProviders() {
  _syncAllRoleInputs();
  const statusEl = document.getElementById('ai-test-status');
  statusEl.innerHTML = '<span class="text-info">⏳ 测试中...</span>';
  let passed = 0, total = 0;
  for (const role of Object.keys(AI_ROLES)) {
    const list = aiProvidersByRole[role] || [];
    for (let i = 0; i < list.length; i++) {
      const p = list[i];
      if (p.enabled === false || !p.baseUrl || !p.apiKey) {
        const el = document.getElementById('pstatus-' + role + '-' + i);
        if (el) el.innerHTML = '<span class="badge bg-secondary">跳过</span>';
        continue;
      }
      total++;
      const el = document.getElementById('pstatus-' + role + '-' + i);
      if (el) el.innerHTML = '<span class="badge bg-info">测试中...</span>';
      try {
        const res = await api('/api/settings/test-ai-provider', 'POST', { baseUrl: p.baseUrl, apiKey: p.apiKey, model: p.model, role: role });
        if (res.success) {
          if (el) el.innerHTML = '<span class="badge bg-success">✅ ' + (res.latency || '') + '</span>';
          passed++;
        } else {
          if (el) el.innerHTML = '<span class="badge bg-danger">❌ ' + (res.error || '').substring(0,20) + '</span>';
        }
      } catch(e) {
        if (el) el.innerHTML = '<span class="badge bg-danger">❌ 网络错误</span>';
      }
    }
  }
  statusEl.innerHTML = `<span class="text-${passed > 0 ? 'success' : 'danger'}">${passed}/${total} 通过</span>`;
}

// ========== 出站代理管理 ==========
async function loadProxy() {
  try {
    const res = await fetch('/api/settings/outbound-proxy');
    const data = await res.json();
    if (data.success && data.proxy) {
      document.getElementById('proxy-enabled').checked = data.proxy.enabled;
      document.getElementById('proxy-url').value = data.proxy.url || '';
    }
  } catch(e) {}
}

async function saveProxy() {
  const enabled = document.getElementById('proxy-enabled').checked;
  const url = document.getElementById('proxy-url').value.trim();
  try {
    const res = await fetch('/api/settings/outbound-proxy', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ enabled, url })
    });
    const data = await res.json();
    if (data.success) {
      document.getElementById('proxy-status').innerHTML = '<span class="text-success">✅ 已保存</span>';
      setTimeout(function(){ document.getElementById('proxy-status').innerHTML = ''; }, 2000);
    }
  } catch(e) { alert('保存失败: ' + e.message); }
}

async function testProxy() {
  document.getElementById('proxy-status').innerHTML = '<span class="text-primary">⏳ 测试中...</span>';
  try {
    const res = await fetch('/api/seo/keywords', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ keyword: 'test' })
    });
    const data = await res.json();
    if (data.totalSuggestions > 0) {
      document.getElementById('proxy-status').innerHTML = '<span class="text-success">✅ 代理正常，获取到 ' + data.totalSuggestions + ' 个关键词</span>';
    } else {
      document.getElementById('proxy-status').innerHTML = '<span class="text-warning">⚠️ 代理可能不通，未获取到数据</span>';
    }
  } catch(e) {
    document.getElementById('proxy-status').innerHTML = '<span class="text-danger">❌ 测试失败: ' + e.message + '</span>';
  }
}

async function detectProxy() {
  document.getElementById('proxy-status').innerHTML = '<span class="text-primary">⏳ 正在扫描本地代理端口...</span>';
  try {
    const res = await fetch('/api/settings/detect-proxy');
    const data = await res.json();
    if (data.success && data.proxy) {
      document.getElementById('proxy-url').value = data.proxy;
      document.getElementById('proxy-enabled').checked = true;
      document.getElementById('proxy-status').innerHTML = '<span class="text-success">✅ 检测到代理: ' + data.proxy + '，请点保存</span>';
    } else {
      document.getElementById('proxy-status').innerHTML = '<span class="text-warning">⚠️ 未检测到可用代理，请手动填写</span>';
    }
  } catch(e) {
    document.getElementById('proxy-status').innerHTML = '<span class="text-danger">❌ 检测失败: ' + e.message + '</span>';
  }
}

// ========== 模块管理 ==========
async function loadModuleSwitches() {
  try {
    const res = await fetch('/api/settings/modules');
    if (!res.ok) return;
    const data = await res.json();
    if (data.success && data.modules) {
      document.querySelectorAll('.module-switch').forEach(function(el) {
        var mod = el.getAttribute('data-module');
        if (data.modules[mod] !== undefined) {
          el.checked = data.modules[mod];
        }
      });
    }
  } catch(e) {
    console.error('加载模块状态失败:', e);
  }
}

async function saveModuleSwitches() {
  var modules = {};
  document.querySelectorAll('.module-switch').forEach(function(el) {
    modules[el.getAttribute('data-module')] = el.checked;
  });
  try {
    var res = await fetch('/api/settings/modules', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ modules: modules })
    });
    if (!res.ok) {
      alert('保存失败: HTTP ' + res.status);
      return;
    }
    var data = await res.json();
    if (data.success) {
      var btn = document.querySelector('[onclick="saveModuleSwitches()"]');
      var origText = btn.innerHTML;
      btn.innerHTML = '✅ 已保存';
      btn.classList.remove('btn-success');
      btn.classList.add('btn-outline-success');
      setTimeout(function() {
        btn.innerHTML = origText;
        btn.classList.remove('btn-outline-success');
        btn.classList.add('btn-success');
      }, 2000);
    } else {
      alert('保存失败: ' + (data.error || '未知错误'));
    }
  } catch(e) {
    alert('保存失败: ' + e.message);
  }
}

