// ========== Agent控制面板 ==========
async function loadAgentStatus() {
  try {
    const res = await api('/api/agent/status');
    if (!res.success) return;
    document.getElementById('agent-enabled-switch').checked = res.enabled;
    document.getElementById('agent-status-badge').textContent = res.enabled ? '运行中' : '已关闭';
    document.getElementById('agent-status-badge').className = 'badge ' + (res.enabled ? 'bg-success' : 'bg-secondary');
    document.getElementById('agent-scan-interval').value = res.scanInterval || 2;
    document.getElementById('kb-exp-count').textContent = res.experienceCount || 0;
    // 成本
    if (res.cost) {
      document.getElementById('agent-limit-per-scan').value = res.cost.limits.per_scan;
      document.getElementById('agent-limit-daily').value = res.cost.limits.daily;
      document.getElementById('agent-limit-monthly').value = res.cost.limits.monthly;
      document.getElementById('agent-cost-daily-display').textContent = `$${res.cost.today.spent.toFixed(2)} / $${res.cost.today.limit.toFixed(2)}`;
      document.getElementById('agent-cost-monthly-display').textContent = `$${res.cost.month.spent.toFixed(2)} / $${res.cost.month.limit.toFixed(2)}`;
      document.getElementById('agent-cost-daily-bar').style.width = res.cost.today.percent + '%';
      document.getElementById('agent-cost-monthly-bar').style.width = res.cost.month.percent + '%';
    }
  } catch(e) { console.error('loadAgentStatus:', e); }
}

