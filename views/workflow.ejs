<%- include('partials/header') %>
<div class="main-content">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div><h4 class="mb-0">⚡ AI工作流编排</h4><small class="text-muted">自动化流程 · 多步骤编排 · 智能执行</small></div>
    <button class="btn btn-purple" onclick="showWorkflowModal()">➕ 新建工作流</button>
  </div>

  <!-- 统计卡片 -->
  <div class="row g-3 mb-4">
    <div class="col-md-3"><div class="stat-card text-center"><div class="stat-number" id="statTotal">0</div><div class="stat-label">总工作流</div></div></div>
    <div class="col-md-3"><div class="stat-card text-center"><div class="stat-number" id="statActive">0</div><div class="stat-label">已激活</div></div></div>
    <div class="col-md-3"><div class="stat-card text-center"><div class="stat-number" id="statRunning">0</div><div class="stat-label">运行中</div></div></div>
    <div class="col-md-3"><div class="stat-card text-center"><div class="stat-number" id="statCompleted">0</div><div class="stat-label">已完成</div></div></div>
  </div>

  <!-- 工作流列表 -->
  <div class="card">
    <div class="card-body p-0">
      <table class="table table-hover mb-0">
        <thead>
          <tr><th>#</th><th>名称</th><th>步骤数</th><th>状态</th><th>上次运行</th><th>创建时间</th><th>操作</th></tr>
        </thead>
        <tbody id="workflowList">
          <tr id="emptyRow"><td colspan="7" class="text-center text-muted py-4">加载中...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- 新建/编辑模态框 -->
<div class="modal fade" id="workflowModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header"><h5 id="modalTitle">➕ 新建工作流</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <input type="hidden" id="editId">
        <div class="mb-3"><label class="form-label">工作流名称</label><input class="form-control" id="wfName" placeholder="如：新客户欢迎流程"></div>
        <div class="mb-3"><label class="form-label">描述</label><textarea class="form-control" id="wfDesc" rows="2" placeholder="简要描述此工作流的用途"></textarea></div>
        <div class="mb-3">
          <label class="form-label">触发条件</label>
          <select class="form-select" id="wfTrigger">
            <option value="manual">手动触发</option>
            <option value="schedule">定时触发</option>
            <option value="event">事件触发</option>
            <option value="webhook">Webhook</option>
          </select>
        </div>
        <div class="mb-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <label class="form-label mb-0">步骤配置</label>
            <button class="btn btn-sm btn-outline-primary" onclick="addStep()"><i class="bi bi-plus"></i> 添加步骤</button>
          </div>
          <div id="stepsContainer">
            <div class="alert alert-light text-center text-muted">点击"添加步骤"开始配置工作流</div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
        <button class="btn btn-purple" onclick="saveWorkflow()">保存</button>
      </div>
    </div>
  </div>
</div>

<script>
let stepCount = 0;

function addStep() {
  stepCount++;
  const container = document.getElementById('stepsContainer');
  if (stepCount === 1) container.innerHTML = '';
  const div = document.createElement('div');
  div.className = 'card mb-2';
  div.id = `step-${stepCount}`;
  div.innerHTML = `<div class="card-body p-2">
    <div class="d-flex align-items-center gap-2">
      <span class="badge bg-purple">${stepCount}</span>
      <select class="form-select form-select-sm" style="width:150px">
        <option value="ai_chat">AI对话</option><option value="send_email">发邮件</option>
        <option value="send_whatsapp">发WhatsApp</option><option value="delay">延迟等待</option>
        <option value="condition">条件判断</option><option value="webhook">Webhook</option>
      </select>
      <input class="form-control form-control-sm" placeholder="步骤名称">
      <button class="btn btn-sm btn-outline-danger" onclick="this.closest('.card').remove()"><i class="bi bi-trash"></i></button>
    </div>
  </div>`;
  container.appendChild(div);
}

function showWorkflowModal(wf) {
  document.getElementById('editId').value = wf ? wf.id : '';
  document.getElementById('modalTitle').textContent = wf ? '✏️ 编辑工作流' : '➕ 新建工作流';
  document.getElementById('wfName').value = wf ? wf.name : '';
  document.getElementById('wfDesc').value = wf ? (wf.description || '') : '';
  document.getElementById('wfTrigger').value = wf ? (wf.trigger || 'manual') : 'manual';
  stepCount = 0;
  document.getElementById('stepsContainer').innerHTML = '<div class="alert alert-light text-center text-muted">点击"添加步骤"开始配置工作流</div>';
  if (wf && wf.steps) {
    (typeof wf.steps === 'string' ? JSON.parse(wf.steps) : wf.steps).forEach(() => addStep());
  }
  new bootstrap.Modal(document.getElementById('workflowModal')).show();
}

async function saveWorkflow() {
  const id = document.getElementById('editId').value;
  const steps = [];
  document.querySelectorAll('#stepsContainer .card').forEach(card => {
    steps.push({ type: card.querySelector('select').value, name: card.querySelector('input').value });
  });
  const data = { name: document.getElementById('wfName').value, description: document.getElementById('wfDesc').value, trigger: document.getElementById('wfTrigger').value, steps };
  const url = id ? `/api/workflows/${id}` : '/api/workflows';
  const res = await fetch(url, { method: id ? 'PUT' : 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) });
  const result = await res.json();
  if (result.success) location.reload(); else alert('保存失败: ' + (result.error || '未知错误'));
}

async function runWorkflow(id) {
  if (!confirm('确定要运行此工作流？')) return;
  const res = await fetch(`/api/workflows/${id}/run`, { method: 'POST' });
  const result = await res.json();
  alert(result.success ? '工作流已启动！' : '运行失败: ' + result.error);
  loadWorkflows();
}

async function deleteWorkflow(id) {
  if (!confirm('确定删除此工作流？')) return;
  await fetch(`/api/workflows/${id}`, { method: 'DELETE' });
  loadWorkflows();
}

async function loadWorkflows() {
  try {
    const res = await fetch('/api/workflows');
    const data = await res.json();
    const list = data.workflows || data.data || data || [];
    const tbody = document.getElementById('workflowList');
    if (!Array.isArray(list) || list.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">暂无工作流，点击右上角"新建工作流"开始</td></tr>';
      return;
    }
    let active = 0, running = 0, completed = 0;
    tbody.innerHTML = list.map(w => {
      const steps = w.steps ? (typeof w.steps === 'string' ? JSON.parse(w.steps) : w.steps) : [];
      if (w.status === 'active') active++;
      if (w.status === 'running') running++;
      if (w.status === 'completed') completed++;
      const statusMap = { active:'<span class="badge bg-success">激活</span>', draft:'<span class="badge bg-secondary">草稿</span>', running:'<span class="badge bg-primary">运行中</span>', completed:'<span class="badge bg-info">完成</span>', error:'<span class="badge bg-danger">错误</span>' };
      return `<tr>
        <td>${w.id}</td><td>${w.name}</td><td>${steps.length} 步</td>
        <td>${statusMap[w.status] || '<span class="badge bg-light text-dark">'+w.status+'</span>'}</td>
        <td><small>${w.last_run ? new Date(w.last_run).toLocaleString('zh-CN') : '-'}</small></td>
        <td><small>${new Date(w.created_at).toLocaleString('zh-CN')}</small></td>
        <td>
          <button class="btn btn-sm btn-primary" onclick="runWorkflow(${w.id})" title="运行">▶</button>
          <button class="btn btn-sm btn-outline-secondary" onclick='showWorkflowModal(${JSON.stringify(w)})' title="编辑">✏️</button>
          <button class="btn btn-sm btn-outline-danger" onclick="deleteWorkflow(${w.id})" title="删除">🗑</button>
        </td></tr>`;
    }).join('');
    document.getElementById('statTotal').textContent = list.length;
    document.getElementById('statActive').textContent = active;
    document.getElementById('statRunning').textContent = running;
    document.getElementById('statCompleted').textContent = completed;
  } catch(e) {
    document.getElementById('workflowList').innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">暂无工作流，点击右上角"新建工作流"开始</td></tr>';
  }
}
loadWorkflows();
</script>
<%- include('partials/footer') %>
